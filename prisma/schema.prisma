// Novyra Campus OS — Prisma schema
// Backend Phase 1: core organizational foundation only.
// Hierarchy: Tenant → School → Branch, with School-scoped AcademicSession.
// No business models (students, fees, attendance, …), no auth here.
//
// Prisma 7 notes:
// - The `prisma-client` generator requires an explicit `output`.
// - The datasource holds only `provider`; connection URLs live in
//   `prisma.config.ts` (see project root).
// - Runtime connections use a driver adapter (`@prisma/adapter-pg`); see
//   `lib/db/prisma.ts`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are configured in prisma.config.ts (Prisma 7 convention).
}

// ---------------------------------------------------------------------------
// Status enums — only what the core organizational models need.
// Values mirror the existing UI status vocabularies where they overlap.
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolStatus {
  // SETUP_PENDING: freshly provisioned by a platform admin, onboarding not done.
  // SUSPENDED: platform-suspended (data preserved). See Super Admin Phase SA-2.
  SETUP_PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

/// Mirrors the UI `BranchStatus` (active | setup-pending | inactive | archived).
enum BranchStatus {
  ACTIVE
  SETUP_PENDING
  INACTIVE
  ARCHIVED
}

/// Mirrors the UI `SessionStatus` (draft | upcoming | active | closed | archived).
enum AcademicSessionStatus {
  DRAFT
  UPCOMING
  ACTIVE
  CLOSED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Tenant — the top-level customer/organization boundary (one paying customer).
// ---------------------------------------------------------------------------

model Tenant {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  status   TenantStatus @default(ACTIVE)
  // IANA timezone (e.g. "Asia/Kolkata"), BCP-47 locale, ISO-4217 currency.
  timezone String       @default("Asia/Kolkata")
  locale   String       @default("en-IN")
  currency String       @default("INR")

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  schools        School[]
  memberships    TenantMembership[]
  roles          Role[] // tenant-scoped custom roles (system roles have null tenantId)
  subscriptions  Subscription[] // Super Admin Phase SA-4B
  invoices       Invoice[] // Super Admin Phase SA-4D
  payments       Payment[] // Super Admin Phase SA-4E
  supportTickets SupportTicket[] // Super Admin Phase SA-4I

  @@index([status])
  @@map("tenants")
}

// ---------------------------------------------------------------------------
// School — an institution belonging to a Tenant. Holds core identity/profile
// fields only; extended settings/branding stay out of this table.
// ---------------------------------------------------------------------------

model School {
  id                 String       @id @default(cuid())
  tenantId           String
  name               String
  shortName          String?
  code               String
  schoolType         String?
  board              String?
  establishmentYear  Int?
  registrationNumber String?
  affiliationNumber  String?
  email              String?
  phone              String?
  website            String?
  // IANA timezone / BCP-47 locale / ISO-4217 currency. Default to the tenant's
  // values at creation time in the service layer; stored here so a school can
  // diverge from its tenant.
  timezone           String       @default("Asia/Kolkata")
  locale             String       @default("en-IN")
  currency           String       @default("INR")
  status             SchoolStatus @default(ACTIVE)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches            Branch[]
  academicSessions    AcademicSession[]
  onboarding          SchoolOnboarding? // Super Admin Phase SA-3
  subscriptions       Subscription[] // Super Admin Phase SA-4B
  invoices            Invoice[] // Super Admin Phase SA-4D
  payments            Payment[] // Super Admin Phase SA-4E
  supportTickets      SupportTicket[] // Super Admin Phase SA-4I
  featureOverrides    SchoolFeatureOverride[] // Super Admin Phase SA-4L
  domains             SchoolDomain[] // Super Admin Phase SA-4L
  branding            SchoolBranding? // Super Admin Phase SA-4L
  addOns              SchoolAddOn[] // Super Admin Phase SA-4M
  marketplaceInstalls SchoolMarketplaceInstallation[] // Super Admin Phase SA-4M

  // School code is unique within its tenant.
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("schools")
}

// ---------------------------------------------------------------------------
// Branch — a physical campus/location of a School.
// ---------------------------------------------------------------------------

model Branch {
  id           String       @id @default(cuid())
  schoolId     String
  name         String
  code         String
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  // Optional IANA timezone override; falls back to the school timezone when null.
  timezone     String?
  isPrimary    Boolean      @default(false)
  status       BranchStatus @default(SETUP_PENDING)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Branch code is unique within its school.
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// AcademicSession — an academic year/term. SCHOOL-SCOPED (see decision note in
// the phase report): sessions are defined once per school and shared by all of
// that school's branches, matching the UI where sessions live in the school's
// admin settings and each branch references the current one.
//
// Invariant (enforced in the service layer, per phase spec): at most one
// session per school may have `isCurrent = true` and it must have status
// ACTIVE. `startDate` must precede `endDate`.
// ---------------------------------------------------------------------------

model AcademicSession {
  id        String                @id @default(cuid())
  schoolId  String
  name      String
  code      String
  startDate DateTime              @db.Date
  endDate   DateTime              @db.Date
  status    AcademicSessionStatus @default(DRAFT)
  isCurrent Boolean               @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Session code is unique within its school.
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

// ===========================================================================
// Backend Phase 2 — Authentication & Identity Foundation (Batch 1).
//
// Schema only: identity, tenant membership, roles, platform-admin boundary, and
// a minimal Session model for the chosen CUSTOM database-session auth. No login,
// session-creation, RBAC evaluation, or protected-route logic here.
// ===========================================================================

/// Account lifecycle states needed for the auth foundation only.
enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  INACTIVE
}

/// Lifecycle of a user's membership in a tenant.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// Explicit platform-operator roles — deliberately separate from tenant roles.
/// A tenant/school role NEVER grants platform access; only a PlatformAdmin row does.
enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
  AUDITOR
}

// ---------------------------------------------------------------------------
// User — ONE central identity. Domain profiles (Teacher/Student/Parent/…) will
// link TO this User in later phases; there are no separate auth tables per role.
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  name            String?
  email           String     @unique // stored lowercased by the service layer (single global identity)
  // Argon2id hash only — never plaintext. Nullable: invited users set it later.
  passwordHash    String?
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  image           String?

  // First-login foundation (persisted state only; no setup flow implemented yet).
  passwordSetupRequired Boolean   @default(false)
  onboardingCompletedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships            TenantMembership[]
  sessions               Session[]
  platformAdmin          PlatformAdmin?
  activeContext          UserActiveContext?
  staffProfile           Staff? // Phase 6A — optional link to a school Staff/employee record
  notificationRecipients NotificationRecipient[] // Phase 9D.2 — in-app notifications

  @@index([status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// UserActiveContext — the user's currently-selected workspace context (Batch 4).
// One row per user. The selected IDs are stored as plain columns and are ALWAYS
// re-validated against the user's real access in the context service before use,
// so a stale/deleted id simply resolves to "unselected" (fail closed) without
// needing FKs on every column.
// ---------------------------------------------------------------------------

model UserActiveContext {
  id                String  @id @default(cuid())
  userId            String  @unique
  schoolId          String?
  roleId            String?
  branchId          String?
  academicSessionId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_active_contexts")
}

// ---------------------------------------------------------------------------
// TenantMembership — User ↔ Tenant join. A user may belong to many tenants, so
// tenant is modeled here (NOT as a single tenantId column on User).
// ---------------------------------------------------------------------------

model TenantMembership {
  id       String           @id @default(cuid())
  userId   String
  tenantId String
  status   MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]

  // A user has at most one membership per tenant.
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

// ---------------------------------------------------------------------------
// Role — foundation for future RBAC. Two kinds:
//   • system roles  → isSystem = true,  tenantId = null (seeded once)
//   • tenant custom → isSystem = false, tenantId set    (unique per tenant)
// Permission catalog is intentionally NOT built in this batch.
// System-role `key` uniqueness is enforced in the seed/service layer (a Postgres
// unique over a nullable tenantId cannot express it without a partial index).
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  key         String // e.g. SCHOOL_ADMIN, PRINCIPAL, TEACHER
  name        String
  description String?
  isSystem    Boolean @default(false)
  tenantId    String? // null for system roles

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]
  permissions RolePermission[]

  // Custom role keys are unique within a tenant.
  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([isSystem])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Backend Phase 3 — RBAC. Permission catalog + Role↔Permission mapping.
// Authorization is resolved server-side from these tables (never from the
// browser). Permissions are the primary authority; role identity is secondary.
// ---------------------------------------------------------------------------

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "students.view" (module.action)
  module      String
  action      String
  description String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// RoleAssignment — links a TenantMembership to a Role (roles are always granted
// within a tenant context). School/branch-scoped grants are deferred to the RBAC
// phase; School/Branch already carry stable ids so that can be added without
// reshaping this table.
// ---------------------------------------------------------------------------

model RoleAssignment {
  id           String @id @default(cuid())
  membershipId String
  roleId       String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // A role is assigned at most once per membership.
  @@unique([membershipId, roleId])
  @@index([roleId])
  @@map("role_assignments")
}

// ---------------------------------------------------------------------------
// PlatformAdmin — explicit platform-operator boundary. A User is a platform
// admin ONLY if a row exists here; this is never derived from tenant roles.
// Full Super Admin logic is not implemented in this batch.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id     String       @id @default(cuid())
  userId String       @unique
  role   PlatformRole @default(SUPPORT)
  status UserStatus   @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Session — minimal model for the chosen CUSTOM database-session auth. Only a
// HASH of the session token is stored, never the raw token. No runtime session
// creation/validation is implemented in this batch.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonation PlatformImpersonation?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// PlatformImpersonation — server-authoritative "view a school as platform admin"
// context (Super Admin Phase SA-4K). SECURITY MODEL:
//   • Bound to ONE auth Session (sessionId @unique → at most one active per
//     session). The row is the ONLY authority — never localStorage/cookies/React.
//   • FK cascade to Session: logout (session delete) or a session teardown
//     removes it automatically; an expired session never resolves a user, so the
//     row can never authorize on its own.
//   • Actor stays the platform admin (platformUserId). Target tenant is DERIVED
//     from the target School at start — never client-supplied.
//   • V1 is READ-ONLY inspection: the resolver grants only tenant `.view`
//     permissions for the target, never tenant writes and never a tenant role.
// The start/stop audit trail lives in AuditEvent (IMPERSONATION_STARTED/ENDED);
// this table holds only the single current-state row (deleted on stop).
// ---------------------------------------------------------------------------
model PlatformImpersonation {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  platformUserId String
  targetTenantId String
  targetSchoolId String
  startedAt      DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([targetSchoolId])
  @@map("platform_impersonations")
}

// ===========================================================================
// Backend Phase 4 — Admissions, Students & Guardians.
//
// Real business domain. Org scope (tenant/school/branch/session) is stored as
// plain, indexed String columns and ALWAYS re-validated against the caller's
// real access in the service layer (the same fail-closed convention used by
// UserActiveContext) — so no FK relations are placed on the four core org
// models, keeping this migration self-contained. Relations WITHIN Phase 4
// (Student ↔ StudentGuardian ↔ Guardian, Application ↔ history/notes/docs,
// Student ↔ documents/timeline) use real foreign keys with cascade delete.
//
// Enum values deliberately mirror the existing UI vocabularies so the REST
// APIs speak the shapes the frontend already understands.
// ===========================================================================

/// Mirrors UI StudentStatus (active | inactive | alumni | transferred | archived).
enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
  TRANSFERRED
  ARCHIVED
}

/// Mirrors the UI gender union (male | female | other | prefer-not-to-say).
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// Mirrors UI AdmissionType.
enum AdmissionType {
  NEW
  TRANSFER
  SIBLING
  STAFF_WARD
  MANAGEMENT_QUOTA
}

/// Mirrors UI AdmissionSource.
enum AdmissionSource {
  WEBSITE
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  EDUCATION_FAIR
  AGENT
  PHONE_ENQUIRY
}

/// Mirrors UI AdmissionStageKey. "REJECTED"/"WAITLISTED" are terminal side
/// branches, "ENROLLED" is the converted terminal state.
enum AdmissionStage {
  NEW_ENQUIRY
  APPLICATION_STARTED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  FEE_PENDING
  ENROLLED
  REJECTED
  WAITLISTED
}

/// Mirrors UI StudentGuardianRelationship / GuardianRole.
enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

/// Metadata-only document verification lifecycle (no file storage in Phase 4).
enum DocVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Persisted student timeline event kinds (recorded when the action occurs).
enum StudentTimelineType {
  ADMITTED
  PROFILE_UPDATED
  STATUS_CHANGED
  GUARDIAN_LINKED
  GUARDIAN_UNLINKED
  DOCUMENT_UPDATED
  ADMISSION_CONVERTED
  NOTE_ADDED
}

// ---------------------------------------------------------------------------
// Guardian — a parent/guardian. Tenant-scoped; one Guardian may be linked to
// many Students (via StudentGuardian) and vice-versa. Optional User linkage for
// a future parent portal account. Deduped by (tenantId, email) in the service.
// ---------------------------------------------------------------------------

model Guardian {
  id           String  @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String? // stored lowercased by the service; unique within a tenant when present
  phone        String?
  occupation   String?
  organization String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  photoUrl     String?
  // Optional linkage to a login identity (parent portal). Never required.
  userId       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  students StudentGuardian[]

  // At most one guardian per (tenant, email). Postgres treats NULLs as distinct,
  // so guardians without an email are unconstrained.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("guardians")
}

// ---------------------------------------------------------------------------
// Student — the enrolled learner. Identity/profile only; academic/fee/etc.
// summaries are owned by their future modules and are NOT stored here.
// ---------------------------------------------------------------------------

model Student {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  admissionNumber String
  rollNumber      String?

  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  dateOfBirth   DateTime @db.Date
  gender        Gender   @default(PREFER_NOT_TO_SAY)
  bloodGroup    String?
  nationality   String?
  religion      String?
  category      String?
  motherTongue  String?
  house         String?
  photoUrl      String?

  email String?
  phone String?

  // Denormalized academic placement labels (the academics module owns the real
  // class/section relations later); kept as plain strings for display/filtering.
  classLabel   String?
  sectionLabel String?

  admissionDate DateTime      @db.Date
  admissionType AdmissionType @default(NEW)
  status        StudentStatus @default(ACTIVE)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  // Set when created via admission conversion (traceability; no FK to avoid a
  // circular relation — validated in the service).
  sourceApplicationId String? @unique

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  guardians         StudentGuardian[]
  documents         StudentDocument[]
  timeline          StudentTimelineEvent[]
  enrollments       Enrollment[] // Phase 6-pre — real class/section enrollment
  attendanceRecords AttendanceRecord[] // Phase 5 — attendance
  examMarks         ExamMark[] // Phase 8B — marks entry (Restrict: a marked student can't be hard-deleted)
  examResults       StudentExamResult[] // Phase 8C — published result snapshots (Restrict)
  promotions        StudentPromotion[] // Phase 8E — promotion/retention decisions (Restrict)
  feeAssignments    StudentFeeAssignment[] // Phase 9F — fee billing
  feeCharges        FeeCharge[] // Phase 9F — billable fee items
  feePayments       FeePayment[] // Phase 9F — fee collections

  // Admission number is unique within a school.
  @@unique([schoolId, admissionNumber])
  @@index([tenantId])
  @@index([schoolId, status])
  @@index([branchId])
  @@index([academicSessionId])
  @@map("students")
}

// ---------------------------------------------------------------------------
// StudentGuardian — the Student ↔ Guardian relationship with per-link flags.
// ---------------------------------------------------------------------------

model StudentGuardian {
  id                 String           @id @default(cuid())
  studentId          String
  guardianId         String
  relation           GuardianRelation @default(GUARDIAN)
  isPrimary          Boolean          @default(false)
  isEmergencyContact Boolean          @default(false)
  authorizedPickup   Boolean          @default(false)
  isFeeResponsible   Boolean          @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

// ---------------------------------------------------------------------------
// StudentDocument — metadata only (no cloud/file storage in Phase 4).
// ---------------------------------------------------------------------------

model StudentDocument {
  id                 String                @id @default(cuid())
  studentId          String
  type               String
  displayName        String
  status             String                @default("missing")
  verificationStatus DocVerificationStatus @default(PENDING)
  fileName           String?
  expiryDate         DateTime?             @db.Date
  notes              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// ---------------------------------------------------------------------------
// StudentTimelineEvent — persisted when an action occurs (never faked on read).
// ---------------------------------------------------------------------------

model StudentTimelineEvent {
  id          String              @id @default(cuid())
  studentId   String
  type        StudentTimelineType
  title       String
  detail      String?
  category    String?
  actorUserId String?
  actorName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_timeline_events")
}

// ---------------------------------------------------------------------------
// AdmissionApplication — the admissions pipeline record. Core queryable fields
// are columns; rich optional UI sub-objects (previous school, medical info,
// transport/hostel requirements, fee details, interview, payments) live in a
// single `detailsJson` blob to avoid over-modeling (spec §6: keep it simple).
// Applicant guardians are snapshotted in `guardiansJson` and materialized into
// real Guardian rows only on conversion.
// ---------------------------------------------------------------------------

model AdmissionApplication {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  applicationNumber String
  draft             Boolean         @default(false)
  stage             AdmissionStage  @default(NEW_ENQUIRY)
  priority          String          @default("medium")
  source            AdmissionSource @default(WEBSITE)
  admissionType     AdmissionType   @default(NEW)

  appliedClass             String?
  appliedSectionPreference String?

  // Applicant identity
  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  dateOfBirth   DateTime? @db.Date
  gender        Gender    @default(PREFER_NOT_TO_SAY)
  bloodGroup    String?
  nationality   String?
  religion      String?
  category      String?
  motherTongue  String?
  photoUrl      String?

  email String?
  phone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  guardiansJson Json? // ApplicantGuardian[] snapshot (materialized on conversion)
  detailsJson   Json? // previousSchool / medical / transport / hostel / fee / interview / payments

  assignedOfficerId   String?
  assignedOfficerName String?

  submittedAt DateTime? @db.Timestamptz(6)
  approvedAt  DateTime? @db.Timestamptz(6)
  rejectedAt  DateTime? @db.Timestamptz(6)
  enrolledAt  DateTime? @db.Timestamptz(6)

  // Set once, in the conversion transaction. Uniqueness + a stage guard prevent
  // double conversion.
  convertedStudentId String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  stageHistory AdmissionStageHistory[]
  notes        AdmissionNote[]
  documents    AdmissionDocument[]

  @@unique([schoolId, applicationNumber])
  @@index([tenantId])
  @@index([schoolId, stage])
  @@index([branchId])
  @@index([academicSessionId])
  @@map("admission_applications")
}

// ---------------------------------------------------------------------------
// AdmissionStageHistory — persisted stage transitions (audit trail).
// ---------------------------------------------------------------------------

model AdmissionStageHistory {
  id              String          @id @default(cuid())
  applicationId   String
  fromStage       AdmissionStage?
  toStage         AdmissionStage
  changedByUserId String?
  changedByName   String?
  reason          String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("admission_stage_history")
}

// ---------------------------------------------------------------------------
// AdmissionNote — internal notes on an application.
// ---------------------------------------------------------------------------

model AdmissionNote {
  id            String  @id @default(cuid())
  applicationId String
  authorUserId  String?
  authorName    String
  authorRole    String?
  body          String
  pinned        Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("admission_notes")
}

// ---------------------------------------------------------------------------
// AdmissionDocument — metadata only (transferred to StudentDocument on convert).
// ---------------------------------------------------------------------------

model AdmissionDocument {
  id                 String                @id @default(cuid())
  applicationId      String
  type               String
  displayName        String
  status             String                @default("missing")
  verificationStatus DocVerificationStatus @default(PENDING)
  fileName           String?
  expiryDate         DateTime?             @db.Date
  notes              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("admission_documents")
}

// ---------------------------------------------------------------------------
// AuditEvent — lightweight, generic audit log for important business actions
// (spec §30). Org-scoped; no bulky PII payloads (only ids + a small meta blob).
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String  @id @default(cuid())
  tenantId    String
  schoolId    String?
  actorUserId String?
  actorName   String?
  action      String // e.g. STUDENT_CREATED, ADMISSION_CONVERTED
  entityType  String // e.g. Student, AdmissionApplication, Guardian
  entityId    String
  metaJson    Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// SchoolOnboarding — platform-side onboarding state for a provisioned school
// (Super Admin Phase SA-3). One row per school (1:1). Progress is the ratio of
// completedSteps to the code-defined required steps — never a stored percentage.
// Completing onboarding flips School.status SETUP_PENDING → ACTIVE.
// ---------------------------------------------------------------------------

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model SchoolOnboarding {
  id       String @id @default(cuid())
  tenantId String
  schoolId String @unique

  status         OnboardingStatus @default(IN_PROGRESS)
  currentStep    String
  completedSteps String[] // ordered list of completed step keys

  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("school_onboarding")
}

// ===========================================================================
// Super Admin Phase SA-4A — Plans (subscription plan catalog). Platform-global
// (NOT tenant-scoped): the price/limits/feature-entitlements template that later
// Subscriptions/Trials/Usage/Billing phases will reference. Monetary values are
// structured (Decimal + currency code) — never formatted strings. Archived
// instead of hard-deleted so future subscriptions stay historically valid.
// ===========================================================================

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  status          PlanStatus      @default(DRAFT)
  billingInterval BillingInterval @default(MONTHLY)
  currency        String          @default("INR") // ISO-4217; formatted client-side
  price           Decimal         @db.Decimal(12, 2)
  trialDays       Int             @default(0)
  isPublic        Boolean         @default(true)
  sortOrder       Int             @default(0)

  // Structured plan limits (null = unlimited / not set). Live usage calculation
  // is a later phase (Usage & Limits) — these are just the plan's ceilings.
  maxStudents Int?
  maxStaff    Int?
  maxBranches Int?
  storageGb   Int?

  // Display metadata carried by the existing UI.
  supportLevel String?
  whiteLabel   Boolean @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  features      PlanFeature[]
  subscriptions Subscription[] // Super Admin Phase SA-4B

  @@index([status])
  @@index([billingInterval])
  @@index([sortOrder])
  @@map("plans")
}

model PlanFeature {
  id     String @id @default(cuid())
  planId String
  key    String // e.g. students, admissions, attendance, fees, transport, library

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
  @@map("plan_features")
}

// ===========================================================================
// Super Admin Phase SA-4B — Subscriptions. Connects a real School (and its
// Tenant) to a real Plan. Plan pricing/features/limits remain the Plan's — the
// source of truth. Only the minimal COMMERCIAL TERMS are snapshotted here
// (priceAmount + currency + billingInterval) so a subscription's agreed price
// stays historically stable even if the Plan's price later changes. No
// payment-provider IDs and no proration in SA-4B.
//
// "Current subscription" invariant: a school has at most one CURRENT
// subscription, where CURRENT = status in {TRIALING, ACTIVE, PAST_DUE}.
// CANCELLED / ENDED are terminal and may accumulate as history. Enforced in the
// service (transaction) AND by a partial unique index added in the migration:
//   CREATE UNIQUE INDEX subscriptions_one_current_per_school
//     ON subscriptions(school_id) WHERE status IN ('TRIALING','ACTIVE','PAST_DUE');
// ===========================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  ENDED
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  planId   String

  status SubscriptionStatus @default(ACTIVE)

  // Lifecycle dates.
  startDate          DateTime  @db.Timestamptz(6)
  currentPeriodStart DateTime  @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @db.Timestamptz(6)
  trialStart         DateTime? @db.Timestamptz(6)
  trialEnd           DateTime? @db.Timestamptz(6)

  // Cancellation. cancelAtPeriodEnd keeps the subscription CURRENT until the
  // period ends; an immediate cancel sets status=CANCELLED + cancelledAt now.
  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime? @db.Timestamptz(6)
  endedAt           DateTime? @db.Timestamptz(6)

  // Snapshotted commercial terms (NOT the live Plan fields).
  priceAmount     Decimal         @db.Decimal(12, 2)
  currency        String          @default("INR")
  billingInterval BillingInterval @default(MONTHLY)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[] // Super Admin Phase SA-4D
  payments Payment[] // Super Admin Phase SA-4E

  @@index([schoolId])
  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ===========================================================================
// Super Admin Phase SA-4D — Invoices. Generated from a real Subscription; the
// source chain is Tenant → School → Subscription → commercial snapshot → Invoice.
// Money is Decimal (never formatted strings). The subscription's snapshotted
// commercial terms (priceAmount/currency) are the invoice basis — the invoice
// then snapshots its OWN amounts, so a later Plan/Subscription change never
// rewrites an issued invoice.
//
// Lifecycle: DRAFT → OPEN → PAID | VOID (and DRAFT → VOID). OVERDUE is NOT a
// stored state — it is derived: status=OPEN && dueAt < now && amountDue > 0.
// No payment provider in SA-4D; PAID is reached only via an explicit manual
// administrative settlement (mark-paid) — no Payment rows are created.
//
// Invoice numbers come from a Postgres sequence (invoice_number_seq, created in
// the migration) for concurrency-safe uniqueness, backed by a UNIQUE constraint.
// One invoice per subscription billing period is enforced by @@unique below.
// ===========================================================================

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  tenantId       String
  schoolId       String
  subscriptionId String
  status         InvoiceStatus @default(DRAFT)

  currency       String  @default("INR")
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountDue      Decimal @db.Decimal(12, 2)

  periodStart DateTime  @db.Timestamptz(6)
  periodEnd   DateTime  @db.Timestamptz(6)
  issuedAt    DateTime? @db.Timestamptz(6)
  dueAt       DateTime  @db.Timestamptz(6)
  paidAt      DateTime? @db.Timestamptz(6)
  voidedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  lineItems    InvoiceLineItem[]
  payments     Payment[] // Super Admin Phase SA-4E

  // One invoice per subscription billing period (duplicate-generation guard).
  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([schoolId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ===========================================================================
// Super Admin Phase SA-4E — Payments. A real financial record settling an
// Invoice: Tenant → School → Subscription → Invoice → Payment. Recording a
// payment atomically increments Invoice.amountPaid / decrements amountDue and
// flips the invoice to PAID when fully settled. Supports partial payments and
// administrative reversal (history preserved). Money is Decimal(12,2).
//
// This is an internal/manual ledger — NO payment gateway. Methods are offline
// (cash/bank/UPI/cheque); "UPI" here means a manually recorded UPI transfer, not
// automated gateway verification. Payment numbers come from payment_number_seq
// (created in the migration) for concurrency-safe uniqueness.
// ===========================================================================

enum PaymentStatus {
  SUCCEEDED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

model Payment {
  id             String        @id @default(cuid())
  paymentNumber  String        @unique
  tenantId       String
  schoolId       String
  invoiceId      String
  subscriptionId String
  status         PaymentStatus @default(SUCCEEDED)
  method         PaymentMethod

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  reference        String? // e.g. UTR / cheque no. — manually entered, optional
  notes            String?
  receivedAt       DateTime  @db.Timestamptz(6)
  recordedByUserId String?
  recordedByName   String?
  reversedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

// ===========================================================================
// Super Admin Phase SA-4I — Support tickets. Platform-level support (separate
// from the tenant/school helpdesk). A ticket belongs to a real Tenant (and
// optionally a School). Assignment is to a platform admin (validated in the
// service; stored as a plain userId + denormalized name, no FK to keep it
// simple). Escalation is DERIVED (never a stored boolean). Ticket numbers come
// from support_ticket_number_seq (concurrency-safe) + a UNIQUE constraint.
// Conversation entries live in SupportTicketMessage; internal notes are the same
// table with `internal = true` and are split out in the API DTO.
// ===========================================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BILLING
  ACCOUNT
  TECHNICAL
  ONBOARDING
  FEATURE
  OTHER
}

model SupportTicket {
  id           String                @id @default(cuid())
  ticketNumber String                @unique
  tenantId     String
  schoolId     String?
  subject      String
  description  String
  category     SupportTicketCategory @default(OTHER)
  priority     SupportTicketPriority @default(MEDIUM)
  status       SupportTicketStatus   @default(OPEN)

  assignedToUserId String?
  assignedToName   String?
  createdByUserId  String?
  createdByName    String?
  createdByEmail   String?

  openedAt        DateTime  @default(now()) @db.Timestamptz(6)
  firstResponseAt DateTime? @db.Timestamptz(6)
  resolvedAt      DateTime? @db.Timestamptz(6)
  closedAt        DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([tenantId])
  @@index([schoolId])
  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String  @id @default(cuid())
  ticketId     String
  authorUserId String?
  authorName   String
  body         String
  internal     Boolean @default(false) // true = platform-internal note

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// ===========================================================================
// Super Admin Phase SA-4L — Features, Domains & Branding.
//
// Feature ENTITLEMENT (does a SCHOOL/PLAN have a module?) is distinct from RBAC
// (can a USER perform an action?). Plan defaults come from PlanFeature (a key is
// "included" when a PlanFeature row exists for the school's current plan). A
// SchoolFeatureOverride flips a single key on/off for one school on top of that
// default. Effective = override ?? plan-default. Enforcement (feature + RBAC)
// is resolved server-side (lib/server/platform/features-service).
//
// Domains & Branding are per-school platform configuration. NO external DNS/SSL
// provider or file-storage integration in this phase — status is honest
// (PENDING until a clearly-labelled manual admin action), branding is
// URL/metadata only (no uploads, no client-storage persistence).
// ===========================================================================

model SchoolFeatureOverride {
  id         String  @id @default(cuid())
  schoolId   String
  tenantId   String // derived from the school; denormalised for tenant-scoped queries
  featureKey String // one of lib/plans/features FEATURE_KEYS
  enabled    Boolean // explicit on/off applied over the plan default
  reason     String?
  createdBy  String? // platform admin userId

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, featureKey]) // at most one override per (school, feature)
  @@index([schoolId])
  @@index([tenantId])
  @@map("school_feature_overrides")
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING // awaiting (manual) verification — the honest default
  VERIFIED
  FAILED
  DISABLED
}

model SchoolDomain {
  id                String       @id @default(cuid())
  tenantId          String // derived from the school
  schoolId          String
  hostname          String       @unique // bare host only (no protocol/path), lowercased
  type              DomainType   @default(CUSTOM)
  status            DomainStatus @default(PENDING)
  isPrimary         Boolean      @default(false)
  verificationToken String? // opaque token for the DNS TXT instructions (no DNS lookups here)
  verifiedAt        DateTime?    @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([tenantId])
  @@index([status])
  @@map("school_domains")
}

model SchoolBranding {
  id       String @id @default(cuid())
  schoolId String @unique
  tenantId String // derived from the school

  displayName      String?
  logoUrl          String? // URL only — no file uploads in this phase
  faviconUrl       String?
  primaryColor     String? // validated #RRGGBB server-side
  secondaryColor   String?
  accentColor      String?
  loginHeadline    String?
  loginSubheadline String?
  footerText       String?
  updatedBy        String? // platform admin userId

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("school_brandings")
}

// ===========================================================================
// Super Admin Phase SA-4M — Add-ons & Marketplace.
//
// ADD-ON: an optional commercial/product extension assigned to a school
// INDEPENDENTLY of its base Plan (distinct from a PlanFeature entitlement,
// SA-4L). Assignment means "this school is entitled to use this add-on"; the
// agreed commercial terms are SNAPSHOTTED on assignment. NO payment provider,
// gateway subscription, invoice or charge is created here.
//
// MARKETPLACE APP: an optional/external integration a school can install. This
// phase persists installation INTENT + enabled/disabled status + non-secret
// configuration metadata only. It NEVER fakes OAuth/token exchange/webhook
// registration/provider connectivity, and NEVER stores or returns secrets.
// ===========================================================================

enum AddOnStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SchoolAddOnStatus {
  ACTIVE
  ENDED
}

model AddOn {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  category        String?
  status          AddOnStatus      @default(ACTIVE)
  // Optional commercial terms (Decimal money). No provider billing in this phase.
  priceAmount     Decimal?         @db.Decimal(12, 2)
  currency        String           @default("INR")
  billingInterval BillingInterval?

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  assignments SchoolAddOn[]

  @@index([status])
  @@map("addons")
}

model SchoolAddOn {
  id       String            @id @default(cuid())
  tenantId String // derived from the school
  schoolId String
  addOnId  String
  status   SchoolAddOnStatus @default(ACTIVE)

  startedAt DateTime  @default(now()) @db.Timestamptz(6)
  endedAt   DateTime? @db.Timestamptz(6)

  // Commercial terms snapshotted at assignment (stable even if the catalog price
  // later changes). Nullable when the add-on has no price.
  priceAmount     Decimal?         @db.Decimal(12, 2)
  currency        String?
  billingInterval BillingInterval?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  addOn  AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  // One assignment row per (school, add-on) — status toggles ACTIVE/ENDED, so a
  // school can never hold two active assignments of the same add-on.
  @@unique([schoolId, addOnId])
  @@index([tenantId])
  @@index([addOnId])
  @@index([schoolId, status])
  @@map("school_addons")
}

enum MarketplaceAppStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MarketplaceInstallStatus {
  INSTALLED
  DISABLED
}

model MarketplaceApp {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  description      String?
  category         String
  providerName     String?
  status           MarketplaceAppStatus @default(ACTIVE)
  documentationUrl String?

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  installations SchoolMarketplaceInstallation[]

  @@index([status])
  @@index([category])
  @@map("marketplace_apps")
}

model SchoolMarketplaceInstallation {
  id       String                   @id @default(cuid())
  tenantId String // derived from the school
  schoolId String
  appId    String
  status   MarketplaceInstallStatus @default(INSTALLED)

  installedAt   DateTime  @default(now()) @db.Timestamptz(6)
  disabledAt    DateTime? @db.Timestamptz(6)
  // NON-SECRET configuration metadata only. Secrets (API keys / tokens / client
  // secrets) are never stored here and never returned in DTOs.
  configuration Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  app    MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  // One installation row per (school, app) — status toggles INSTALLED/DISABLED.
  @@unique([schoolId, appId])
  @@index([tenantId])
  @@index([appId])
  @@map("school_marketplace_installations")
}

// ===========================================================================
// Super Admin Phase SA-4N — System (final): Settings, Announcements, Incidents.
//
// Platform Admins reuse the existing PlatformAdmin/User models (no new identity
// model). Audit/Activity are a read view over the existing AuditEvent table (no
// second event store). Only these three genuinely-new pieces of state are added.
// ===========================================================================

// One-row singleton (fixed id "singleton"): platform-wide configuration. Holds
// only SAFE, non-secret DB configuration — never SMTP/API/OAuth/payment secrets
// or infrastructure/runtime credentials.
model PlatformSetting {
  id                 String  @id @default("singleton")
  platformName       String  @default("Novyra Campus OS")
  supportEmail       String?
  defaultLocale      String  @default("en-IN")
  defaultTimezone    String  @default("Asia/Kolkata")
  defaultCurrency    String  @default("INR")
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  signupEnabled      Boolean @default(true)
  defaultTrialDays   Int     @default(14)
  updatedByUserId    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_settings")
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL_PLATFORM_USERS
  PLATFORM_ADMINS
  ALL_SCHOOLS
}

model PlatformAnnouncement {
  id              String               @id @default(cuid())
  title           String
  body            String
  category        String? // e.g. product-update | maintenance | security | billing | policy
  status          AnnouncementStatus   @default(DRAFT)
  audience        AnnouncementAudience @default(ALL_SCHOOLS)
  // Optional display window; NOT a delivery mechanism (announcements are shown
  // in-app only — no email/SMS/push is sent).
  startsAt        DateTime?            @db.Timestamptz(6)
  endsAt          DateTime?            @db.Timestamptz(6)
  publishedAt     DateTime?            @db.Timestamptz(6)
  createdByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("platform_announcements")
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

// A manually-recorded platform incident/maintenance notice. There is NO external
// uptime/telemetry monitoring — the status page reports only real, measurable
// internal signals (maintenance mode, DB reachability) plus these manual records.
model PlatformIncident {
  id              String           @id @default(cuid())
  title           String
  description     String?
  severity        IncidentSeverity @default(MINOR)
  status          IncidentStatus   @default(INVESTIGATING)
  startedAt       DateTime         @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime?        @db.Timestamptz(6)
  createdByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("platform_incidents")
}

// ===========================================================================
// Phase 6-pre — Academics FOUNDATION (Class / Section / Enrollment) ONLY.
//
// The minimum real academic grouping required to unblock Attendance (Phase 5).
// NOT a broad Academics rewrite: no Subjects/Timetable/Exams/Marks/Homework here.
// Class is school + academic-session scoped; a Section belongs to a Class AND a
// Branch (attendance is branch-scoped); a student has at most one Enrollment per
// academic session (→ their Section). Org columns mirror the Phase-4 convention
// (plain indexed strings, re-validated in the service) EXCEPT the intra-domain
// relations (Class↔Section↔Enrollment) and Enrollment→Student, which use real FKs.
// ===========================================================================

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum SectionStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED
  WITHDRAWN
}

model Class {
  id                String      @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  name              String
  order             Int         @default(0)
  status            ClassStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  sections         Section[]
  enrollments      Enrollment[]
  classSubjects    ClassSubject[] // Phase 6 — subjects taught in this class
  examClasses      ExamClass[] // Phase 8A — exam applicability
  targetPromotions StudentPromotion[] // Phase 8E — promotions targeting this class
  curricula        Curriculum[] // Phase 9C.1 — curriculum/syllabus tracking
  feeStructures    FeeStructureClass[] // Phase 9F — fee structures targeting this class

  // One class name per school + academic session.
  @@unique([schoolId, academicSessionId, name])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("classes")
}

model Section {
  id                String        @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  classId           String
  name              String
  capacity          Int           @default(40)
  status            SectionStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class               Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  attendanceSessions  AttendanceSession[] // Phase 5 — attendance
  teachingAssignments TeachingAssignment[] // Phase 6A — teacher ↔ section+subject
  timetableEntries    TimetableEntry[] // Phase 7 — timetable
  examScheduleEntries ExamScheduleEntry[] // Phase 8A — exam schedule
  targetPromotions    StudentPromotion[] // Phase 8E — promotions targeting this section
  homework            Homework[] // Phase 9B — homework/assignments
  curriculumProgress  CurriculumTopicProgress[] // Phase 9C.1 — section-scoped syllabus progress
  lessonPlans         LessonPlan[] // Phase 9C.2 — lesson plans

  // One section name per class.
  @@unique([classId, name])
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@index([classId])
  @@map("sections")
}

model Enrollment {
  id                String           @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  classId           String
  sectionId         String
  studentId         String
  rollNumber        String?
  status            EnrollmentStatus @default(ENROLLED)
  enrolledAt        DateTime         @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class             Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[] // Phase 5 — attendance
  examMarks         ExamMark[] // Phase 8B — historical reference only (SetNull on unenrollment)
  examResults       StudentExamResult[] // Phase 8C — historical reference only (SetNull on unenrollment)
  // Phase 8E — Restrict (not SetNull): once a promotion decision references an
  // enrollment (as either its source or its own newly-created target), that
  // enrollment is historical truth and must never be deleted out from under it.
  promotionsFrom    StudentPromotion[]  @relation("PromotionFromEnrollment")
  promotionsTo      StudentPromotion[]  @relation("PromotionNewEnrollment")
  feeAssignments    StudentFeeAssignment[] // Phase 9F — traceability only, never re-validated after the fact

  // One enrollment row per student per academic session; a student appears at
  // most once in a given section.
  @@unique([academicSessionId, studentId])
  @@unique([sectionId, studentId])
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@index([classId])
  @@index([sectionId])
  @@index([studentId])
  @@map("enrollments")
}

// ===========================================================================
// Phase 5 — Attendance. Real, PostgreSQL-backed student attendance keyed on the
// Academics Foundation (Section + Enrollment), NOT label strings.
//
// AttendanceSession = one register per (section, calendar day). AttendanceRecord
// = one per enrolled student per session — the HISTORICAL snapshot (never
// silently rewritten when enrollment later changes). Date is a date-only column
// (school-local calendar day, supplied as YYYY-MM-DD, normalized to UTC-midnight
// at the service boundary so browser timezones can't shift the day).
// ===========================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
  MEDICAL_LEAVE
  OFFICIAL_DUTY
}

enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

// Phase 7C — a session is either the whole-day register (DAILY) or a single
// timetable lesson (PERIOD). Existing rows default to DAILY.
enum AttendanceSessionType {
  DAILY
  PERIOD
}

model AttendanceSession {
  id                String                  @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  sectionId         String
  date              DateTime                @db.Date
  type              AttendanceSessionType   @default(DAILY)
  status            AttendanceSessionStatus @default(DRAFT)

  // Phase 7C — PERIOD sessions bind to a real TimetableEntry (SetNull so deleting
  // the lesson never deletes attendance history). The snapshot columns below are
  // captured at creation and NEVER mutated, so historical subject/period/teacher
  // meaning survives a later timetable move/delete, subject archive or staff change.
  timetableEntryId String?
  periodId         String?
  subjectId        String?
  staffId          String?
  periodName       String?
  subjectCode      String?
  subjectName      String?
  staffName        String?

  markedByUserId String?
  markedByName   String?
  submittedAt    DateTime? @db.Timestamptz(6)
  lockedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section        Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  timetableEntry TimetableEntry?    @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  records        AttendanceRecord[]

  // Uniqueness is enforced by TWO PARTIAL unique indexes added in the migration
  // (Prisma cannot express partial uniques): DAILY → (sectionId, date) WHERE
  // type='DAILY'; PERIOD → (timetableEntryId, date) WHERE type='PERIOD'. Both are
  // concurrency-safe. The plain indexes below cover the read patterns.
  @@index([tenantId])
  @@index([schoolId, academicSessionId, type, date])
  @@index([branchId, academicSessionId, date])
  @@index([sectionId, date])
  @@index([timetableEntryId, date])
  @@index([subjectId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  attendanceSessionId String
  studentId           String
  // The enrollment the record was marked against (captured at marking time). Kept
  // for provenance; nullable + SetNull so unenrolling a student later does NOT
  // delete/alter the historical attendance record (§22 historical correctness).
  enrollmentId        String?
  status              AttendanceStatus @default(PRESENT)
  remarks             String?
  markedAt            DateTime?        @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  session    AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  // Student rows are archived, never hard-deleted, so Restrict guards history.
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment Enrollment?       @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // One record per student per session.
  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([attendanceSessionId])
  @@map("attendance_records")
}

// ===========================================================================
// Phase 6 — Academics Core: Subjects. Real, PostgreSQL-backed subject catalog +
// class-level subject assignment. The Subject catalog is SCHOOL-scoped (a stable
// catalogue reused across academic sessions); which subjects a Class teaches is
// the session-scoped ClassSubject join (real FK to Class + Subject). Sections
// INHERIT their Class's subjects — there is no SectionSubject table. Teacher /
// timetable / marks assignment is deliberately NOT modelled here (no real Staff
// entity yet). Org columns are plain indexed strings re-validated in the service
// (Phase-4 convention); the intra-domain Class↔ClassSubject↔Subject links are FKs.
// ===========================================================================

enum SubjectType {
  CORE
  ELECTIVE
  OPTIONAL
  PRACTICAL
  LANGUAGE
  CO_CURRICULAR
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

model Subject {
  id              String        @id @default(cuid())
  tenantId        String
  schoolId        String
  code            String
  name            String
  shortName       String
  department      String
  type            SubjectType   @default(CORE)
  gradeRangeStart Int           @default(0)
  gradeRangeEnd   Int           @default(13)
  credit          Int           @default(4)
  passingMarks    Int           @default(33)
  maxMarks        Int           @default(100)
  theoryMarks     Int           @default(100)
  practicalMarks  Int           @default(0)
  color           String        @default("#18b0c8")
  order           Int           @default(0)
  status          SubjectStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  classSubjects       ClassSubject[]
  teachingAssignments TeachingAssignment[] // Phase 6A — teacher ↔ section+subject
  timetableEntries    TimetableEntry[] // Phase 7 — timetable
  examScheduleEntries ExamScheduleEntry[] // Phase 8A — exam schedule
  homework            Homework[] // Phase 9B — homework/assignments
  curricula           Curriculum[] // Phase 9C.1 — curriculum/syllabus tracking
  lessonPlans         LessonPlan[] // Phase 9C.2 — lesson plans

  // One subject code per school (catalogue is school-wide, reused across sessions).
  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("subjects")
}

model ClassSubject {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  classId           String
  subjectId         String
  isCore            Boolean @default(true)
  order             Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // A subject is assigned to a class at most once.
  @@unique([classId, subjectId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

// ===========================================================================
// Phase 6A — Staff / Teacher foundation (prerequisite for Timetable). A Staff
// record is a school-domain EMPLOYEE, distinct from the auth `User` (login
// identity). Staff is tenant/school/BRANCH scoped and NOT academic-session
// scoped — employees persist across years; session-specific teaching lives in
// TeachingAssignment. `userId` is an OPTIONAL 1:1 link to a login account (staff
// may exist without one). Teaching eligibility is the explicit `isTeaching`
// flag (never inferred from a name). Org columns are plain indexed strings
// re-validated in the service; intra-domain links (Staff↔TeachingAssignment,
// TeachingAssignment→Section/Subject) are real FKs.
// ===========================================================================

enum StaffStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

model Staff {
  id             String          @id @default(cuid())
  tenantId       String
  schoolId       String
  branchId       String
  employeeCode   String
  firstName      String
  lastName       String?
  displayName    String?
  email          String?
  phone          String?
  designation    String?
  department     String?
  employmentType EmploymentType?
  isTeaching     Boolean         @default(false)
  status         StaffStatus     @default(ACTIVE)
  joiningDate    DateTime?       @db.Date
  userId         String?         @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user                    User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  teachingAssignments     TeachingAssignment[]
  timetableEntries        TimetableEntry[] // Phase 7 — timetable
  examInvigilations       ExamScheduleEntry[] // Phase 8A — optional invigilator
  homework                Homework[] // Phase 9B — homework/assignments
  curriculumTopicProgress CurriculumTopicProgress[] // Phase 9C.1 — topics this staff marked complete
  lessonPlans             LessonPlan[] // Phase 9C.2 — lesson plans
  attendanceRecords       StaffAttendanceRecord[] // Phase 9E.1 — own daily attendance
  leaveRequests           LeaveRequest[] // Phase 9E.2 — own leave requests
  salaryAssignments       StaffSalaryAssignment[] // Phase 9H — effective-dated salary assignments
  payrollItems            PayrollRunItem[] // Phase 9H — payroll snapshots

  // One employee code per school.
  @@unique([schoolId, employeeCode])
  @@index([tenantId])
  @@index([schoolId, branchId, status])
  @@index([schoolId, isTeaching, status])
  @@map("staff")
}

// A teacher (Staff) teaching a Subject in a Section for the section's academic
// session. Real FKs to Section + Subject + Staff. The Subject must be part of the
// Section's Class curriculum (validated via getSubjectsForSection) and the Staff
// must be ACTIVE + teaching-eligible + in the section's branch. Multiple teachers
// per (section, subject) are allowed (co-teaching), but a given staff is assigned
// to a (section, subject) at most once.
model TeachingAssignment {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  sectionId         String
  subjectId         String
  staffId           String
  isPrimary         Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff            Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[] // Phase 7 — timetable (Restrict: can't remove a scheduled assignment)
  homework         Homework[] // Phase 9B — homework (Restrict: can't remove an assignment with homework attached)
  lessonPlans      LessonPlan[] // Phase 9C.2 — lesson plans (Restrict: can't remove an assignment with lesson plans attached)

  @@unique([sectionId, subjectId, staffId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([staffId])
  @@map("teaching_assignments")
}

// ===========================================================================
// Phase 7 — Timetable. Two concepts: the daily PERIOD STRUCTURE (bell schedule)
// and the actual TEACHING SCHEDULE (weekly recurring entries).
//
// TimetablePeriod = one column of the school day (branch + session scoped).
// Times are stored as MINUTES FROM MIDNIGHT (deterministic, timezone-free).
// Type TEACHING columns hold lessons; BREAK columns (short break / lunch /
// assembly) cannot hold a teaching entry.
//
// TimetableEntry = a lesson: this Staff teaches this Subject to this Section in
// this Period on this Weekday. teachingAssignmentId is the AUTHORITATIVE relation
// ("Staff Z may teach Subject Y to Section X") — the denormalized sectionId /
// subjectId / staffId columns are validated to match it on every write and exist
// so the two conflict constraints can be enforced by the DATABASE (concurrency-
// safe, not findFirst→create):
//   • Section conflict  → @@unique([sectionId, weekday, periodId])
//   • Teacher conflict  → @@unique([staffId,  weekday, periodId])
// teachingAssignmentId uses onDelete: Restrict so a scheduled assignment cannot be
// silently removed (timetable history stays consistent — plan §41). No Room model
// exists yet, so room scheduling is deferred (no roomId). No draft/publish
// lifecycle container: entries are live (plan §15/§16 — not overbuilt).
// ===========================================================================

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PeriodType {
  TEACHING
  BREAK
}

model TimetablePeriod {
  id                String     @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  name              String
  periodNumber      Int
  startMinutes      Int // minutes from midnight (e.g. 08:00 → 480)
  endMinutes        Int
  type              PeriodType @default(TEACHING)
  order             Int        @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  entries TimetableEntry[]

  // One period number per branch/session bell schedule.
  @@unique([schoolId, branchId, academicSessionId, periodNumber])
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@map("timetable_periods")
}

model TimetableEntry {
  id                   String  @id @default(cuid())
  tenantId             String
  schoolId             String
  branchId             String
  academicSessionId    String
  sectionId            String
  subjectId            String
  staffId              String
  teachingAssignmentId String
  periodId             String
  weekday              Weekday
  notes                String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff              Staff               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment  @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  period             TimetablePeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[] // Phase 7C — period attendance (SetNull keeps history)

  // DB-enforced conflict prevention (concurrency-safe).
  @@unique([sectionId, weekday, periodId]) // a section: one lesson per weekday+period
  @@unique([staffId, weekday, periodId]) // a teacher: one place per weekday+period
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@index([sectionId])
  @@index([staffId])
  @@index([periodId])
  @@index([teachingAssignmentId])
  @@map("timetable_entries")
}

// ===========================================================================
// Phase 8A — Exams foundation (term / exam / class applicability / subject
// schedule). Marks, results, grading and report cards are DELIBERATELY not
// modelled here (Phase 8B+). Three concepts, kept separate:
//   ExamTerm            — a term/cycle within an academic session ("Term 1").
//   Exam                — a named exam event under a term.
//   ExamClass           — which real Classes an Exam applies to (join).
//   ExamScheduleEntry   — when a Subject's paper happens: real Section + real
//                         Subject + date/time, SECTION-scoped (matches the
//                         Section-anchored convention used by Attendance,
//                         Timetable and Enrollment throughout this codebase).
//
// Marks limits (maxMarks/passingMarks/theoryMarks/practicalMarks) are
// SNAPSHOTTED onto the schedule entry at creation from the Subject's current
// defaults — never read live from Subject — so a later Subject edit can never
// rewrite a historical exam's marks configuration (Phase 8B stability).
//
// Conflict prevention: at most one scheduled paper per Section per calendar
// day (@@unique[sectionId,examDate]) — the standard "one paper per day" school
// policy, DB-enforced and concurrency-safe. The optional invigilator similarly
// gets at most one assignment per calendar day (@@unique[invigilatorStaffId,
// examDate] — Postgres unique constraints permit unlimited NULLs, so this is
// safe with no invigilator selected). No Room/Hall model exists yet, so room
// scheduling is deliberately NOT represented here (plan §15).
// ===========================================================================

enum ExamTermStatus {
  ACTIVE
  ARCHIVED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  ARCHIVED
}

enum ExamType {
  UNIT_TEST
  WEEKLY_TEST
  MONTHLY_TEST
  MIDTERM
  HALF_YEARLY
  ANNUAL
  PRE_BOARD
  BOARD
  PRACTICAL
  ORAL
  ASSIGNMENT
  PROJECT
  INTERNAL_ASSESSMENT
  CUSTOM
}

enum ExamScope {
  INTERNAL
  EXTERNAL
}

enum ExamMode {
  ONLINE
  OFFLINE
}

model ExamTerm {
  id                String         @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  name              String
  code              String
  order             Int            @default(0)
  status            ExamTermStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  exams Exam[]

  // One term code per school + academic session.
  @@unique([schoolId, academicSessionId, code])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("exam_terms")
}

model Exam {
  id                String     @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  examTermId        String
  name              String
  code              String
  type              ExamType   @default(CUSTOM)
  description       String?
  startsOn          DateTime   @db.Date
  endsOn            DateTime   @db.Date
  scope             ExamScope  @default(INTERNAL)
  mode              ExamMode   @default(OFFLINE)
  status            ExamStatus @default(DRAFT)
  gradingSchemeId   String? // Phase 8C — which GradingScheme resolves this exam's grades; explicit, not inferred by class

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  term              ExamTerm               @relation(fields: [examTermId], references: [id], onDelete: Restrict)
  classes           ExamClass[]
  schedule          ExamScheduleEntry[]
  gradingScheme     GradingScheme?         @relation(fields: [gradingSchemeId], references: [id], onDelete: SetNull)
  resultPublication ExamResultPublication? // Phase 8C — at most one publication per exam

  // One exam code per school + academic session.
  @@unique([schoolId, academicSessionId, code])
  @@index([tenantId])
  @@index([schoolId, academicSessionId, status])
  @@index([examTermId])
  @@map("exams")
}

/**
 * Which real Classes an Exam applies to; Sections inherit through their Class.
 */
model ExamClass {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  examId            String
  classId           String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([examId, classId])
  @@index([tenantId])
  @@index([examId])
  @@index([classId])
  @@map("exam_classes")
}

model ExamScheduleEntry {
  id                String   @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  examId            String
  sectionId         String
  subjectId         String
  examDate          DateTime @db.Date
  startMinutes      Int // minutes from midnight — same deterministic convention as TimetablePeriod
  endMinutes        Int

  // Snapshotted from Subject at creation — NEVER re-read live (Phase 8B stability).
  maxMarks       Int
  passingMarks   Int
  theoryMarks    Int
  practicalMarks Int

  invigilatorStaffId String? // optional; NOT the subject's TeachingAssignment teacher
  notes              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  section     Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  invigilator Staff?         @relation(fields: [invigilatorStaffId], references: [id], onDelete: SetNull)
  markSheet   ExamMarkSheet? // Phase 8B — marks entry (get-or-create, one per entry)

  // No duplicate subject paper for the same exam+section.
  @@unique([examId, sectionId, subjectId])
  // At most one paper per Section per calendar day (DB-enforced, concurrency-safe).
  @@unique([sectionId, examDate])
  // At most one assignment per invigilator per calendar day (NULLs are unlimited).
  @@unique([invigilatorStaffId, examDate])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([examId])
  @@index([subjectId])
  @@map("exam_schedule_entries")
}

// ── Phase 8B: Marks entry ───────────────────────────────────────────────────

enum ExamMarkSheetStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum ExamMarkStatus {
  PENDING
  MARKED
  ABSENT
  EXEMPT
}

// One per ExamScheduleEntry (get-or-create, concurrency-safe via the unique FK).
// Owns the Draft → Submitted → Verified lifecycle; individual ExamMark rows carry
// no submission state of their own (locking is at the sheet, not the row).
model ExamMarkSheet {
  id                  String              @id @default(cuid())
  tenantId            String
  schoolId            String
  academicSessionId   String
  examScheduleEntryId String              @unique
  status              ExamMarkSheetStatus @default(DRAFT)

  submittedByUserId String?
  submittedByName   String?
  submittedAt       DateTime? @db.Timestamptz(6)
  verifiedByUserId  String?
  verifiedByName    String?
  verifiedAt        DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  scheduleEntry ExamScheduleEntry @relation(fields: [examScheduleEntryId], references: [id], onDelete: Cascade)
  marks         ExamMark[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("exam_mark_sheets")
}

// One row per (markSheet, student) — at most one mark for a student on a given
// paper (@@unique). status is explicit: ABSENT/EXEMPT are NOT zero marks; the
// numeric fields stay null for those and for PENDING (never entered). Marks
// limits are validated against the parent ExamScheduleEntry's SNAPSHOTTED
// values, never live Subject data (Phase 8A historical-stability guarantee
// extends here). studentId uses onDelete: Restrict — a student with recorded
// marks can never be hard-deleted out from under its history; enrollmentId is
// a soft historical reference only (SetNull) since a later unenrollment must
// never destroy an already-recorded mark.
model ExamMark {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  markSheetId       String
  studentId         String
  enrollmentId      String?

  status         ExamMarkStatus @default(PENDING)
  theoryMarks    Int?
  practicalMarks Int?
  marksObtained  Int?
  remarks        String?

  enteredByUserId String?
  enteredByName   String?
  enteredAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  markSheet  ExamMarkSheet @relation(fields: [markSheetId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // No duplicate mark row for the same student on the same paper.
  @@unique([markSheetId, studentId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId])
  @@index([enrollmentId])
  @@map("exam_marks")
}

// ===========================================================================
// Phase 8C — Results & Grading. Deliberately NOT modelled: rank (no ranking
// policy exists yet — deferred), GPA/CGPA (no grade-point policy exists),
// grace marks / attendance-eligibility / max-failed-subjects / min-overall-
// percent (all mock-only invented policy with zero real backing). V1 pass/fail
// policy (documented in lib/server/results/engine.ts): a student PASSes an
// exam when every non-exempt paper PASSes; FAILs if any non-exempt paper
// FAILs or is ABSENT; is ABSENT overall only if EVERY non-exempt paper is
// ABSENT; is INCOMPLETE if any required paper has no VERIFIED mark yet.
//
// GradingScheme is School + AcademicSession scoped (not per-Class, not
// per-Exam) — Exam.gradingSchemeId picks ONE explicit scheme per exam rather
// than duplicating bands per exam or silently auto-resolving by class.
//
// Results are DERIVED, never a second editable marks store: the result engine
// only ever reads Exam → ExamScheduleEntry → ExamMarkSheet(VERIFIED) →
// ExamMark. Before publication, results are computed LIVE (a preview) and
// never persisted. At publication, ExamResultPublication + StudentExamResult
// freeze an immutable snapshot — including the exact grading bands used — so
// a later grading-scheme edit or Subject/Staff/Enrollment change can never
// alter a historical published result. Existence of the ExamResultPublication
// row itself IS the "published" state — no separate DRAFT publication row is
// ever created, since preview never persists anything.
// ===========================================================================

enum GradingSchemeStatus {
  ACTIVE
  ARCHIVED
}

model GradingScheme {
  id                String              @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  name              String
  status            GradingSchemeStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  bands GradingBand[]
  exams Exam[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("grading_schemes")
}

// A percentage band, e.g. "A1" 91-100. Non-overlap and full-range validity are
// enforced transactionally by the reconcile endpoint (lib/server/results/
// grading-service.ts) — never trusted from the client alone.
model GradingBand {
  id              String  @id @default(cuid())
  gradingSchemeId String
  label           String
  minPercent      Int
  maxPercent      Int
  isPass          Boolean @default(true)
  color           String  @default("#18b0c8")
  order           Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  scheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@index([gradingSchemeId])
  @@map("grading_bands")
}

enum ExamResultStatus {
  PASS
  FAIL
  ABSENT
}

// At most one publication per Exam (@@unique) — re-publishing is refused
// (RESULT_ALREADY_PUBLISHED); a correction workflow is explicitly deferred.
model ExamResultPublication {
  id                   String   @id @default(cuid())
  tenantId             String
  schoolId             String
  academicSessionId    String
  examId               String   @unique
  gradingSchemeId      String
  gradingSchemeName    String // frozen name — a later scheme rename must not alter the historical record either
  gradingBandsSnapshot Json // frozen bands used at publish time — immutable even if the scheme is edited later
  studentCount         Int
  publishedByUserId    String
  publishedByName      String?
  publishedAt          DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  exam    Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  results StudentExamResult[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("exam_result_publications")
}

// A read-only historical snapshot — never exposes a PATCH path. Marks continue
// to live only in ExamMark; this is purely the frozen publication output.
model StudentExamResult {
  id                 String           @id @default(cuid())
  publicationId      String
  studentId          String
  enrollmentId       String?
  totalMaxMarks      Int
  totalMarksObtained Int
  percentage         Int
  grade              String?
  status             ExamResultStatus
  subjectResults     Json // array of per-paper breakdowns — see ExamSubjectResultDto in lib/api/contracts.ts

  // Phase 8D — Report Cards. The class/section context of the EXAM SCHEDULE at
  // publish time (from ExamScheduleEntry.sectionId, not live Enrollment), frozen
  // as plain scalars (no FK) so a later Class/Section rename, archive, or the
  // student's own Enrollment changing section/withdrawing can never alter a
  // published report card's historical class/section display. Null only for the
  // rare student with zero schedule entries at publish time.
  classId     String?
  className   String?
  sectionId   String?
  sectionName String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  publication ExamResultPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  student     Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment  Enrollment?           @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([publicationId, studentId])
  @@index([publicationId])
  @@index([studentId])
  @@map("student_exam_results")
}

// ===========================================================================
// Phase 8E — Promotion / Academic-Year Transition.
//
// A StudentPromotion row is the explicit, auditable, ADMINISTRATIVE decision
// that a student moves from one AcademicSession to the next — never an
// automatic consequence of an exam result. Its existence for a given
// (studentId, fromAcademicSessionId, toAcademicSessionId) IS the decision: a
// row only gets created once PROMOTED or RETAINED is finalized (there is no
// persisted PENDING state — "pending" is simply the absence of a row for that
// transition, computed by the service layer from real candidate data).
//
// sourceExamId / sourcePublicationId / sourceStudentResultId are plain
// snapshot scalars (no FK), matching the ExamResultPublication.gradingSchemeName
// snapshot convention — the evidence a decision was based on must stay stable
// even if unrelated cleanup ever touches those rows, and Promotion must never
// be the reason a historical Exam/Publication/Result can't be modified.
// student/fromEnrollment/newEnrollment/targetClass/targetSection ARE real FKs
// (Restrict): once referenced by a promotion decision, none of these rows may
// be silently deleted out from under it.
// ===========================================================================

enum PromotionDecision {
  PROMOTED
  RETAINED
}

model StudentPromotion {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  fromAcademicSessionId String
  toAcademicSessionId   String

  studentId String

  fromEnrollmentId String
  newEnrollmentId  String @unique // 1:1 — the Enrollment this decision created

  // Snapshot references to the evidence this decision was based on — plain
  // scalars, deliberately NOT FKs (see note above).
  sourceExamId          String
  sourcePublicationId   String
  sourceStudentResultId String

  decision PromotionDecision

  targetClassId   String
  targetSectionId String

  processedByUserId String
  processedByName   String?
  processedAt       DateTime @default(now()) @db.Timestamptz(6)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student        Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fromEnrollment Enrollment @relation("PromotionFromEnrollment", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  newEnrollment  Enrollment @relation("PromotionNewEnrollment", fields: [newEnrollmentId], references: [id], onDelete: Restrict)
  targetClass    Class      @relation(fields: [targetClassId], references: [id], onDelete: Restrict)
  targetSection  Section    @relation(fields: [targetSectionId], references: [id], onDelete: Restrict)

  // One decision per student per (from session -> to session) transition —
  // the concurrency-safety backstop alongside the transactional section-
  // capacity lock (see lib/server/promotion/service.ts).
  @@unique([studentId, fromAcademicSessionId, toAcademicSessionId])
  @@index([tenantId])
  @@index([schoolId, fromAcademicSessionId, toAcademicSessionId])
  @@index([studentId])
  @@index([targetClassId])
  @@index([targetSectionId])
  @@map("student_promotions")
}

// ===========================================================================
// Phase 9B — Homework / Assignments. One Homework targets exactly ONE real
// Section (Preferred V1 per the phase spec — no multi-section targeting, no
// per-student rows); students see it through real Enrollment(status=ENROLLED)
// in that section, never a duplicated per-student assignment row. Submissions/
// grading/attachments/parent-acknowledgement are deliberately NOT built here —
// no real student self-context or file-storage layer exists yet, and the
// phase spec explicitly excludes parent acknowledgement — so scoring/
// submissionType fields from the old mock are dropped, not carried forward.
//
// Authorship is a REAL Staff row with a REAL TeachingAssignment for
// (sectionId, subjectId) — teachingAssignmentId is Restrict (mirrors
// TimetableEntry's exact pattern) so removing that assignment while homework
// still references it fails closed instead of orphaning history.
// ===========================================================================

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Homework {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  sectionId            String
  subjectId            String
  staffId              String
  teachingAssignmentId String

  title        String
  description  String
  instructions String?

  dueAt  DateTime       @db.Date
  status HomeworkStatus @default(DRAFT)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section            Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff              Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([staffId])
  @@index([status])
  @@map("homework")
}

// ===========================================================================
// Phase 9C.1 — Curriculum / Syllabus Tracking. Content (Curriculum -> Unit ->
// Chapter -> Topic) is authored once per (Class, Subject, AcademicSession) —
// mirrors the existing mock UI's 3-level Unit/Chapter/Topic hierarchy
// (lib/types/academics.ts's CurriculumUnit/CurriculumChapter/CurriculumTopic).
// Progress is tracked separately, per Section (different sections of the same
// class progress at different speeds) via CurriculumTopicProgress — never a
// persisted percentage; always derived from real topic-progress rows. Unit/
// Chapter/Topic carry NO status column of their own — their displayed
// "status" is always computed from descendant CurriculumTopicProgress rows
// for whichever Section is in view (lib/server/curriculum/service.ts).
// ===========================================================================

enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TopicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Curriculum {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String

  classId   String
  subjectId String

  title       String
  description String?
  status      CurriculumStatus @default(DRAFT)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class   Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  units   CurriculumUnit[]

  // One curriculum per (class, subject) within a session — the real
  // ClassSubject applicability this must be validated against at creation.
  @@unique([schoolId, academicSessionId, classId, subjectId])
  @@index([tenantId])
  @@index([classId])
  @@index([subjectId])
  @@map("curricula")
}

model CurriculumUnit {
  id           String @id @default(cuid())
  curriculumId String

  title            String
  description      String?
  order            Int       @default(0)
  plannedStart     DateTime? @db.Date
  plannedEnd       DateTime? @db.Date
  estimatedPeriods Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  curriculum Curriculum          @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  chapters   CurriculumChapter[]

  @@index([curriculumId])
  @@map("curriculum_units")
}

model CurriculumChapter {
  id     String @id @default(cuid())
  unitId String

  title String
  order Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  unit   CurriculumUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topics CurriculumTopic[]

  @@index([unitId])
  @@map("curriculum_chapters")
}

model CurriculumTopic {
  id        String @id @default(cuid())
  chapterId String

  title            String
  order            Int      @default(0)
  learningOutcomes String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  chapter          CurriculumChapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress         CurriculumTopicProgress[]
  lessonPlanTopics LessonPlanTopic[] // Phase 9C.2 — lesson-plan syllabus mapping

  @@index([chapterId])
  @@map("curriculum_topics")
}

model CurriculumTopicProgress {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  sectionId String
  topicId   String

  status             TopicProgressStatus @default(NOT_STARTED)
  completedAt        DateTime?           @db.Timestamptz(6)
  completedByStaffId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section          Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic            CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  completedByStaff Staff?          @relation(fields: [completedByStaffId], references: [id], onDelete: SetNull)

  // One progress row per (section, topic) — upserted, never duplicated.
  @@unique([sectionId, topicId])
  @@index([tenantId])
  @@index([sectionId])
  @@index([topicId])
  @@map("curriculum_topic_progress")
}

// ===========================================================================
// Phase 9C.2 — Lesson Plans. A real teaching plan for one Staff teacher's
// TeachingAssignment on one date, optionally mapped to real CurriculumTopic
// row(s) via LessonPlanTopic (never free-floating topic names). Preserves the
// existing mock UI's draft -> submitted -> approved/rejected -> completed
// review workflow (lib/types/academics.ts's LessonPlanStatus / the real
// Academic-Coordinator approve/reject buttons already in app/academics/
// lesson-plans/page.tsx) — collapsed to the minimal real states that UI
// actually drives.
// ===========================================================================

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

model LessonPlan {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  sectionId            String
  subjectId            String
  staffId              String
  teachingAssignmentId String

  title             String
  learningObjective String
  teachingMethod    String
  materials         String?
  activity          String?
  homeworkNote      String?
  assessmentMethod  String?

  plannedDate DateTime         @db.Date
  period      Int?
  status      LessonPlanStatus @default(DRAFT)

  reviewedByUserId String?
  reviewedByName   String?
  reviewComment    String?

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section            Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff              Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  topics             LessonPlanTopic[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([staffId])
  @@index([status])
  @@index([plannedDate])
  @@map("lesson_plans")
}

model LessonPlanTopic {
  lessonPlanId String
  topicId      String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  lessonPlan LessonPlan      @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  topic      CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([lessonPlanId, topicId])
  @@index([topicId])
  @@map("lesson_plan_topics")
}

// ===========================================================================
// Phase 9D.1 — Academic Calendar. ONLY manual, school-authored events are
// persisted here (CalendarEvent). Exam/Homework/LessonPlan calendar items are
// NEVER copied into this table — they are computed at query time from their
// own real tables (lib/server/calendar/service.ts) and identified by
// (sourceType, sourceId) rather than a CalendarEvent row, so there is exactly
// one truth for e.g. a Homework due date and the calendar can never drift
// from it. Audience is staff-only (ALL_STAFF/TEACHERS) — Student/Guardian
// have no linked User account in this system (see Notification section
// below), so there is no real identity to resolve a wider audience against.
// ===========================================================================

enum CalendarEventType {
  HOLIDAY
  MEETING
  PTM
  CELEBRATION
  ACTIVITY
  DEADLINE
  OTHER
}

enum CalendarEventAudience {
  ALL_STAFF
  TEACHERS
}

enum CalendarRecurrence {
  NONE
  WEEKLY
  YEARLY
}

enum CalendarEventStatus {
  ACTIVE
  CANCELLED
}

model CalendarEvent {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String?
  academicSessionId String

  title       String
  description String?
  eventType   CalendarEventType
  audience    CalendarEventAudience @default(ALL_STAFF)

  startDate DateTime @db.Date
  endDate   DateTime? @db.Date
  allDay    Boolean  @default(true)

  recurrence      CalendarRecurrence @default(NONE)
  recurrenceUntil DateTime?          @db.Date

  location String?
  status   CalendarEventStatus @default(ACTIVE)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, academicSessionId, startDate])
  @@index([status])
  @@map("calendar_events")
}

// ===========================================================================
// Phase 9D.2 — In-app Notifications (V1: in-app only — no email/SMS/push).
// One Notification row per logical event (dedupeKey unique — see
// lib/server/notifications/service.ts's doc comment for the exact dedupe
// design), fanned out to real recipients via NotificationRecipient. Read
// state is per-recipient (never a single shared isRead flag). Recipients are
// always real User rows — Student/Guardian have no linked User account yet,
// so this system can only ever reach Staff with a linked User (Staff.userId)
// or other real platform users. sourceType/sourceId are plain snapshot
// strings, not FKs, so a Notification's history survives its source domain
// row being archived/deleted later (Restrict/Cascade FK entanglement across
// five+ unrelated domains would be unnecessary and fragile).
// ===========================================================================

enum NotificationType {
  LESSON_PLAN_APPROVED
  LESSON_PLAN_REJECTED
  EXAM_SCHEDULED
  CALENDAR_EVENT
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
}

model Notification {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  type  NotificationType
  title String
  body  String

  sourceType String?
  sourceId   String?
  href       String?

  // Stable per logical event (e.g. "LESSON_PLAN_APPROVED:<auditEventId>") —
  // the real retry/concurrency guarantee. See service doc comment.
  dedupeKey String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  recipients NotificationRecipient[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String @id @default(cuid())
  notificationId String
  userId         String

  readAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification_recipients")
}

// ===========================================================================
// Phase 9E.1 — Staff Attendance. A separate domain from student AttendanceSession/
// AttendanceRecord (Phase 5/7C) — different entity (Staff, not Student), different
// grain (one row per staff per day, no periods/sections), no shared table. A
// missing StaffAttendanceRecord for a given staff+date is NOT_MARKED — never
// synthesized as ABSENT by a query. ON_LEAVE is set by the leave-approval flow
// (see LeaveRequest below) as the one honest crossover between the two domains;
// StaffAttendanceRecord otherwise never duplicates leave-request state.
// ===========================================================================

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

model StaffAttendanceRecord {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  staffId String
  date    DateTime @db.Date

  status     StaffAttendanceStatus
  checkInAt  DateTime? @db.Timestamptz(6)
  checkOutAt DateTime? @db.Timestamptz(6)
  notes      String?

  markedByUserId String
  markedByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // One attendance record per staff member per day — upserted, never duplicated.
  @@unique([staffId, date])
  @@index([tenantId])
  @@index([schoolId, branchId, date])
  @@index([staffId, date])
  @@map("staff_attendance_records")
}

// ===========================================================================
// Phase 9E.2 — Leave Management. LeaveRequest is the sole authority for staff
// leave; StaffAttendanceRecord.ON_LEAVE (above) is written FROM an approval
// here, never the reverse. Real Staff FK only — no free-floating name/email
// identity. Overlap prevention and the PENDING->APPROVED/REJECTED/CANCELLED
// lifecycle are enforced in lib/server/leave/service.ts (row-lock + conditional
// updateMany), not by a DB constraint Postgres can't express without extensions.
// ===========================================================================

enum LeaveTypeStatus {
  ACTIVE
  INACTIVE
}

model LeaveType {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  name        String
  code        String
  description String?
  isPaid      Boolean         @default(true)
  status      LeaveTypeStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  requests LeaveRequest[]

  // One leave-type code per school.
  @@unique([schoolId, code])
  @@index([tenantId])
  @@map("leave_types")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  staffId     String
  leaveTypeId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  halfDay   Boolean  @default(false)
  reason    String

  status LeaveRequestStatus @default(PENDING)

  requestedByUserId String
  requestedAt       DateTime @default(now()) @db.Timestamptz(6)

  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime? @db.Timestamptz(6)
  reviewNote       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId, branchId])
  @@index([staffId, status])
  @@index([staffId, startDate, endDate])
  @@index([status])
  @@map("leave_requests")
}

// ===========================================================================
// Phase 9F — Fees & Collections. Money is Prisma Decimal(12,2) end to end
// (never a JS float, matching the Super Admin billing domain's Invoice/
// Payment precedent) — arithmetic happens with Prisma.Decimal.plus/minus in
// the service layer, and every DTO serializes to a plain number only at the
// API boundary. `currency` is a per-row ISO-4217 snapshot defaulting to the
// school's own currency (same pattern as Invoice/Subscription).
//
// SCOPE: this is a deliberately smaller, flatter model than a full ERP fee
// engine. One FeeStructureItem already carries its own dueDate, so it is
// simultaneously "the fee type" and "the installment" — there is no separate
// component/installment split, no tax/proration/versioning layer. Discount,
// Scholarship and Late Fee all reduce/increase a FeeCharge through the SAME
// FeeAdjustment table (kind discriminates them) — one canonical balance
// formula, never three parallel ones. See lib/server/fees/service.ts's doc
// comment for the exact formula and for what was deliberately deferred
// (credit balances/advance payment, reminder automation, payment gateways,
// bank-feed reconciliation) and why.
//
// HISTORICAL SAFETY: FeeCharge snapshots categoryName/itemName/amount/dueDate
// at assignment time — renaming/archiving a FeeCategory or editing a
// FeeStructureItem later never rewrites an already-billed student's history.
// FeeCharge is scoped by studentId + academicSessionId (not by Enrollment),
// so a later class/section transfer never touches it either.
// ===========================================================================

enum FeeCategoryStatus {
  ACTIVE
  ARCHIVED
}

model FeeCategory {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  name        String
  code        String
  description String?
  status      FeeCategoryStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items FeeStructureItem[]

  // One category code per school. Archival (not delete) is the only lifecycle —
  // historical FeeStructureItem/FeeCharge snapshots survive either way.
  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("fee_categories")
}

enum FeeStructureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model FeeStructure {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  name        String
  description String?
  currency    String             @default("INR")
  status      FeeStructureStatus @default(DRAFT)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items       FeeStructureItem[]
  classes     FeeStructureClass[]
  assignments StudentFeeAssignment[]

  @@unique([schoolId, academicSessionId, name])
  @@index([tenantId])
  @@index([schoolId, academicSessionId, status])
  @@map("fee_structures")
}

/** Real Class targeting — never a class name/label. Empty (no rows) is not a
 * valid state for an ACTIVE structure; the service requires at least one. */
model FeeStructureClass {
  id             String @id @default(cuid())
  feeStructureId String
  classId        String

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([feeStructureId, classId])
  @@index([classId])
  @@map("fee_structure_classes")
}

model FeeStructureItem {
  id             String @id @default(cuid())
  feeStructureId String
  categoryId     String

  name    String?
  amount  Decimal  @db.Decimal(12, 2)
  dueDate DateTime @db.Date
  order   Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  category     FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  charges      FeeCharge[]

  @@index([feeStructureId])
  @@index([categoryId])
  @@map("fee_structure_items")
}

enum FeeAssignmentStatus {
  ACTIVE
  WITHDRAWN
}

/** The billing act itself — links one real Student to one real FeeStructure
 * for its session. Generates one FeeCharge per FeeStructureItem (idempotent —
 * see the unique constraint on FeeCharge below). enrollmentId is the real
 * Enrollment the assignment was resolved against when targeting a class/
 * section in bulk (optional: an individual assignment may not go through a
 * section-bulk flow), kept for traceability only — never re-validated after
 * the fact, since a later transfer must not retroactively invalidate history. */
model StudentFeeAssignment {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  studentId      String
  enrollmentId   String?
  feeStructureId String

  status FeeAssignmentStatus @default(ACTIVE)

  assignedByUserId String
  assignedByName   String?
  assignedAt       DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  charges      FeeCharge[]

  // Idempotent bulk assignment: re-running the same structure+student is a
  // no-op, never a duplicate.
  @@unique([studentId, feeStructureId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId])
  @@map("student_fee_assignments")
}

/** The finest-grained billable unit — real Student, real snapshot amount/
 * dueDate/category name (never re-read live from FeeCategory/FeeStructureItem,
 * so an edit or archive there can never rewrite an already-billed student's
 * history). No persisted balance/status column — see
 * lib/server/fees/service.ts's chargeBalance() for the single canonical
 * derivation from amount + adjustments + allocations. */
model FeeCharge {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  assignmentId       String
  studentId          String
  feeStructureItemId String?

  categoryName String
  itemName     String?
  amount       Decimal  @db.Decimal(12, 2)
  dueDate      DateTime @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  assignment       StudentFeeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureItem FeeStructureItem?    @relation(fields: [feeStructureItemId], references: [id], onDelete: SetNull)
  adjustments      FeeAdjustment[]
  allocations      FeePaymentAllocation[]

  // One charge per structure item per assignment — the idempotency guarantee
  // for bulk assignment.
  @@unique([assignmentId, feeStructureItemId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId, dueDate])
  @@map("fee_charges")
}

enum FeeAdjustmentKind {
  DISCOUNT
  SCHOLARSHIP
  LATE_FEE
}

enum FeeAdjustmentAmountType {
  FIXED
  PERCENTAGE
}

/** The ONE canonical adjustment engine for discounts, scholarships and late
 * fees — `kind` discriminates the business concept (and its sign: DISCOUNT/
 * SCHOLARSHIP reduce the balance, LATE_FEE increases it — see chargeBalance()),
 * `computedAmount` is the resolved absolute amount snapshotted at apply time
 * (so a later change to `value`/amountType is impossible — there is no
 * update endpoint, only apply). Never silently mutates FeeCharge.amount. */
model FeeAdjustment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  chargeId String
  kind     FeeAdjustmentKind

  amountType     FeeAdjustmentAmountType
  value          Decimal @db.Decimal(12, 2) // the fixed amount, or the percentage number (e.g. 10 for 10%)
  computedAmount Decimal @db.Decimal(12, 2) // resolved absolute amount at apply time

  reason String

  appliedByUserId String
  appliedByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  charge FeeCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([chargeId])
  @@index([schoolId, kind])
  @@map("fee_adjustments")
}

enum FeePaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum FeeReconciliationStatus {
  UNRECONCILED
  RECONCILED
  MISMATCH
}

/** A real collection event. receiptNumber IS the receipt — there is no
 * separate Receipt model (a payment always has exactly one, immutable). All
 * non-CASH methods here are manually RECORDED (no gateway ever touches this
 * row) — see the service doc comment. */
model FeePayment {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  studentId String

  receiptNumber String   @unique
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  method        FeePaymentMethod
  paymentDate   DateTime @db.Date

  reference    String?
  chequeNumber String?
  chequeDate   DateTime? @db.Date
  bankName     String?
  notes        String?

  receivedByUserId String
  receivedByName   String?

  reconciliationStatus FeeReconciliationStatus @default(UNRECONCILED)
  reconciledByUserId   String?
  reconciledByName     String?
  reconciledAt         DateTime?                @db.Timestamptz(6)
  reconciliationNote   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations FeePaymentAllocation[]
  refunds     FeeRefund[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId])
  @@index([schoolId, paymentDate])
  @@index([reconciliationStatus])
  @@map("fee_payments")
}

/** Connects a payment to the real charge(s) it settles — a payment may cover
 * multiple charges, and a charge may be settled across multiple payments
 * (partial payments). */
model FeePaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  chargeId  String

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  FeeCharge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("fee_payment_allocations")
}

model FeeRefund {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  paymentId String
  amount    Decimal @db.Decimal(12, 2)
  reason    String

  refundedByUserId String
  refundedByName   String?
  refundedAt       DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([paymentId])
  @@map("fee_refunds")
}

/** Race-safe, school-scoped receipt sequence. `UPDATE ... SET counter =
 * counter + 1 RETURNING counter` is atomic in Postgres — no separate row
 * lock needed, unlike the balance-mutation transactions elsewhere in this
 * domain. */
model FeeReceiptCounter {
  schoolId String @id
  counter  Int    @default(0)

  @@map("fee_receipt_counters")
}

// ===========================================================================
// Phase 9G — Accounting / General Ledger. Conventional double-entry: every
// AccountingAccount has a type (ASSET/LIABILITY/EQUITY/INCOME/EXPENSE);
// every JournalEntry carries >=2 JournalLine rows whose debits equal credits
// once POSTED (enforced server-side in lib/server/accounting/journals.ts,
// never trusted from the client). Posted entries are immutable — a
// correction is always a new reversal entry with every line's debit/credit
// swapped, never an edit.
//
// ACCOUNTING BASIS: CASH basis. No Fee Receivable is recognized at charge/
// assignment time — Phase 9F's dues/outstanding tracking is an operational
// AR sub-ledger, not a formal accounting receivable, and inventing accrual
// recognition here would silently diverge from how the product already
// behaves. A journal is posted only at the two real cash-moving Fee events:
// FeePayment and FeeRefund. Discount/Scholarship/LateFee still get their own
// traceable ledger lines (not silently netted in a report) by prorating each
// payment's amount across its settled charge(s)' own gross/discount/
// scholarship/lateFee composition at that moment — see
// lib/server/accounting/fee-posting.ts's doc comment for the exact formula.
// A charge that is never paid (e.g. a 100% waiver) therefore never produces
// an accounting entry — a known, documented cash-basis limitation.
//
// FEES REMAIN AUTHORITATIVE: this domain never re-implements or overrides
// FeePayment/FeeAdjustment/FeeRefund/reconciliation — it only records their
// accounting EFFECT, via a real sourceType+sourceId+sourceEventId trail.
// Automatic posting is idempotent: sourceEventId is DB-unique per school, so
// two concurrent attempts to post the same Fee event can never create two
// journals (the loser's insert fails the constraint and is treated as
// already-posted, not an error).
// ===========================================================================

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountingAccountStatus {
  ACTIVE
  ARCHIVED
}

/** systemKey identifies an account a real posting rule depends on (e.g. the
 * generic cash-receipt account) — stable and never matched by name. Nullable
 * (Postgres allows multiple NULLs under a unique index) since most accounts
 * are ordinary user-created ledger accounts with no system role. */
model AccountingAccount {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String?

  code        String
  name        String
  type        AccountingAccountType
  parentId    String?
  description String?
  status      AccountingAccountStatus @default(ACTIVE)
  systemKey   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  parent   AccountingAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AccountingAccount[] @relation("AccountHierarchy")
  lines    JournalLine[]

  // One code per school; systemKey (when set) is also unique per school.
  @@unique([schoolId, code])
  @@unique([schoolId, systemKey])
  @@index([tenantId])
  @@index([schoolId, type, status])
  @@map("accounting_accounts")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSourceType {
  MANUAL
  FEE_PAYMENT
  FEE_REFUND
  PAYROLL_PAYMENT
}

/** One accounting transaction. `sourceEventId` (school-unique when set) is
 * the idempotency key for automatic Fee postings — see the domain doc
 * comment above. `reversalOfId` is DB-unique so a given entry can be
 * reversed at most once, even under a concurrent double-click. */
model JournalEntry {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String?

  entryNumber String
  entryDate   DateTime @db.Date
  description String
  status      JournalEntryStatus @default(POSTED)

  sourceType    JournalSourceType
  sourceId      String?
  sourceEventId String?

  reversalOfId String?

  createdByUserId String
  createdByName   String?
  postedAt        DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lines      JournalLine[]
  reversalOf JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry[] @relation("Reversal")

  @@unique([schoolId, entryNumber])
  @@unique([schoolId, sourceEventId])
  @@unique([reversalOfId])
  @@index([tenantId])
  @@index([schoolId, entryDate])
  @@index([schoolId, sourceType, sourceId])
  @@index([status])
  @@map("journal_entries")
}

/** A line can never have both debit and credit > 0, nor both zero — enforced
 * in lib/server/accounting/journals.ts (a DB CHECK is not expressible for
 * "exactly one of two Decimal columns is positive" without a raw migration
 * addition, so the invariant is enforced at the single write path instead —
 * there is no other way to create a JournalLine). */
model JournalLine {
  id             String @id @default(cuid())
  journalEntryId String
  accountId      String

  debit  Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2)

  description String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  journalEntry JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

/** Race-safe, school-scoped journal-entry sequence — same atomic
 * `UPDATE ... RETURNING` strategy as FeeReceiptCounter. */
model AccountingEntryCounter {
  schoolId String @id
  counter  Int    @default(0)

  @@map("accounting_entry_counters")
}

// ===========================================================================
// Phase 9H — Payroll. Uses the REAL Staff model (Phase 6A) as the sole
// employee identity — no second Employee/HR model. Uses the REAL
// StaffAttendanceRecord (9E.1) and LeaveRequest (9E.2) as DISPLAY-ONLY
// context on a payroll snapshot — neither ever changes a calculated amount.
// Posts to the REAL Phase 9G JournalEntry/JournalLine ledger — no parallel
// accounting engine.
//
// PAYROLL V1 POLICY (deliberately minimal — see the Phase 9H final report for
// the full audit):
//   - Monthly frequency. One PayrollRun per (schoolId, branchId, year, month),
//     DB-unique.
//   - Salary is a FIXED reusable SalaryStructure (EARNING/DEDUCTION
//     components, FIXED or PERCENTAGE-of-another-component-in-the-same-
//     structure) assigned to a Staff via an effective-dated
//     StaffSalaryAssignment. grossEarnings = sum(EARNING), totalDeductions =
//     sum(DEDUCTION), netPay = grossEarnings - totalDeductions. No
//     attendance- or leave-based deduction: this repo has no working-day-
//     calendar / per-day-rate / LOP-conversion policy, so attendance and
//     leave are captured on PayrollRunItem purely as informational summary
//     counts (never read by the calculation). Manual per-run adjustments
//     (bonus/allowance/deduction/reimbursement) are plain flat-amount
//     PayrollRunItemComponent rows with source=MANUAL — never a computed
//     rule.
//   - Lifecycle: DRAFT -> CALCULATED -> FINALIZED -> PAID. Calculating
//     replaces this run's PayrollRunItem/PayrollRunItemComponent rows
//     (idempotent) until FINALIZED; a FINALIZED run's snapshot is immutable
//     — corrections are a new run or a reversal journal, never an edit.
//     Finalize/pay use a `SELECT ... FOR UPDATE` lock on the PayrollRun row
//     (same pattern as Phase 9E's leave-overlap check and Phase 8E's
//     promotion capacity lock) so two concurrent transitions can never both
//     succeed.
//   - Payment is RECORDING only (PayrollPayment), never a real bank
//     transfer — one PayrollPayment per PayrollRun (@@unique), whole-run
//     payment only, no partial disbursement in V1.
//   - Accounting recognition point mirrors Fees' CASH basis: a JournalEntry
//     posts only when a PayrollPayment is recorded (never merely on
//     finalize) — Debit PAYROLL_EXPENSE, Credit the existing Phase 9G BANK
//     system account (no duplicate clearing account invented). Idempotent
//     via the same sourceEventId ("PAYROLL_PAYMENT:<id>") uniqueness Fees
//     uses.
//   - Explicitly DEFERRED, not invented: PF/ESI/TDS/Professional Tax/
//     gratuity/overtime, loans/advances, attendance- or leave-based salary
//     deduction, department/designation-grouped reports (Staff.department/
//     designation are free-text, not a real dimension entity), payslip
//     PAN/UAN/ESI/bank-account fields, PDF generation (browser print only).
// ===========================================================================

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum SalaryComponentCalcType {
  FIXED
  PERCENTAGE
}

enum SalaryComponentStatus {
  ACTIVE
  ARCHIVED
}

/** A reusable earning/deduction line definition. Archived components remain
 * readable (never deleted) so historical PayrollRunItemComponent snapshots
 * that reference one stay resolvable. */
model SalaryComponent {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  code        String
  name        String
  type        SalaryComponentType
  calcType    SalaryComponentCalcType
  description String?
  status      SalaryComponentStatus  @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  structureLines SalaryStructureComponent[]
  payrollLines   PayrollRunItemComponent[]

  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("salary_components")
}

enum SalaryStructureStatus {
  ACTIVE
  ARCHIVED
}

/** A reusable named bundle of components. Structural edits (component list)
 * are only allowed while it has zero StaffSalaryAssignment rows — once
 * assigned, it is financially live and only name/description/status remain
 * editable (mirrors lib/server/fees/structures.ts's FeeStructure exactly). */
model SalaryStructure {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  name        String
  description String?
  status      SalaryStructureStatus @default(ACTIVE)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  components  SalaryStructureComponent[]
  assignments StaffSalaryAssignment[]

  @@unique([schoolId, name])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("salary_structures")
}

/** One component line within a structure. Exactly one of `amount` /
 * (`percent` + `percentOfComponentId`) is set, matching calcType — enforced
 * in lib/server/payroll/structures.ts, not expressible as a DB CHECK across
 * a self-referencing FK. `percentOfComponentId` must reference another line
 * in the SAME structure. */
model SalaryStructureComponent {
  id                String  @id @default(cuid())
  salaryStructureId String
  salaryComponentId String
  amount            Decimal? @db.Decimal(12, 2)
  percent           Decimal? @db.Decimal(5, 2)
  percentOfLineId   String?
  order             Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  salaryStructure SalaryStructure  @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent  @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)
  percentOfLine   SalaryStructureComponent?  @relation("PercentBase", fields: [percentOfLineId], references: [id], onDelete: SetNull)
  percentBasisFor SalaryStructureComponent[] @relation("PercentBase")

  // One line per component per structure — never duplicated.
  @@unique([salaryStructureId, salaryComponentId])
  @@index([salaryStructureId])
  @@map("salary_structure_components")
}

/** Effective-dated assignment of a real Staff to a real SalaryStructure. A
 * salary change is always a NEW row (effectiveTo set on the old one) — never
 * a mutation of history. Overlap prevention is enforced in
 * lib/server/payroll/assignments.ts via a `SELECT ... FOR UPDATE` lock on the
 * Staff row (same pattern as Phase 9E's leave-overlap check), not a DB
 * constraint Postgres can't express without extensions. */
model StaffSalaryAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  staffId           String
  salaryStructureId String

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  staff           Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([staffId, effectiveFrom])
  @@index([schoolId, branchId])
  @@map("staff_salary_assignments")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  FINALIZED
  PAID
}

/** One payroll period for one branch. `year`/`month` are the period identity
 * (never derived from createdAt). FINALIZED is the immutability boundary —
 * see the section doc comment above for the full lifecycle/concurrency
 * rationale. */
model PayrollRun {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  year  Int
  month Int // 1-12

  status PayrollRunStatus @default(DRAFT)

  totalGross      Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  totalNet        Decimal @default(0) @db.Decimal(14, 2)

  createdByUserId String
  createdByName   String?
  calculatedAt    DateTime? @db.Timestamptz(6)
  finalizedAt     DateTime? @db.Timestamptz(6)
  finalizedByName String?
  paidAt          DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items   PayrollRunItem[]
  payment PayrollPayment?

  // One run per branch per period — never duplicated.
  @@unique([schoolId, branchId, year, month])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("payroll_runs")
}

/** One immutable-once-FINALIZED payroll snapshot per Staff per run. Staff
 * name/code and structure name are captured here as historical DISPLAY
 * snapshots (real staffId/salaryStructureId FKs remain the relationship
 * authority) so a later Staff rename or structure edit can never alter a
 * generated payslip. Attendance/leave counts are informational only —
 * NEVER an input to grossEarnings/totalDeductions/netPay. */
model PayrollRunItem {
  id           String @id @default(cuid())
  payrollRunId String

  staffId             String
  employeeCode         String
  staffName            String
  salaryStructureId    String?
  salaryStructureName  String?

  grossEarnings   Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netPay          Decimal @db.Decimal(12, 2)

  // Informational attendance/leave summary for the run's period — display only.
  presentDays   Int @default(0)
  absentDays    Int @default(0)
  lateDays      Int @default(0)
  halfDays      Int @default(0)
  onLeaveDays   Int @default(0)
  notMarkedDays Int @default(0)
  paidLeaveDays   Int @default(0)
  unpaidLeaveDays Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  payrollRun PayrollRun                 @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      Staff                      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  components PayrollRunItemComponent[]

  // One snapshot per staff per run — recalculation replaces, never duplicates.
  @@unique([payrollRunId, staffId])
  @@index([staffId])
  @@map("payroll_run_items")
}

enum PayrollComponentSource {
  STRUCTURE
  MANUAL
}

/** One frozen component line within a PayrollRunItem snapshot. `componentId`
 * is kept for traceability but componentName/type are snapshotted so a later
 * SalaryComponent rename never rewrites a finalized payslip line. */
model PayrollRunItemComponent {
  id               String @id @default(cuid())
  payrollRunItemId String

  componentId   String?
  componentName String
  type          SalaryComponentType
  amount        Decimal @db.Decimal(12, 2)

  source          PayrollComponentSource @default(STRUCTURE)
  manualReason    String?
  createdByUserId String?
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payrollRunItem PayrollRunItem   @relation(fields: [payrollRunItemId], references: [id], onDelete: Cascade)
  component      SalaryComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([payrollRunItemId])
  @@map("payroll_run_item_components")
}

enum PayrollPaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

/** Records that a FINALIZED run's total was paid — never initiates a real
 * bank transfer (no gateway/bank-feed integration exists). One row per run
 * (@@unique) — whole-run payment only; two concurrent attempts race on this
 * constraint, so exactly one can ever succeed. */
model PayrollPayment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  payrollRunId String @unique

  amount      Decimal               @db.Decimal(14, 2)
  paymentDate DateTime              @db.Date
  method      PayrollPaymentMethod
  reference   String?

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId, branchId])
  @@map("payroll_payments")
}
