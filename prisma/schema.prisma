// Novyra Campus OS — Phase 16 backend foundation schema.
//
// Scope: multi-tenancy, identity, membership, roles/permissions, access scope,
// platform-admin separation and an audit foundation ONLY. Business modules
// (students, fees, exams, transport, …) are NOT modelled here — they stay on
// the existing client mock layer until integrated module-by-module later.
//
// Conventions (see docs/backend-architecture.md):
//   - IDs: cuid() everywhere — non-sequential, URL-safe, no row-count leak.
//   - Timestamps: DateTime (UTC) with createdAt/updatedAt; date-only academic
//     values use @db.Date.
//   - Tenant-owned rows are always reachable from a Tenant; every query must be
//     tenant-scoped through the server context helpers.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

enum SchoolStatus {
  SETUP_PENDING
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

// Platform staff sit OUTSIDE tenant membership — see PlatformAdmin. Mirrors the
// frontend PlatformRole union in lib/types/saas.ts.
enum PlatformRole {
  PLATFORM_OWNER
  SUPER_ADMIN
  BILLING_ADMIN
  SUPPORT_ADMIN
  CUSTOMER_SUCCESS
  AUDITOR
}

enum PlatformAdminStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// Extensible access-scope shape. Phase 16 wires ALL_TENANT / SCHOOLS / BRANCHES
// / OWN; CLASSES / SECTIONS / SUBJECTS are reserved for later module phases.
enum AccessScopeType {
  ALL_TENANT
  SCHOOLS
  BRANCHES
  CLASSES
  SECTIONS
  SUBJECTS
  OWN
}

// ---------------------------------------------------------------------------
// Identity — Better Auth owns User/Session/Account/Verification. Extra User
// columns are nullable or defaulted so Better Auth's create path is unaffected.
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  // Foundation extensions (not managed by Better Auth core flows):
  phone         String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  // First-login / onboarding state (server-authoritative — never localStorage).
  // passwordSetupRequired is set for invited users who must choose a password
  // before any dashboard access. onboardingCompletedAt is stamped once the
  // pre-dashboard setup flow (profile + context selection) is finished; a null
  // value means the resolver must route the user through the remaining steps.
  passwordSetupRequired Boolean   @default(false)
  profileCompletedAt    DateTime?
  onboardingCompletedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   TenantMembership[]
  platformAdmin PlatformAdmin?
  activeContext UserActiveContext?
  auditEvents   AuditEvent[]       @relation("AuditActor")
}

// Last validated tenant/school/branch/session/role selection for a user. This
// is a server-persisted convenience so a returning user skips the selectors and
// lands on their dashboard — it is NOT an authorization source. Every value is
// re-validated against real membership by resolveContext() on each request; a
// stale or tampered row simply fails validation and re-triggers selection.
model UserActiveContext {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId          String?
  schoolId          String?
  branchId          String?
  academicSessionId String?
  activeRoleId      String?
  updatedAt         DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Platform Super Admin boundary: a user is platform staff IFF they have a row
// here. This is deliberately NOT a tenant role — platform access never flows
// through TenantMembership. See requirePlatformRole().
model PlatformAdmin {
  id        String              @id @default(cuid())
  userId    String              @unique
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole
  status    PlatformAdminStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ---------------------------------------------------------------------------
// Tenancy core: Tenant -> School -> Branch -> AcademicSession
// ---------------------------------------------------------------------------

model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  status     TenantStatus @default(TRIAL)
  timezone   String       @default("Asia/Kolkata")
  locale     String       @default("en-IN")
  currency   String       @default("INR")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  archivedAt DateTime?

  schools     School[]
  memberships TenantMembership[]
  roles       Role[]
  auditEvents AuditEvent[]

  @@index([status])
}

model School {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  shortName          String?
  code               String
  schoolType         String?
  board              String?
  establishmentYear  Int?
  registrationNumber String?
  affiliationNumber  String?
  email              String?
  phone              String?
  website            String?
  timezone           String?
  locale             String?
  currency           String?
  status             SchoolStatus @default(SETUP_PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  archivedAt         DateTime?

  branches         Branch[]
  academicSessions AcademicSession[]
  settings         SchoolSettings?

  // School code is unique within its tenant, not globally.
  @@unique([tenantId, code])
  @@index([tenantId])
}

// Branding / display config kept off the School table to avoid one giant row.
model SchoolSettings {
  id                   String   @id @default(cuid())
  schoolId             String   @unique
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  brandingPrimaryColor String?
  brandingLogoUrl      String?
  dateFormat           String?
  weekStart            Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Branch {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  code         String
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  timezone     String?
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  archivedAt   DateTime?

  // Branch code is unique within its school.
  @@unique([schoolId, code])
  @@index([schoolId])
}

// Academic sessions are SCHOOL-scoped (shared across a school's branches), not
// branch-scoped. Only one session per school may be current at a time; that
// invariant is enforced at the service layer (see academic-session.service.ts).
model AcademicSession {
  id        String                @id @default(cuid())
  schoolId  String
  school    School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  startDate DateTime              @db.Date
  endDate   DateTime              @db.Date
  status    AcademicSessionStatus @default(UPCOMING)
  isCurrent Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
}

// ---------------------------------------------------------------------------
// Membership, roles, permissions, access scope
// ---------------------------------------------------------------------------

model TenantMembership {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  roleAssignments UserRoleAssignment[]

  // A user belongs to a given tenant at most once (roles/scopes hang off this).
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

// System roles (isSystem = true) have tenantId = null and act as global
// templates shared by every tenant. Custom roles are tenant-scoped.
model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  // Role key unique within a tenant; system roles (null tenant) uniqueness by
  // key is enforced at the seed/service layer since NULLs are distinct.
  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Ties a role to a membership within a tenant, optionally narrowed to a school
// or branch via the access scope. schoolId/branchId are only meaningful for the
// matching scopeType.
model UserRoleAssignment {
  id           String           @id @default(cuid())
  membershipId String
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  scopeType    AccessScopeType  @default(ALL_TENANT)
  schoolId     String?
  branchId     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([membershipId, roleId, scopeType, schoolId, branchId])
  @@index([membershipId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Audit foundation — generic, append-only. Never store secrets in metadata.
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}
