// Novyra Campus OS — Prisma schema
// Backend Phase 1: core organizational foundation only.
// Hierarchy: Tenant → School → Branch, with School-scoped AcademicSession.
// No business models (students, fees, attendance, …), no auth here.
//
// Prisma 7 notes:
// - The `prisma-client` generator requires an explicit `output`.
// - The datasource holds only `provider`; connection URLs live in
//   `prisma.config.ts` (see project root).
// - Runtime connections use a driver adapter (`@prisma/adapter-pg`); see
//   `lib/db/prisma.ts`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are configured in prisma.config.ts (Prisma 7 convention).
}

// ---------------------------------------------------------------------------
// Status enums — only what the core organizational models need.
// Values mirror the existing UI status vocabularies where they overlap.
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolStatus {
  // SETUP_PENDING: freshly provisioned by a platform admin, onboarding not done.
  // SUSPENDED: platform-suspended (data preserved). See Super Admin Phase SA-2.
  SETUP_PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

/// Mirrors the UI `BranchStatus` (active | setup-pending | inactive | archived).
enum BranchStatus {
  ACTIVE
  SETUP_PENDING
  INACTIVE
  ARCHIVED
}

/// Mirrors the UI `SessionStatus` (draft | upcoming | active | closed | archived).
enum AcademicSessionStatus {
  DRAFT
  UPCOMING
  ACTIVE
  CLOSED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Tenant — the top-level customer/organization boundary (one paying customer).
// ---------------------------------------------------------------------------

model Tenant {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  status   TenantStatus @default(ACTIVE)
  // IANA timezone (e.g. "Asia/Kolkata"), BCP-47 locale, ISO-4217 currency.
  timezone String       @default("Asia/Kolkata")
  locale   String       @default("en-IN")
  currency String       @default("INR")

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  schools        School[]
  memberships    TenantMembership[]
  roles          Role[] // tenant-scoped custom roles (system roles have null tenantId)
  subscriptions  Subscription[] // Super Admin Phase SA-4B
  invoices       Invoice[] // Super Admin Phase SA-4D
  payments       Payment[] // Super Admin Phase SA-4E
  supportTickets SupportTicket[] // Super Admin Phase SA-4I

  @@index([status])
  @@map("tenants")
}

// ---------------------------------------------------------------------------
// School — an institution belonging to a Tenant. Holds core identity/profile
// fields only; extended settings/branding stay out of this table.
// ---------------------------------------------------------------------------

model School {
  id                 String       @id @default(cuid())
  tenantId           String
  name               String
  shortName          String?
  code               String
  schoolType         String?
  board              String?
  establishmentYear  Int?
  registrationNumber String?
  affiliationNumber  String?
  email              String?
  phone              String?
  website            String?
  // IANA timezone / BCP-47 locale / ISO-4217 currency. Default to the tenant's
  // values at creation time in the service layer; stored here so a school can
  // diverge from its tenant.
  timezone           String       @default("Asia/Kolkata")
  locale             String       @default("en-IN")
  currency           String       @default("INR")
  status             SchoolStatus @default(ACTIVE)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches            Branch[]
  academicSessions    AcademicSession[]
  onboarding          SchoolOnboarding? // Super Admin Phase SA-3
  subscriptions       Subscription[] // Super Admin Phase SA-4B
  invoices            Invoice[] // Super Admin Phase SA-4D
  payments            Payment[] // Super Admin Phase SA-4E
  supportTickets      SupportTicket[] // Super Admin Phase SA-4I
  featureOverrides    SchoolFeatureOverride[] // Super Admin Phase SA-4L
  domains             SchoolDomain[] // Super Admin Phase SA-4L
  branding            SchoolBranding? // Super Admin Phase SA-4L
  addOns              SchoolAddOn[] // Super Admin Phase SA-4M
  marketplaceInstalls SchoolMarketplaceInstallation[] // Super Admin Phase SA-4M

  // School code is unique within its tenant.
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("schools")
}

// ---------------------------------------------------------------------------
// Branch — a physical campus/location of a School.
// ---------------------------------------------------------------------------

model Branch {
  id           String       @id @default(cuid())
  schoolId     String
  name         String
  code         String
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  // Optional IANA timezone override; falls back to the school timezone when null.
  timezone     String?
  isPrimary    Boolean      @default(false)
  status       BranchStatus @default(SETUP_PENDING)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Branch code is unique within its school.
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// AcademicSession — an academic year/term. SCHOOL-SCOPED (see decision note in
// the phase report): sessions are defined once per school and shared by all of
// that school's branches, matching the UI where sessions live in the school's
// admin settings and each branch references the current one.
//
// Invariant (enforced in the service layer, per phase spec): at most one
// session per school may have `isCurrent = true` and it must have status
// ACTIVE. `startDate` must precede `endDate`.
// ---------------------------------------------------------------------------

model AcademicSession {
  id        String                @id @default(cuid())
  schoolId  String
  name      String
  code      String
  startDate DateTime              @db.Date
  endDate   DateTime              @db.Date
  status    AcademicSessionStatus @default(DRAFT)
  isCurrent Boolean               @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Session code is unique within its school.
  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, isCurrent])
  @@map("academic_sessions")
}

// ===========================================================================
// Backend Phase 2 — Authentication & Identity Foundation (Batch 1).
//
// Schema only: identity, tenant membership, roles, platform-admin boundary, and
// a minimal Session model for the chosen CUSTOM database-session auth. No login,
// session-creation, RBAC evaluation, or protected-route logic here.
// ===========================================================================

/// Account lifecycle states needed for the auth foundation only.
enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  SUSPENDED
  INACTIVE
}

/// Lifecycle of a user's membership in a tenant.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// Explicit platform-operator roles — deliberately separate from tenant roles.
/// A tenant/school role NEVER grants platform access; only a PlatformAdmin row does.
enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
  AUDITOR
}

// ---------------------------------------------------------------------------
// User — ONE central identity. Domain profiles (Teacher/Student/Parent/…) will
// link TO this User in later phases; there are no separate auth tables per role.
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  name            String?
  email           String     @unique // stored lowercased by the service layer (single global identity)
  // Argon2id hash only — never plaintext. Nullable: invited users set it later.
  passwordHash    String?
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  image           String?

  // First-login foundation (persisted state only; no setup flow implemented yet).
  passwordSetupRequired Boolean   @default(false)
  onboardingCompletedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  memberships                TenantMembership[]
  sessions                   Session[]
  platformAdmin              PlatformAdmin?
  activeContext              UserActiveContext?
  staffProfile               Staff? // Phase 6A — optional link to a school Staff/employee record
  notificationRecipients     NotificationRecipient[] // Phase 9D.2 — in-app notifications
  conversationParticipations ConversationParticipant[] // Phase 9K — communication/messaging
  sentMessages               Message[] // Phase 9K — communication/messaging

  @@index([status])
  @@map("users")
}

// ---------------------------------------------------------------------------
// UserActiveContext — the user's currently-selected workspace context (Batch 4).
// One row per user. The selected IDs are stored as plain columns and are ALWAYS
// re-validated against the user's real access in the context service before use,
// so a stale/deleted id simply resolves to "unselected" (fail closed) without
// needing FKs on every column.
// ---------------------------------------------------------------------------

model UserActiveContext {
  id                String  @id @default(cuid())
  userId            String  @unique
  schoolId          String?
  roleId            String?
  branchId          String?
  academicSessionId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_active_contexts")
}

// ---------------------------------------------------------------------------
// TenantMembership — User ↔ Tenant join. A user may belong to many tenants, so
// tenant is modeled here (NOT as a single tenantId column on User).
// ---------------------------------------------------------------------------

model TenantMembership {
  id       String           @id @default(cuid())
  userId   String
  tenantId String
  status   MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]

  // A user has at most one membership per tenant.
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

// ---------------------------------------------------------------------------
// Role — foundation for future RBAC. Two kinds:
//   • system roles  → isSystem = true,  tenantId = null (seeded once)
//   • tenant custom → isSystem = false, tenantId set    (unique per tenant)
// Permission catalog is intentionally NOT built in this batch.
// System-role `key` uniqueness is enforced in the seed/service layer (a Postgres
// unique over a nullable tenantId cannot express it without a partial index).
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  key         String // e.g. SCHOOL_ADMIN, PRINCIPAL, TEACHER
  name        String
  description String?
  isSystem    Boolean @default(false)
  tenantId    String? // null for system roles

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]
  permissions RolePermission[]

  // Custom role keys are unique within a tenant.
  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([isSystem])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Backend Phase 3 — RBAC. Permission catalog + Role↔Permission mapping.
// Authorization is resolved server-side from these tables (never from the
// browser). Permissions are the primary authority; role identity is secondary.
// ---------------------------------------------------------------------------

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "students.view" (module.action)
  module      String
  action      String
  description String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// RoleAssignment — links a TenantMembership to a Role (roles are always granted
// within a tenant context). School/branch-scoped grants are deferred to the RBAC
// phase; School/Branch already carry stable ids so that can be added without
// reshaping this table.
// ---------------------------------------------------------------------------

model RoleAssignment {
  id           String @id @default(cuid())
  membershipId String
  roleId       String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // A role is assigned at most once per membership.
  @@unique([membershipId, roleId])
  @@index([roleId])
  @@map("role_assignments")
}

// ---------------------------------------------------------------------------
// PlatformAdmin — explicit platform-operator boundary. A User is a platform
// admin ONLY if a row exists here; this is never derived from tenant roles.
// Full Super Admin logic is not implemented in this batch.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id     String       @id @default(cuid())
  userId String       @unique
  role   PlatformRole @default(SUPPORT)
  status UserStatus   @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Session — minimal model for the chosen CUSTOM database-session auth. Only a
// HASH of the session token is stored, never the raw token. No runtime session
// creation/validation is implemented in this batch.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonation PlatformImpersonation?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// PlatformImpersonation — server-authoritative "view a school as platform admin"
// context (Super Admin Phase SA-4K). SECURITY MODEL:
//   • Bound to ONE auth Session (sessionId @unique → at most one active per
//     session). The row is the ONLY authority — never localStorage/cookies/React.
//   • FK cascade to Session: logout (session delete) or a session teardown
//     removes it automatically; an expired session never resolves a user, so the
//     row can never authorize on its own.
//   • Actor stays the platform admin (platformUserId). Target tenant is DERIVED
//     from the target School at start — never client-supplied.
//   • V1 is READ-ONLY inspection: the resolver grants only tenant `.view`
//     permissions for the target, never tenant writes and never a tenant role.
// The start/stop audit trail lives in AuditEvent (IMPERSONATION_STARTED/ENDED);
// this table holds only the single current-state row (deleted on stop).
// ---------------------------------------------------------------------------
model PlatformImpersonation {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  platformUserId String
  targetTenantId String
  targetSchoolId String
  startedAt      DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([targetSchoolId])
  @@map("platform_impersonations")
}

// ===========================================================================
// Backend Phase 4 — Admissions, Students & Guardians.
//
// Real business domain. Org scope (tenant/school/branch/session) is stored as
// plain, indexed String columns and ALWAYS re-validated against the caller's
// real access in the service layer (the same fail-closed convention used by
// UserActiveContext) — so no FK relations are placed on the four core org
// models, keeping this migration self-contained. Relations WITHIN Phase 4
// (Student ↔ StudentGuardian ↔ Guardian, Application ↔ history/notes/docs,
// Student ↔ documents/timeline) use real foreign keys with cascade delete.
//
// Enum values deliberately mirror the existing UI vocabularies so the REST
// APIs speak the shapes the frontend already understands.
// ===========================================================================

/// Mirrors UI StudentStatus (active | inactive | alumni | transferred | archived).
enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
  TRANSFERRED
  ARCHIVED
}

/// Mirrors the UI gender union (male | female | other | prefer-not-to-say).
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// Mirrors UI AdmissionType.
enum AdmissionType {
  NEW
  TRANSFER
  SIBLING
  STAFF_WARD
  MANAGEMENT_QUOTA
}

/// Mirrors UI AdmissionSource.
enum AdmissionSource {
  WEBSITE
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  EDUCATION_FAIR
  AGENT
  PHONE_ENQUIRY
}

/// Mirrors UI AdmissionStageKey. "REJECTED"/"WAITLISTED" are terminal side
/// branches, "ENROLLED" is the converted terminal state.
enum AdmissionStage {
  NEW_ENQUIRY
  APPLICATION_STARTED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  FEE_PENDING
  ENROLLED
  REJECTED
  WAITLISTED
}

/// Mirrors UI StudentGuardianRelationship / GuardianRole.
enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

/// Metadata-only document verification lifecycle (no file storage in Phase 4).
enum DocVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Persisted student timeline event kinds (recorded when the action occurs).
enum StudentTimelineType {
  ADMITTED
  PROFILE_UPDATED
  STATUS_CHANGED
  GUARDIAN_LINKED
  GUARDIAN_UNLINKED
  DOCUMENT_UPDATED
  ADMISSION_CONVERTED
  NOTE_ADDED
}

// ---------------------------------------------------------------------------
// Guardian — a parent/guardian. Tenant-scoped; one Guardian may be linked to
// many Students (via StudentGuardian) and vice-versa. Optional User linkage for
// a future parent portal account. Deduped by (tenantId, email) in the service.
// ---------------------------------------------------------------------------

model Guardian {
  id           String  @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String? // stored lowercased by the service; unique within a tenant when present
  phone        String?
  occupation   String?
  organization String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  photoUrl     String?
  // Optional linkage to a login identity (parent portal). Never required.
  userId       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  students StudentGuardian[]

  // At most one guardian per (tenant, email). Postgres treats NULLs as distinct,
  // so guardians without an email are unconstrained.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("guardians")
}

// ---------------------------------------------------------------------------
// Student — the enrolled learner. Identity/profile only; academic/fee/etc.
// summaries are owned by their future modules and are NOT stored here.
// ---------------------------------------------------------------------------

model Student {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  admissionNumber String
  rollNumber      String?

  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  dateOfBirth   DateTime @db.Date
  gender        Gender   @default(PREFER_NOT_TO_SAY)
  bloodGroup    String?
  nationality   String?
  religion      String?
  category      String?
  motherTongue  String?
  house         String?
  photoUrl      String?

  email String?
  phone String?

  // Denormalized academic placement labels (the academics module owns the real
  // class/section relations later); kept as plain strings for display/filtering.
  classLabel   String?
  sectionLabel String?

  admissionDate DateTime      @db.Date
  admissionType AdmissionType @default(NEW)
  status        StudentStatus @default(ACTIVE)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  // Set when created via admission conversion (traceability; no FK to avoid a
  // circular relation — validated in the service).
  sourceApplicationId String? @unique

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  guardians              StudentGuardian[]
  documents              StudentDocument[]
  timeline               StudentTimelineEvent[]
  enrollments            Enrollment[] // Phase 6-pre — real class/section enrollment
  attendanceRecords      AttendanceRecord[] // Phase 5 — attendance
  examMarks              ExamMark[] // Phase 8B — marks entry (Restrict: a marked student can't be hard-deleted)
  examResults            StudentExamResult[] // Phase 8C — published result snapshots (Restrict)
  promotions             StudentPromotion[] // Phase 8E — promotion/retention decisions (Restrict)
  feeAssignments         StudentFeeAssignment[] // Phase 9F — fee billing
  transportAssignments   StudentTransportAssignment[] // Phase 9M — transport
  transportTripRecords   TransportTripStudent[] // Phase 9M — per-trip boarding/drop
  feeCharges             FeeCharge[] // Phase 9F — billable fee items
  libraryLoans           LibraryLoan[] // Phase 9N — library circulation
  feePayments            FeePayment[] // Phase 9F — fee collections
  inventoryIssues        InventoryIssue[] // Phase 9O — consumable issues to this student
  hostelAssignments      StudentHostelAssignment[] // Phase 9Q — hostel bed allocation history
  hostelRollCallRecords  HostelRollCallRecord[] // Phase 9Q — nightly hostel roll call
  healthProfile          HealthProfile? // Phase 9R — factual health profile
  healthVisits           HealthVisit[] // Phase 9R — infirmary visit history
  counselingCases        CounselingCase[] // Phase 9S — counseling case history (confidential domain)
  cafeteriaMealRecords   CafeteriaMealRecord[] // Phase 9T — meal service history
  activityMemberships    ActivityStudentMembership[] // Phase 9U — club/activity membership history
  activityParticipations ActivityEventParticipant[] // Phase 9U — event registration/attendance
  achievements           StudentAchievement[] // Phase 9U — factual achievement records

  // Admission number is unique within a school.
  @@unique([schoolId, admissionNumber])
  @@index([tenantId])
  @@index([schoolId, status])
  @@index([branchId])
  @@index([academicSessionId])
  @@map("students")
}

// ---------------------------------------------------------------------------
// StudentGuardian — the Student ↔ Guardian relationship with per-link flags.
// ---------------------------------------------------------------------------

model StudentGuardian {
  id                 String           @id @default(cuid())
  studentId          String
  guardianId         String
  relation           GuardianRelation @default(GUARDIAN)
  isPrimary          Boolean          @default(false)
  isEmergencyContact Boolean          @default(false)
  authorizedPickup   Boolean          @default(false)
  isFeeResponsible   Boolean          @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

// ---------------------------------------------------------------------------
// StudentDocument — metadata only (no cloud/file storage in Phase 4).
// ---------------------------------------------------------------------------

model StudentDocument {
  id                 String                @id @default(cuid())
  studentId          String
  type               String
  displayName        String
  status             String                @default("missing")
  verificationStatus DocVerificationStatus @default(PENDING)
  fileName           String?
  expiryDate         DateTime?             @db.Date
  notes              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

// ---------------------------------------------------------------------------
// StudentTimelineEvent — persisted when an action occurs (never faked on read).
// ---------------------------------------------------------------------------

model StudentTimelineEvent {
  id          String              @id @default(cuid())
  studentId   String
  type        StudentTimelineType
  title       String
  detail      String?
  category    String?
  actorUserId String?
  actorName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_timeline_events")
}

// ---------------------------------------------------------------------------
// AdmissionApplication — the admissions pipeline record. Core queryable fields
// are columns; rich optional UI sub-objects (previous school, medical info,
// transport/hostel requirements, fee details, interview, payments) live in a
// single `detailsJson` blob to avoid over-modeling (spec §6: keep it simple).
// Applicant guardians are snapshotted in `guardiansJson` and materialized into
// real Guardian rows only on conversion.
// ---------------------------------------------------------------------------

model AdmissionApplication {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  applicationNumber String
  draft             Boolean         @default(false)
  stage             AdmissionStage  @default(NEW_ENQUIRY)
  priority          String          @default("medium")
  source            AdmissionSource @default(WEBSITE)
  admissionType     AdmissionType   @default(NEW)

  appliedClass             String?
  appliedSectionPreference String?

  // Applicant identity
  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  dateOfBirth   DateTime? @db.Date
  gender        Gender    @default(PREFER_NOT_TO_SAY)
  bloodGroup    String?
  nationality   String?
  religion      String?
  category      String?
  motherTongue  String?
  photoUrl      String?

  email String?
  phone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  guardiansJson Json? // ApplicantGuardian[] snapshot (materialized on conversion)
  detailsJson   Json? // previousSchool / medical / transport / hostel / fee / interview / payments

  assignedOfficerId   String?
  assignedOfficerName String?

  submittedAt DateTime? @db.Timestamptz(6)
  approvedAt  DateTime? @db.Timestamptz(6)
  rejectedAt  DateTime? @db.Timestamptz(6)
  enrolledAt  DateTime? @db.Timestamptz(6)

  // Set once, in the conversion transaction. Uniqueness + a stage guard prevent
  // double conversion.
  convertedStudentId String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  stageHistory AdmissionStageHistory[]
  notes        AdmissionNote[]
  documents    AdmissionDocument[]

  @@unique([schoolId, applicationNumber])
  @@index([tenantId])
  @@index([schoolId, stage])
  @@index([branchId])
  @@index([academicSessionId])
  @@map("admission_applications")
}

// ---------------------------------------------------------------------------
// AdmissionStageHistory — persisted stage transitions (audit trail).
// ---------------------------------------------------------------------------

model AdmissionStageHistory {
  id              String          @id @default(cuid())
  applicationId   String
  fromStage       AdmissionStage?
  toStage         AdmissionStage
  changedByUserId String?
  changedByName   String?
  reason          String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("admission_stage_history")
}

// ---------------------------------------------------------------------------
// AdmissionNote — internal notes on an application.
// ---------------------------------------------------------------------------

model AdmissionNote {
  id            String  @id @default(cuid())
  applicationId String
  authorUserId  String?
  authorName    String
  authorRole    String?
  body          String
  pinned        Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("admission_notes")
}

// ---------------------------------------------------------------------------
// AdmissionDocument — metadata only (transferred to StudentDocument on convert).
// ---------------------------------------------------------------------------

model AdmissionDocument {
  id                 String                @id @default(cuid())
  applicationId      String
  type               String
  displayName        String
  status             String                @default("missing")
  verificationStatus DocVerificationStatus @default(PENDING)
  fileName           String?
  expiryDate         DateTime?             @db.Date
  notes              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("admission_documents")
}

// ---------------------------------------------------------------------------
// AuditEvent — lightweight, generic audit log for important business actions
// (spec §30). Org-scoped; no bulky PII payloads (only ids + a small meta blob).
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String  @id @default(cuid())
  tenantId    String
  schoolId    String?
  actorUserId String?
  actorName   String?
  action      String // e.g. STUDENT_CREATED, ADMISSION_CONVERTED
  entityType  String // e.g. Student, AdmissionApplication, Guardian
  entityId    String
  metaJson    Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// SchoolOnboarding — platform-side onboarding state for a provisioned school
// (Super Admin Phase SA-3). One row per school (1:1). Progress is the ratio of
// completedSteps to the code-defined required steps — never a stored percentage.
// Completing onboarding flips School.status SETUP_PENDING → ACTIVE.
// ---------------------------------------------------------------------------

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model SchoolOnboarding {
  id       String @id @default(cuid())
  tenantId String
  schoolId String @unique

  status         OnboardingStatus @default(IN_PROGRESS)
  currentStep    String
  completedSteps String[] // ordered list of completed step keys

  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("school_onboarding")
}

// ===========================================================================
// Super Admin Phase SA-4A — Plans (subscription plan catalog). Platform-global
// (NOT tenant-scoped): the price/limits/feature-entitlements template that later
// Subscriptions/Trials/Usage/Billing phases will reference. Monetary values are
// structured (Decimal + currency code) — never formatted strings. Archived
// instead of hard-deleted so future subscriptions stay historically valid.
// ===========================================================================

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  status          PlanStatus      @default(DRAFT)
  billingInterval BillingInterval @default(MONTHLY)
  currency        String          @default("INR") // ISO-4217; formatted client-side
  price           Decimal         @db.Decimal(12, 2)
  trialDays       Int             @default(0)
  isPublic        Boolean         @default(true)
  sortOrder       Int             @default(0)

  // Structured plan limits (null = unlimited / not set). Live usage calculation
  // is a later phase (Usage & Limits) — these are just the plan's ceilings.
  maxStudents Int?
  maxStaff    Int?
  maxBranches Int?
  storageGb   Int?

  // Display metadata carried by the existing UI.
  supportLevel String?
  whiteLabel   Boolean @default(false)

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  features      PlanFeature[]
  subscriptions Subscription[] // Super Admin Phase SA-4B

  @@index([status])
  @@index([billingInterval])
  @@index([sortOrder])
  @@map("plans")
}

model PlanFeature {
  id     String @id @default(cuid())
  planId String
  key    String // e.g. students, admissions, attendance, fees, transport, library

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
  @@map("plan_features")
}

// ===========================================================================
// Super Admin Phase SA-4B — Subscriptions. Connects a real School (and its
// Tenant) to a real Plan. Plan pricing/features/limits remain the Plan's — the
// source of truth. Only the minimal COMMERCIAL TERMS are snapshotted here
// (priceAmount + currency + billingInterval) so a subscription's agreed price
// stays historically stable even if the Plan's price later changes. No
// payment-provider IDs and no proration in SA-4B.
//
// "Current subscription" invariant: a school has at most one CURRENT
// subscription, where CURRENT = status in {TRIALING, ACTIVE, PAST_DUE}.
// CANCELLED / ENDED are terminal and may accumulate as history. Enforced in the
// service (transaction) AND by a partial unique index added in the migration:
//   CREATE UNIQUE INDEX subscriptions_one_current_per_school
//     ON subscriptions(school_id) WHERE status IN ('TRIALING','ACTIVE','PAST_DUE');
// ===========================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  ENDED
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  planId   String

  status SubscriptionStatus @default(ACTIVE)

  // Lifecycle dates.
  startDate          DateTime  @db.Timestamptz(6)
  currentPeriodStart DateTime  @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @db.Timestamptz(6)
  trialStart         DateTime? @db.Timestamptz(6)
  trialEnd           DateTime? @db.Timestamptz(6)

  // Cancellation. cancelAtPeriodEnd keeps the subscription CURRENT until the
  // period ends; an immediate cancel sets status=CANCELLED + cancelledAt now.
  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime? @db.Timestamptz(6)
  endedAt           DateTime? @db.Timestamptz(6)

  // Snapshotted commercial terms (NOT the live Plan fields).
  priceAmount     Decimal         @db.Decimal(12, 2)
  currency        String          @default("INR")
  billingInterval BillingInterval @default(MONTHLY)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[] // Super Admin Phase SA-4D
  payments Payment[] // Super Admin Phase SA-4E

  @@index([schoolId])
  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ===========================================================================
// Super Admin Phase SA-4D — Invoices. Generated from a real Subscription; the
// source chain is Tenant → School → Subscription → commercial snapshot → Invoice.
// Money is Decimal (never formatted strings). The subscription's snapshotted
// commercial terms (priceAmount/currency) are the invoice basis — the invoice
// then snapshots its OWN amounts, so a later Plan/Subscription change never
// rewrites an issued invoice.
//
// Lifecycle: DRAFT → OPEN → PAID | VOID (and DRAFT → VOID). OVERDUE is NOT a
// stored state — it is derived: status=OPEN && dueAt < now && amountDue > 0.
// No payment provider in SA-4D; PAID is reached only via an explicit manual
// administrative settlement (mark-paid) — no Payment rows are created.
//
// Invoice numbers come from a Postgres sequence (invoice_number_seq, created in
// the migration) for concurrency-safe uniqueness, backed by a UNIQUE constraint.
// One invoice per subscription billing period is enforced by @@unique below.
// ===========================================================================

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  tenantId       String
  schoolId       String
  subscriptionId String
  status         InvoiceStatus @default(DRAFT)

  currency       String  @default("INR")
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountDue      Decimal @db.Decimal(12, 2)

  periodStart DateTime  @db.Timestamptz(6)
  periodEnd   DateTime  @db.Timestamptz(6)
  issuedAt    DateTime? @db.Timestamptz(6)
  dueAt       DateTime  @db.Timestamptz(6)
  paidAt      DateTime? @db.Timestamptz(6)
  voidedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  lineItems    InvoiceLineItem[]
  payments     Payment[] // Super Admin Phase SA-4E

  // One invoice per subscription billing period (duplicate-generation guard).
  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([tenantId])
  @@index([schoolId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ===========================================================================
// Super Admin Phase SA-4E — Payments. A real financial record settling an
// Invoice: Tenant → School → Subscription → Invoice → Payment. Recording a
// payment atomically increments Invoice.amountPaid / decrements amountDue and
// flips the invoice to PAID when fully settled. Supports partial payments and
// administrative reversal (history preserved). Money is Decimal(12,2).
//
// This is an internal/manual ledger — NO payment gateway. Methods are offline
// (cash/bank/UPI/cheque); "UPI" here means a manually recorded UPI transfer, not
// automated gateway verification. Payment numbers come from payment_number_seq
// (created in the migration) for concurrency-safe uniqueness.
// ===========================================================================

enum PaymentStatus {
  SUCCEEDED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

model Payment {
  id             String        @id @default(cuid())
  paymentNumber  String        @unique
  tenantId       String
  schoolId       String
  invoiceId      String
  subscriptionId String
  status         PaymentStatus @default(SUCCEEDED)
  method         PaymentMethod

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  reference        String? // e.g. UTR / cheque no. — manually entered, optional
  notes            String?
  receivedAt       DateTime  @db.Timestamptz(6)
  recordedByUserId String?
  recordedByName   String?
  reversedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

// ===========================================================================
// Super Admin Phase SA-4I — Support tickets. Platform-level support (separate
// from the tenant/school helpdesk). A ticket belongs to a real Tenant (and
// optionally a School). Assignment is to a platform admin (validated in the
// service; stored as a plain userId + denormalized name, no FK to keep it
// simple). Escalation is DERIVED (never a stored boolean). Ticket numbers come
// from support_ticket_number_seq (concurrency-safe) + a UNIQUE constraint.
// Conversation entries live in SupportTicketMessage; internal notes are the same
// table with `internal = true` and are split out in the API DTO.
// ===========================================================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BILLING
  ACCOUNT
  TECHNICAL
  ONBOARDING
  FEATURE
  OTHER
}

model SupportTicket {
  id           String                @id @default(cuid())
  ticketNumber String                @unique
  tenantId     String
  schoolId     String?
  subject      String
  description  String
  category     SupportTicketCategory @default(OTHER)
  priority     SupportTicketPriority @default(MEDIUM)
  status       SupportTicketStatus   @default(OPEN)

  assignedToUserId String?
  assignedToName   String?
  createdByUserId  String?
  createdByName    String?
  createdByEmail   String?

  openedAt        DateTime  @default(now()) @db.Timestamptz(6)
  firstResponseAt DateTime? @db.Timestamptz(6)
  resolvedAt      DateTime? @db.Timestamptz(6)
  closedAt        DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([tenantId])
  @@index([schoolId])
  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String  @id @default(cuid())
  ticketId     String
  authorUserId String?
  authorName   String
  body         String
  internal     Boolean @default(false) // true = platform-internal note

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_messages")
}

// ===========================================================================
// Super Admin Phase SA-4L — Features, Domains & Branding.
//
// Feature ENTITLEMENT (does a SCHOOL/PLAN have a module?) is distinct from RBAC
// (can a USER perform an action?). Plan defaults come from PlanFeature (a key is
// "included" when a PlanFeature row exists for the school's current plan). A
// SchoolFeatureOverride flips a single key on/off for one school on top of that
// default. Effective = override ?? plan-default. Enforcement (feature + RBAC)
// is resolved server-side (lib/server/platform/features-service).
//
// Domains & Branding are per-school platform configuration. NO external DNS/SSL
// provider or file-storage integration in this phase — status is honest
// (PENDING until a clearly-labelled manual admin action), branding is
// URL/metadata only (no uploads, no client-storage persistence).
// ===========================================================================

model SchoolFeatureOverride {
  id         String  @id @default(cuid())
  schoolId   String
  tenantId   String // derived from the school; denormalised for tenant-scoped queries
  featureKey String // one of lib/plans/features FEATURE_KEYS
  enabled    Boolean // explicit on/off applied over the plan default
  reason     String?
  createdBy  String? // platform admin userId

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, featureKey]) // at most one override per (school, feature)
  @@index([schoolId])
  @@index([tenantId])
  @@map("school_feature_overrides")
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING // awaiting (manual) verification — the honest default
  VERIFIED
  FAILED
  DISABLED
}

model SchoolDomain {
  id                String       @id @default(cuid())
  tenantId          String // derived from the school
  schoolId          String
  hostname          String       @unique // bare host only (no protocol/path), lowercased
  type              DomainType   @default(CUSTOM)
  status            DomainStatus @default(PENDING)
  isPrimary         Boolean      @default(false)
  verificationToken String? // opaque token for the DNS TXT instructions (no DNS lookups here)
  verifiedAt        DateTime?    @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([tenantId])
  @@index([status])
  @@map("school_domains")
}

model SchoolBranding {
  id       String @id @default(cuid())
  schoolId String @unique
  tenantId String // derived from the school

  displayName      String?
  logoUrl          String? // URL only — no file uploads in this phase
  faviconUrl       String?
  primaryColor     String? // validated #RRGGBB server-side
  secondaryColor   String?
  accentColor      String?
  loginHeadline    String?
  loginSubheadline String?
  footerText       String?
  updatedBy        String? // platform admin userId

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("school_brandings")
}

// ===========================================================================
// Super Admin Phase SA-4M — Add-ons & Marketplace.
//
// ADD-ON: an optional commercial/product extension assigned to a school
// INDEPENDENTLY of its base Plan (distinct from a PlanFeature entitlement,
// SA-4L). Assignment means "this school is entitled to use this add-on"; the
// agreed commercial terms are SNAPSHOTTED on assignment. NO payment provider,
// gateway subscription, invoice or charge is created here.
//
// MARKETPLACE APP: an optional/external integration a school can install. This
// phase persists installation INTENT + enabled/disabled status + non-secret
// configuration metadata only. It NEVER fakes OAuth/token exchange/webhook
// registration/provider connectivity, and NEVER stores or returns secrets.
// ===========================================================================

enum AddOnStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SchoolAddOnStatus {
  ACTIVE
  ENDED
}

model AddOn {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  category        String?
  status          AddOnStatus      @default(ACTIVE)
  // Optional commercial terms (Decimal money). No provider billing in this phase.
  priceAmount     Decimal?         @db.Decimal(12, 2)
  currency        String           @default("INR")
  billingInterval BillingInterval?

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  assignments SchoolAddOn[]

  @@index([status])
  @@map("addons")
}

model SchoolAddOn {
  id       String            @id @default(cuid())
  tenantId String // derived from the school
  schoolId String
  addOnId  String
  status   SchoolAddOnStatus @default(ACTIVE)

  startedAt DateTime  @default(now()) @db.Timestamptz(6)
  endedAt   DateTime? @db.Timestamptz(6)

  // Commercial terms snapshotted at assignment (stable even if the catalog price
  // later changes). Nullable when the add-on has no price.
  priceAmount     Decimal?         @db.Decimal(12, 2)
  currency        String?
  billingInterval BillingInterval?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  addOn  AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  // One assignment row per (school, add-on) — status toggles ACTIVE/ENDED, so a
  // school can never hold two active assignments of the same add-on.
  @@unique([schoolId, addOnId])
  @@index([tenantId])
  @@index([addOnId])
  @@index([schoolId, status])
  @@map("school_addons")
}

enum MarketplaceAppStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MarketplaceInstallStatus {
  INSTALLED
  DISABLED
}

model MarketplaceApp {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  description      String?
  category         String
  providerName     String?
  status           MarketplaceAppStatus @default(ACTIVE)
  documentationUrl String?

  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)

  installations SchoolMarketplaceInstallation[]

  @@index([status])
  @@index([category])
  @@map("marketplace_apps")
}

model SchoolMarketplaceInstallation {
  id       String                   @id @default(cuid())
  tenantId String // derived from the school
  schoolId String
  appId    String
  status   MarketplaceInstallStatus @default(INSTALLED)

  installedAt   DateTime  @default(now()) @db.Timestamptz(6)
  disabledAt    DateTime? @db.Timestamptz(6)
  // NON-SECRET configuration metadata only. Secrets (API keys / tokens / client
  // secrets) are never stored here and never returned in DTOs.
  configuration Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  app    MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  // One installation row per (school, app) — status toggles INSTALLED/DISABLED.
  @@unique([schoolId, appId])
  @@index([tenantId])
  @@index([appId])
  @@map("school_marketplace_installations")
}

// ===========================================================================
// Super Admin Phase SA-4N — System (final): Settings, Announcements, Incidents.
//
// Platform Admins reuse the existing PlatformAdmin/User models (no new identity
// model). Audit/Activity are a read view over the existing AuditEvent table (no
// second event store). Only these three genuinely-new pieces of state are added.
// ===========================================================================

// One-row singleton (fixed id "singleton"): platform-wide configuration. Holds
// only SAFE, non-secret DB configuration — never SMTP/API/OAuth/payment secrets
// or infrastructure/runtime credentials.
model PlatformSetting {
  id                 String  @id @default("singleton")
  platformName       String  @default("Novyra Campus OS")
  supportEmail       String?
  defaultLocale      String  @default("en-IN")
  defaultTimezone    String  @default("Asia/Kolkata")
  defaultCurrency    String  @default("INR")
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?
  signupEnabled      Boolean @default(true)
  defaultTrialDays   Int     @default(14)
  updatedByUserId    String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_settings")
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL_PLATFORM_USERS
  PLATFORM_ADMINS
  ALL_SCHOOLS
}

model PlatformAnnouncement {
  id              String               @id @default(cuid())
  title           String
  body            String
  category        String? // e.g. product-update | maintenance | security | billing | policy
  status          AnnouncementStatus   @default(DRAFT)
  audience        AnnouncementAudience @default(ALL_SCHOOLS)
  // Optional display window; NOT a delivery mechanism (announcements are shown
  // in-app only — no email/SMS/push is sent).
  startsAt        DateTime?            @db.Timestamptz(6)
  endsAt          DateTime?            @db.Timestamptz(6)
  publishedAt     DateTime?            @db.Timestamptz(6)
  createdByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("platform_announcements")
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

// A manually-recorded platform incident/maintenance notice. There is NO external
// uptime/telemetry monitoring — the status page reports only real, measurable
// internal signals (maintenance mode, DB reachability) plus these manual records.
model PlatformIncident {
  id              String           @id @default(cuid())
  title           String
  description     String?
  severity        IncidentSeverity @default(MINOR)
  status          IncidentStatus   @default(INVESTIGATING)
  startedAt       DateTime         @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime?        @db.Timestamptz(6)
  createdByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("platform_incidents")
}

// ===========================================================================
// Phase 6-pre — Academics FOUNDATION (Class / Section / Enrollment) ONLY.
//
// The minimum real academic grouping required to unblock Attendance (Phase 5).
// NOT a broad Academics rewrite: no Subjects/Timetable/Exams/Marks/Homework here.
// Class is school + academic-session scoped; a Section belongs to a Class AND a
// Branch (attendance is branch-scoped); a student has at most one Enrollment per
// academic session (→ their Section). Org columns mirror the Phase-4 convention
// (plain indexed strings, re-validated in the service) EXCEPT the intra-domain
// relations (Class↔Section↔Enrollment) and Enrollment→Student, which use real FKs.
// ===========================================================================

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum SectionStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED
  WITHDRAWN
}

model Class {
  id                String      @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  name              String
  order             Int         @default(0)
  status            ClassStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  sections         Section[]
  enrollments      Enrollment[]
  classSubjects    ClassSubject[] // Phase 6 — subjects taught in this class
  examClasses      ExamClass[] // Phase 8A — exam applicability
  targetPromotions StudentPromotion[] // Phase 8E — promotions targeting this class
  curricula        Curriculum[] // Phase 9C.1 — curriculum/syllabus tracking
  feeStructures    FeeStructureClass[] // Phase 9F — fee structures targeting this class

  // One class name per school + academic session.
  @@unique([schoolId, academicSessionId, name])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("classes")
}

model Section {
  id                String        @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  classId           String
  name              String
  capacity          Int           @default(40)
  status            SectionStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class               Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  attendanceSessions  AttendanceSession[] // Phase 5 — attendance
  teachingAssignments TeachingAssignment[] // Phase 6A — teacher ↔ section+subject
  timetableEntries    TimetableEntry[] // Phase 7 — timetable
  examScheduleEntries ExamScheduleEntry[] // Phase 8A — exam schedule
  targetPromotions    StudentPromotion[] // Phase 8E — promotions targeting this section
  homework            Homework[] // Phase 9B — homework/assignments
  curriculumProgress  CurriculumTopicProgress[] // Phase 9C.1 — section-scoped syllabus progress
  lessonPlans         LessonPlan[] // Phase 9C.2 — lesson plans

  // One section name per class.
  @@unique([classId, name])
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@index([classId])
  @@map("sections")
}

model Enrollment {
  id                String           @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  classId           String
  sectionId         String
  studentId         String
  rollNumber        String?
  status            EnrollmentStatus @default(ENROLLED)
  enrolledAt        DateTime         @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class             Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[] // Phase 5 — attendance
  examMarks         ExamMark[] // Phase 8B — historical reference only (SetNull on unenrollment)
  examResults       StudentExamResult[] // Phase 8C — historical reference only (SetNull on unenrollment)
  // Phase 8E — Restrict (not SetNull): once a promotion decision references an
  // enrollment (as either its source or its own newly-created target), that
  // enrollment is historical truth and must never be deleted out from under it.
  promotionsFrom    StudentPromotion[]     @relation("PromotionFromEnrollment")
  promotionsTo      StudentPromotion[]     @relation("PromotionNewEnrollment")
  feeAssignments    StudentFeeAssignment[] // Phase 9F — traceability only, never re-validated after the fact

  // One enrollment row per student per academic session; a student appears at
  // most once in a given section.
  @@unique([academicSessionId, studentId])
  @@unique([sectionId, studentId])
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@index([classId])
  @@index([sectionId])
  @@index([studentId])
  @@map("enrollments")
}

// ===========================================================================
// Phase 5 — Attendance. Real, PostgreSQL-backed student attendance keyed on the
// Academics Foundation (Section + Enrollment), NOT label strings.
//
// AttendanceSession = one register per (section, calendar day). AttendanceRecord
// = one per enrolled student per session — the HISTORICAL snapshot (never
// silently rewritten when enrollment later changes). Date is a date-only column
// (school-local calendar day, supplied as YYYY-MM-DD, normalized to UTC-midnight
// at the service boundary so browser timezones can't shift the day).
// ===========================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
  MEDICAL_LEAVE
  OFFICIAL_DUTY
}

enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

// Phase 7C — a session is either the whole-day register (DAILY) or a single
// timetable lesson (PERIOD). Existing rows default to DAILY.
enum AttendanceSessionType {
  DAILY
  PERIOD
}

model AttendanceSession {
  id                String                  @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  sectionId         String
  date              DateTime                @db.Date
  type              AttendanceSessionType   @default(DAILY)
  status            AttendanceSessionStatus @default(DRAFT)

  // Phase 7C — PERIOD sessions bind to a real TimetableEntry (SetNull so deleting
  // the lesson never deletes attendance history). The snapshot columns below are
  // captured at creation and NEVER mutated, so historical subject/period/teacher
  // meaning survives a later timetable move/delete, subject archive or staff change.
  timetableEntryId String?
  periodId         String?
  subjectId        String?
  staffId          String?
  periodName       String?
  subjectCode      String?
  subjectName      String?
  staffName        String?

  markedByUserId String?
  markedByName   String?
  submittedAt    DateTime? @db.Timestamptz(6)
  lockedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section        Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  timetableEntry TimetableEntry?    @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  records        AttendanceRecord[]

  // Uniqueness is enforced by TWO PARTIAL unique indexes added in the migration
  // (Prisma cannot express partial uniques): DAILY → (sectionId, date) WHERE
  // type='DAILY'; PERIOD → (timetableEntryId, date) WHERE type='PERIOD'. Both are
  // concurrency-safe. The plain indexes below cover the read patterns.
  @@index([tenantId])
  @@index([schoolId, academicSessionId, type, date])
  @@index([branchId, academicSessionId, date])
  @@index([sectionId, date])
  @@index([timetableEntryId, date])
  @@index([subjectId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  attendanceSessionId String
  studentId           String
  // The enrollment the record was marked against (captured at marking time). Kept
  // for provenance; nullable + SetNull so unenrolling a student later does NOT
  // delete/alter the historical attendance record (§22 historical correctness).
  enrollmentId        String?
  status              AttendanceStatus @default(PRESENT)
  remarks             String?
  markedAt            DateTime?        @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  session    AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  // Student rows are archived, never hard-deleted, so Restrict guards history.
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment Enrollment?       @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // One record per student per session.
  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([attendanceSessionId])
  @@map("attendance_records")
}

// ===========================================================================
// Phase 6 — Academics Core: Subjects. Real, PostgreSQL-backed subject catalog +
// class-level subject assignment. The Subject catalog is SCHOOL-scoped (a stable
// catalogue reused across academic sessions); which subjects a Class teaches is
// the session-scoped ClassSubject join (real FK to Class + Subject). Sections
// INHERIT their Class's subjects — there is no SectionSubject table. Teacher /
// timetable / marks assignment is deliberately NOT modelled here (no real Staff
// entity yet). Org columns are plain indexed strings re-validated in the service
// (Phase-4 convention); the intra-domain Class↔ClassSubject↔Subject links are FKs.
// ===========================================================================

enum SubjectType {
  CORE
  ELECTIVE
  OPTIONAL
  PRACTICAL
  LANGUAGE
  CO_CURRICULAR
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

model Subject {
  id              String        @id @default(cuid())
  tenantId        String
  schoolId        String
  code            String
  name            String
  shortName       String
  department      String
  type            SubjectType   @default(CORE)
  gradeRangeStart Int           @default(0)
  gradeRangeEnd   Int           @default(13)
  credit          Int           @default(4)
  passingMarks    Int           @default(33)
  maxMarks        Int           @default(100)
  theoryMarks     Int           @default(100)
  practicalMarks  Int           @default(0)
  color           String        @default("#18b0c8")
  order           Int           @default(0)
  status          SubjectStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  classSubjects       ClassSubject[]
  teachingAssignments TeachingAssignment[] // Phase 6A — teacher ↔ section+subject
  timetableEntries    TimetableEntry[] // Phase 7 — timetable
  examScheduleEntries ExamScheduleEntry[] // Phase 8A — exam schedule
  homework            Homework[] // Phase 9B — homework/assignments
  curricula           Curriculum[] // Phase 9C.1 — curriculum/syllabus tracking
  lessonPlans         LessonPlan[] // Phase 9C.2 — lesson plans

  // One subject code per school (catalogue is school-wide, reused across sessions).
  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("subjects")
}

model ClassSubject {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  classId           String
  subjectId         String
  isCore            Boolean @default(true)
  order             Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // A subject is assigned to a class at most once.
  @@unique([classId, subjectId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

// ===========================================================================
// Phase 6A — Staff / Teacher foundation (prerequisite for Timetable). A Staff
// record is a school-domain EMPLOYEE, distinct from the auth `User` (login
// identity). Staff is tenant/school/BRANCH scoped and NOT academic-session
// scoped — employees persist across years; session-specific teaching lives in
// TeachingAssignment. `userId` is an OPTIONAL 1:1 link to a login account (staff
// may exist without one). Teaching eligibility is the explicit `isTeaching`
// flag (never inferred from a name). Org columns are plain indexed strings
// re-validated in the service; intra-domain links (Staff↔TeachingAssignment,
// TeachingAssignment→Section/Subject) are real FKs.
// ===========================================================================

enum StaffStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

model Staff {
  id             String          @id @default(cuid())
  tenantId       String
  schoolId       String
  branchId       String
  employeeCode   String
  firstName      String
  lastName       String?
  displayName    String?
  email          String?
  phone          String?
  // Legacy free-text fields (Phase 6A, predate Department/Designation
  // masters). Kept for backward compatibility with the many existing
  // consumers that read them as plain strings (dashboards, teacher
  // directory, Action Inbox, timetable, …) — NOT the relationship
  // authority. When departmentId/designationId is set, these are a
  // transactionally-maintained display cache kept in lockstep with the
  // real master's current name by lib/server/staff/service.ts, the same
  // documented-cache pattern as Phase 9O's InventoryStockBalance. A Staff
  // row created before Phase 9P (or never assigned a real department/
  // designation) may still carry only the free-text value with null FKs.
  designation    String?
  department     String?
  departmentId   String?
  designationId  String?
  employmentType EmploymentType?
  isTeaching     Boolean         @default(false)
  status         StaffStatus     @default(ACTIVE)
  joiningDate    DateTime?       @db.Date
  userId         String?         @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user                               User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentRef                      Department?                      @relation("StaffDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  designationRef                     Designation?                     @relation("StaffDesignation", fields: [designationId], references: [id], onDelete: Restrict)
  headOfDepartments                  Department[]                     @relation("DepartmentHead")
  teachingAssignments                TeachingAssignment[]
  timetableEntries                   TimetableEntry[] // Phase 7 — timetable
  examInvigilations                  ExamScheduleEntry[] // Phase 8A — optional invigilator
  homework                           Homework[] // Phase 9B — homework/assignments
  curriculumTopicProgress            CurriculumTopicProgress[] // Phase 9C.1 — topics this staff marked complete
  lessonPlans                        LessonPlan[] // Phase 9C.2 — lesson plans
  attendanceRecords                  StaffAttendanceRecord[] // Phase 9E.1 — own daily attendance
  leaveRequests                      LeaveRequest[] // Phase 9E.2 — own leave requests
  salaryAssignments                  StaffSalaryAssignment[] // Phase 9H — effective-dated salary assignments
  payrollItems                       PayrollRunItem[] // Phase 9H — payroll snapshots
  hostedVisits                       VisitorVisit[] // Phase 9I — visits where this staff is the host
  transportRouteDriverAssignments    TransportRouteAssignment[]       @relation("TransportRouteDriver") // Phase 9M
  transportRouteAttendantAssignments TransportRouteAssignment[]       @relation("TransportRouteAttendant") // Phase 9M
  transportTripsAsDriver             TransportTrip[]                  @relation("TransportTripDriver") // Phase 9M
  transportTripsAsAttendant          TransportTrip[]                  @relation("TransportTripAttendant") // Phase 9M
  staffTransportAssignments          StaffTransportAssignment[] // Phase 9M
  libraryLoans                       LibraryLoan[] // Phase 9N — library circulation
  assetAssignments                   AssetAssignment[] // Phase 9O — durable asset custody
  hostelStaffAssignments             HostelStaffAssignment[] // Phase 9Q — warden/assistant-warden assignment
  inventoryIssues                    InventoryIssue[] // Phase 9O — consumable issues to this staff member
  healthProfile                      HealthProfile? // Phase 9R — factual health profile, when this Staff member is a patient
  healthVisitsAsPatient              HealthVisit[]                    @relation("HealthVisitPatientStaff") // Phase 9R
  healthVisitsAttended               HealthVisit[]                    @relation("HealthVisitAttendant") // Phase 9R — infirmary staff who attended
  healthTreatmentsGiven              HealthTreatmentRecord[]          @relation("HealthTreatmentStaff") // Phase 9R
  healthMedicationsGiven             HealthMedicationAdministration[] @relation("HealthMedicationStaff") // Phase 9R
  counselingCasesAssigned            CounselingCase[]                 @relation("CounselingCaseCounselor") // Phase 9S — cases where this Staff member is the assigned counselor
  counselingSessionsConducted        CounselingSession[]              @relation("CounselingSessionCounselor") // Phase 9S
  cafeteriaMealRecordsAsConsumer     CafeteriaMealRecord[]            @relation("CafeteriaMealStaffConsumer") // Phase 9T
  activityStaffAssignments           ActivityStaffAssignment[] // Phase 9U — coordinator/coach/mentor assignments

  // One employee code per school.
  @@unique([schoolId, employeeCode])
  @@index([tenantId])
  @@index([schoolId, branchId, status])
  @@index([schoolId, isTeaching, status])
  @@index([departmentId])
  @@index([designationId])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// Phase 9P — HR Core: Department + Designation master data. Staff.id remains
// the sole canonical employee identity — these are attribute lookups, not a
// parallel employee model. Archived (never hard-deleted) when referenced by
// Staff, so historical Payroll/Attendance/Leave/TeachingAssignment rows are
// never affected by a later department/designation rename or archive.
// ---------------------------------------------------------------------------

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

model Department {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  code        String
  name        String
  description String?
  headStaffId String?

  status DepartmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  headStaff    Staff?        @relation("DepartmentHead", fields: [headStaffId], references: [id], onDelete: SetNull)
  staff        Staff[]       @relation("StaffDepartment")
  designations Designation[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@index([headStaffId])
  @@map("departments")
}

enum DesignationStatus {
  ACTIVE
  ARCHIVED
}

model Designation {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  departmentId String?
  code         String
  name         String
  description  String?
  level        Int? // optional display/sort order only (e.g. "level 1 is most senior") — not a promotion/hierarchy policy

  status DesignationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  staff      Staff[]     @relation("StaffDesignation")

  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@index([departmentId])
  @@map("designations")
}

// A teacher (Staff) teaching a Subject in a Section for the section's academic
// session. Real FKs to Section + Subject + Staff. The Subject must be part of the
// Section's Class curriculum (validated via getSubjectsForSection) and the Staff
// must be ACTIVE + teaching-eligible + in the section's branch. Multiple teachers
// per (section, subject) are allowed (co-teaching), but a given staff is assigned
// to a (section, subject) at most once.
model TeachingAssignment {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  sectionId         String
  subjectId         String
  staffId           String
  isPrimary         Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section          Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff            Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[] // Phase 7 — timetable (Restrict: can't remove a scheduled assignment)
  homework         Homework[] // Phase 9B — homework (Restrict: can't remove an assignment with homework attached)
  lessonPlans      LessonPlan[] // Phase 9C.2 — lesson plans (Restrict: can't remove an assignment with lesson plans attached)

  @@unique([sectionId, subjectId, staffId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([staffId])
  @@map("teaching_assignments")
}

// ===========================================================================
// Phase 7 — Timetable. Two concepts: the daily PERIOD STRUCTURE (bell schedule)
// and the actual TEACHING SCHEDULE (weekly recurring entries).
//
// TimetablePeriod = one column of the school day (branch + session scoped).
// Times are stored as MINUTES FROM MIDNIGHT (deterministic, timezone-free).
// Type TEACHING columns hold lessons; BREAK columns (short break / lunch /
// assembly) cannot hold a teaching entry.
//
// TimetableEntry = a lesson: this Staff teaches this Subject to this Section in
// this Period on this Weekday. teachingAssignmentId is the AUTHORITATIVE relation
// ("Staff Z may teach Subject Y to Section X") — the denormalized sectionId /
// subjectId / staffId columns are validated to match it on every write and exist
// so the two conflict constraints can be enforced by the DATABASE (concurrency-
// safe, not findFirst→create):
//   • Section conflict  → @@unique([sectionId, weekday, periodId])
//   • Teacher conflict  → @@unique([staffId,  weekday, periodId])
// teachingAssignmentId uses onDelete: Restrict so a scheduled assignment cannot be
// silently removed (timetable history stays consistent — plan §41). No Room model
// exists yet, so room scheduling is deferred (no roomId). No draft/publish
// lifecycle container: entries are live (plan §15/§16 — not overbuilt).
// ===========================================================================

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PeriodType {
  TEACHING
  BREAK
}

model TimetablePeriod {
  id                String     @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  name              String
  periodNumber      Int
  startMinutes      Int // minutes from midnight (e.g. 08:00 → 480)
  endMinutes        Int
  type              PeriodType @default(TEACHING)
  order             Int        @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  entries TimetableEntry[]

  // One period number per branch/session bell schedule.
  @@unique([schoolId, branchId, academicSessionId, periodNumber])
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@map("timetable_periods")
}

model TimetableEntry {
  id                   String  @id @default(cuid())
  tenantId             String
  schoolId             String
  branchId             String
  academicSessionId    String
  sectionId            String
  subjectId            String
  staffId              String
  teachingAssignmentId String
  periodId             String
  weekday              Weekday
  notes                String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section            Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff              Staff               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment  @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  period             TimetablePeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[] // Phase 7C — period attendance (SetNull keeps history)

  // DB-enforced conflict prevention (concurrency-safe).
  @@unique([sectionId, weekday, periodId]) // a section: one lesson per weekday+period
  @@unique([staffId, weekday, periodId]) // a teacher: one place per weekday+period
  @@index([tenantId])
  @@index([schoolId, branchId, academicSessionId])
  @@index([sectionId])
  @@index([staffId])
  @@index([periodId])
  @@index([teachingAssignmentId])
  @@map("timetable_entries")
}

// ===========================================================================
// Phase 8A — Exams foundation (term / exam / class applicability / subject
// schedule). Marks, results, grading and report cards are DELIBERATELY not
// modelled here (Phase 8B+). Three concepts, kept separate:
//   ExamTerm            — a term/cycle within an academic session ("Term 1").
//   Exam                — a named exam event under a term.
//   ExamClass           — which real Classes an Exam applies to (join).
//   ExamScheduleEntry   — when a Subject's paper happens: real Section + real
//                         Subject + date/time, SECTION-scoped (matches the
//                         Section-anchored convention used by Attendance,
//                         Timetable and Enrollment throughout this codebase).
//
// Marks limits (maxMarks/passingMarks/theoryMarks/practicalMarks) are
// SNAPSHOTTED onto the schedule entry at creation from the Subject's current
// defaults — never read live from Subject — so a later Subject edit can never
// rewrite a historical exam's marks configuration (Phase 8B stability).
//
// Conflict prevention: at most one scheduled paper per Section per calendar
// day (@@unique[sectionId,examDate]) — the standard "one paper per day" school
// policy, DB-enforced and concurrency-safe. The optional invigilator similarly
// gets at most one assignment per calendar day (@@unique[invigilatorStaffId,
// examDate] — Postgres unique constraints permit unlimited NULLs, so this is
// safe with no invigilator selected). No Room/Hall model exists yet, so room
// scheduling is deliberately NOT represented here (plan §15).
// ===========================================================================

enum ExamTermStatus {
  ACTIVE
  ARCHIVED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  ARCHIVED
}

enum ExamType {
  UNIT_TEST
  WEEKLY_TEST
  MONTHLY_TEST
  MIDTERM
  HALF_YEARLY
  ANNUAL
  PRE_BOARD
  BOARD
  PRACTICAL
  ORAL
  ASSIGNMENT
  PROJECT
  INTERNAL_ASSESSMENT
  CUSTOM
}

enum ExamScope {
  INTERNAL
  EXTERNAL
}

enum ExamMode {
  ONLINE
  OFFLINE
}

model ExamTerm {
  id                String         @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  name              String
  code              String
  order             Int            @default(0)
  status            ExamTermStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  exams Exam[]

  // One term code per school + academic session.
  @@unique([schoolId, academicSessionId, code])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("exam_terms")
}

model Exam {
  id                String     @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  examTermId        String
  name              String
  code              String
  type              ExamType   @default(CUSTOM)
  description       String?
  startsOn          DateTime   @db.Date
  endsOn            DateTime   @db.Date
  scope             ExamScope  @default(INTERNAL)
  mode              ExamMode   @default(OFFLINE)
  status            ExamStatus @default(DRAFT)
  gradingSchemeId   String? // Phase 8C — which GradingScheme resolves this exam's grades; explicit, not inferred by class

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  term              ExamTerm               @relation(fields: [examTermId], references: [id], onDelete: Restrict)
  classes           ExamClass[]
  schedule          ExamScheduleEntry[]
  gradingScheme     GradingScheme?         @relation(fields: [gradingSchemeId], references: [id], onDelete: SetNull)
  resultPublication ExamResultPublication? // Phase 8C — at most one publication per exam

  // One exam code per school + academic session.
  @@unique([schoolId, academicSessionId, code])
  @@index([tenantId])
  @@index([schoolId, academicSessionId, status])
  @@index([examTermId])
  @@map("exams")
}

/**
 * Which real Classes an Exam applies to; Sections inherit through their Class.
 */
model ExamClass {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  examId            String
  classId           String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([examId, classId])
  @@index([tenantId])
  @@index([examId])
  @@index([classId])
  @@map("exam_classes")
}

model ExamScheduleEntry {
  id                String   @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String
  examId            String
  sectionId         String
  subjectId         String
  examDate          DateTime @db.Date
  startMinutes      Int // minutes from midnight — same deterministic convention as TimetablePeriod
  endMinutes        Int

  // Snapshotted from Subject at creation — NEVER re-read live (Phase 8B stability).
  maxMarks       Int
  passingMarks   Int
  theoryMarks    Int
  practicalMarks Int

  invigilatorStaffId String? // optional; NOT the subject's TeachingAssignment teacher
  notes              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  section     Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  invigilator Staff?         @relation(fields: [invigilatorStaffId], references: [id], onDelete: SetNull)
  markSheet   ExamMarkSheet? // Phase 8B — marks entry (get-or-create, one per entry)

  // No duplicate subject paper for the same exam+section.
  @@unique([examId, sectionId, subjectId])
  // At most one paper per Section per calendar day (DB-enforced, concurrency-safe).
  @@unique([sectionId, examDate])
  // At most one assignment per invigilator per calendar day (NULLs are unlimited).
  @@unique([invigilatorStaffId, examDate])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([examId])
  @@index([subjectId])
  @@map("exam_schedule_entries")
}

// ── Phase 8B: Marks entry ───────────────────────────────────────────────────

enum ExamMarkSheetStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum ExamMarkStatus {
  PENDING
  MARKED
  ABSENT
  EXEMPT
}

// One per ExamScheduleEntry (get-or-create, concurrency-safe via the unique FK).
// Owns the Draft → Submitted → Verified lifecycle; individual ExamMark rows carry
// no submission state of their own (locking is at the sheet, not the row).
model ExamMarkSheet {
  id                  String              @id @default(cuid())
  tenantId            String
  schoolId            String
  academicSessionId   String
  examScheduleEntryId String              @unique
  status              ExamMarkSheetStatus @default(DRAFT)

  submittedByUserId String?
  submittedByName   String?
  submittedAt       DateTime? @db.Timestamptz(6)
  verifiedByUserId  String?
  verifiedByName    String?
  verifiedAt        DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  scheduleEntry ExamScheduleEntry @relation(fields: [examScheduleEntryId], references: [id], onDelete: Cascade)
  marks         ExamMark[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("exam_mark_sheets")
}

// One row per (markSheet, student) — at most one mark for a student on a given
// paper (@@unique). status is explicit: ABSENT/EXEMPT are NOT zero marks; the
// numeric fields stay null for those and for PENDING (never entered). Marks
// limits are validated against the parent ExamScheduleEntry's SNAPSHOTTED
// values, never live Subject data (Phase 8A historical-stability guarantee
// extends here). studentId uses onDelete: Restrict — a student with recorded
// marks can never be hard-deleted out from under its history; enrollmentId is
// a soft historical reference only (SetNull) since a later unenrollment must
// never destroy an already-recorded mark.
model ExamMark {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  markSheetId       String
  studentId         String
  enrollmentId      String?

  status         ExamMarkStatus @default(PENDING)
  theoryMarks    Int?
  practicalMarks Int?
  marksObtained  Int?
  remarks        String?

  enteredByUserId String?
  enteredByName   String?
  enteredAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  markSheet  ExamMarkSheet @relation(fields: [markSheetId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  // No duplicate mark row for the same student on the same paper.
  @@unique([markSheetId, studentId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId])
  @@index([enrollmentId])
  @@map("exam_marks")
}

// ===========================================================================
// Phase 8C — Results & Grading. Deliberately NOT modelled: rank (no ranking
// policy exists yet — deferred), GPA/CGPA (no grade-point policy exists),
// grace marks / attendance-eligibility / max-failed-subjects / min-overall-
// percent (all mock-only invented policy with zero real backing). V1 pass/fail
// policy (documented in lib/server/results/engine.ts): a student PASSes an
// exam when every non-exempt paper PASSes; FAILs if any non-exempt paper
// FAILs or is ABSENT; is ABSENT overall only if EVERY non-exempt paper is
// ABSENT; is INCOMPLETE if any required paper has no VERIFIED mark yet.
//
// GradingScheme is School + AcademicSession scoped (not per-Class, not
// per-Exam) — Exam.gradingSchemeId picks ONE explicit scheme per exam rather
// than duplicating bands per exam or silently auto-resolving by class.
//
// Results are DERIVED, never a second editable marks store: the result engine
// only ever reads Exam → ExamScheduleEntry → ExamMarkSheet(VERIFIED) →
// ExamMark. Before publication, results are computed LIVE (a preview) and
// never persisted. At publication, ExamResultPublication + StudentExamResult
// freeze an immutable snapshot — including the exact grading bands used — so
// a later grading-scheme edit or Subject/Staff/Enrollment change can never
// alter a historical published result. Existence of the ExamResultPublication
// row itself IS the "published" state — no separate DRAFT publication row is
// ever created, since preview never persists anything.
// ===========================================================================

enum GradingSchemeStatus {
  ACTIVE
  ARCHIVED
}

model GradingScheme {
  id                String              @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String
  name              String
  status            GradingSchemeStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  bands GradingBand[]
  exams Exam[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("grading_schemes")
}

// A percentage band, e.g. "A1" 91-100. Non-overlap and full-range validity are
// enforced transactionally by the reconcile endpoint (lib/server/results/
// grading-service.ts) — never trusted from the client alone.
model GradingBand {
  id              String  @id @default(cuid())
  gradingSchemeId String
  label           String
  minPercent      Int
  maxPercent      Int
  isPass          Boolean @default(true)
  color           String  @default("#18b0c8")
  order           Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  scheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@index([gradingSchemeId])
  @@map("grading_bands")
}

enum ExamResultStatus {
  PASS
  FAIL
  ABSENT
}

// At most one publication per Exam (@@unique) — re-publishing is refused
// (RESULT_ALREADY_PUBLISHED); a correction workflow is explicitly deferred.
model ExamResultPublication {
  id                   String   @id @default(cuid())
  tenantId             String
  schoolId             String
  academicSessionId    String
  examId               String   @unique
  gradingSchemeId      String
  gradingSchemeName    String // frozen name — a later scheme rename must not alter the historical record either
  gradingBandsSnapshot Json // frozen bands used at publish time — immutable even if the scheme is edited later
  studentCount         Int
  publishedByUserId    String
  publishedByName      String?
  publishedAt          DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  exam    Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  results StudentExamResult[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@map("exam_result_publications")
}

// A read-only historical snapshot — never exposes a PATCH path. Marks continue
// to live only in ExamMark; this is purely the frozen publication output.
model StudentExamResult {
  id                 String           @id @default(cuid())
  publicationId      String
  studentId          String
  enrollmentId       String?
  totalMaxMarks      Int
  totalMarksObtained Int
  percentage         Int
  grade              String?
  status             ExamResultStatus
  subjectResults     Json // array of per-paper breakdowns — see ExamSubjectResultDto in lib/api/contracts.ts

  // Phase 8D — Report Cards. The class/section context of the EXAM SCHEDULE at
  // publish time (from ExamScheduleEntry.sectionId, not live Enrollment), frozen
  // as plain scalars (no FK) so a later Class/Section rename, archive, or the
  // student's own Enrollment changing section/withdrawing can never alter a
  // published report card's historical class/section display. Null only for the
  // rare student with zero schedule entries at publish time.
  classId     String?
  className   String?
  sectionId   String?
  sectionName String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  publication ExamResultPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  student     Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment  Enrollment?           @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@unique([publicationId, studentId])
  @@index([publicationId])
  @@index([studentId])
  @@map("student_exam_results")
}

// ===========================================================================
// Phase 8E — Promotion / Academic-Year Transition.
//
// A StudentPromotion row is the explicit, auditable, ADMINISTRATIVE decision
// that a student moves from one AcademicSession to the next — never an
// automatic consequence of an exam result. Its existence for a given
// (studentId, fromAcademicSessionId, toAcademicSessionId) IS the decision: a
// row only gets created once PROMOTED or RETAINED is finalized (there is no
// persisted PENDING state — "pending" is simply the absence of a row for that
// transition, computed by the service layer from real candidate data).
//
// sourceExamId / sourcePublicationId / sourceStudentResultId are plain
// snapshot scalars (no FK), matching the ExamResultPublication.gradingSchemeName
// snapshot convention — the evidence a decision was based on must stay stable
// even if unrelated cleanup ever touches those rows, and Promotion must never
// be the reason a historical Exam/Publication/Result can't be modified.
// student/fromEnrollment/newEnrollment/targetClass/targetSection ARE real FKs
// (Restrict): once referenced by a promotion decision, none of these rows may
// be silently deleted out from under it.
// ===========================================================================

enum PromotionDecision {
  PROMOTED
  RETAINED
}

model StudentPromotion {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  fromAcademicSessionId String
  toAcademicSessionId   String

  studentId String

  fromEnrollmentId String
  newEnrollmentId  String @unique // 1:1 — the Enrollment this decision created

  // Snapshot references to the evidence this decision was based on — plain
  // scalars, deliberately NOT FKs (see note above).
  sourceExamId          String
  sourcePublicationId   String
  sourceStudentResultId String

  decision PromotionDecision

  targetClassId   String
  targetSectionId String

  processedByUserId String
  processedByName   String?
  processedAt       DateTime @default(now()) @db.Timestamptz(6)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student        Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  fromEnrollment Enrollment @relation("PromotionFromEnrollment", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  newEnrollment  Enrollment @relation("PromotionNewEnrollment", fields: [newEnrollmentId], references: [id], onDelete: Restrict)
  targetClass    Class      @relation(fields: [targetClassId], references: [id], onDelete: Restrict)
  targetSection  Section    @relation(fields: [targetSectionId], references: [id], onDelete: Restrict)

  // One decision per student per (from session -> to session) transition —
  // the concurrency-safety backstop alongside the transactional section-
  // capacity lock (see lib/server/promotion/service.ts).
  @@unique([studentId, fromAcademicSessionId, toAcademicSessionId])
  @@index([tenantId])
  @@index([schoolId, fromAcademicSessionId, toAcademicSessionId])
  @@index([studentId])
  @@index([targetClassId])
  @@index([targetSectionId])
  @@map("student_promotions")
}

// ===========================================================================
// Phase 9B — Homework / Assignments. One Homework targets exactly ONE real
// Section (Preferred V1 per the phase spec — no multi-section targeting, no
// per-student rows); students see it through real Enrollment(status=ENROLLED)
// in that section, never a duplicated per-student assignment row. Submissions/
// grading/attachments/parent-acknowledgement are deliberately NOT built here —
// no real student self-context or file-storage layer exists yet, and the
// phase spec explicitly excludes parent acknowledgement — so scoring/
// submissionType fields from the old mock are dropped, not carried forward.
//
// Authorship is a REAL Staff row with a REAL TeachingAssignment for
// (sectionId, subjectId) — teachingAssignmentId is Restrict (mirrors
// TimetableEntry's exact pattern) so removing that assignment while homework
// still references it fails closed instead of orphaning history.
// ===========================================================================

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Homework {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  sectionId            String
  subjectId            String
  staffId              String
  teachingAssignmentId String

  title        String
  description  String
  instructions String?

  dueAt  DateTime       @db.Date
  status HomeworkStatus @default(DRAFT)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section            Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff              Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([staffId])
  @@index([status])
  @@map("homework")
}

// ===========================================================================
// Phase 9C.1 — Curriculum / Syllabus Tracking. Content (Curriculum -> Unit ->
// Chapter -> Topic) is authored once per (Class, Subject, AcademicSession) —
// mirrors the existing mock UI's 3-level Unit/Chapter/Topic hierarchy
// (lib/types/academics.ts's CurriculumUnit/CurriculumChapter/CurriculumTopic).
// Progress is tracked separately, per Section (different sections of the same
// class progress at different speeds) via CurriculumTopicProgress — never a
// persisted percentage; always derived from real topic-progress rows. Unit/
// Chapter/Topic carry NO status column of their own — their displayed
// "status" is always computed from descendant CurriculumTopicProgress rows
// for whichever Section is in view (lib/server/curriculum/service.ts).
// ===========================================================================

enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TopicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Curriculum {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  academicSessionId String

  classId   String
  subjectId String

  title       String
  description String?
  status      CurriculumStatus @default(DRAFT)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  class   Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  units   CurriculumUnit[]

  // One curriculum per (class, subject) within a session — the real
  // ClassSubject applicability this must be validated against at creation.
  @@unique([schoolId, academicSessionId, classId, subjectId])
  @@index([tenantId])
  @@index([classId])
  @@index([subjectId])
  @@map("curricula")
}

model CurriculumUnit {
  id           String @id @default(cuid())
  curriculumId String

  title            String
  description      String?
  order            Int       @default(0)
  plannedStart     DateTime? @db.Date
  plannedEnd       DateTime? @db.Date
  estimatedPeriods Int       @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  curriculum Curriculum          @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  chapters   CurriculumChapter[]

  @@index([curriculumId])
  @@map("curriculum_units")
}

model CurriculumChapter {
  id     String @id @default(cuid())
  unitId String

  title String
  order Int    @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  unit   CurriculumUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topics CurriculumTopic[]

  @@index([unitId])
  @@map("curriculum_chapters")
}

model CurriculumTopic {
  id        String @id @default(cuid())
  chapterId String

  title            String
  order            Int      @default(0)
  learningOutcomes String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  chapter          CurriculumChapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress         CurriculumTopicProgress[]
  lessonPlanTopics LessonPlanTopic[] // Phase 9C.2 — lesson-plan syllabus mapping

  @@index([chapterId])
  @@map("curriculum_topics")
}

model CurriculumTopicProgress {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  sectionId String
  topicId   String

  status             TopicProgressStatus @default(NOT_STARTED)
  completedAt        DateTime?           @db.Timestamptz(6)
  completedByStaffId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section          Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic            CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  completedByStaff Staff?          @relation(fields: [completedByStaffId], references: [id], onDelete: SetNull)

  // One progress row per (section, topic) — upserted, never duplicated.
  @@unique([sectionId, topicId])
  @@index([tenantId])
  @@index([sectionId])
  @@index([topicId])
  @@map("curriculum_topic_progress")
}

// ===========================================================================
// Phase 9C.2 — Lesson Plans. A real teaching plan for one Staff teacher's
// TeachingAssignment on one date, optionally mapped to real CurriculumTopic
// row(s) via LessonPlanTopic (never free-floating topic names). Preserves the
// existing mock UI's draft -> submitted -> approved/rejected -> completed
// review workflow (lib/types/academics.ts's LessonPlanStatus / the real
// Academic-Coordinator approve/reject buttons already in app/academics/
// lesson-plans/page.tsx) — collapsed to the minimal real states that UI
// actually drives.
// ===========================================================================

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

model LessonPlan {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  sectionId            String
  subjectId            String
  staffId              String
  teachingAssignmentId String

  title             String
  learningObjective String
  teachingMethod    String
  materials         String?
  activity          String?
  homeworkNote      String?
  assessmentMethod  String?

  plannedDate DateTime         @db.Date
  period      Int?
  status      LessonPlanStatus @default(DRAFT)

  reviewedByUserId String?
  reviewedByName   String?
  reviewComment    String?

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  section            Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff              Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  topics             LessonPlanTopic[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([staffId])
  @@index([status])
  @@index([plannedDate])
  @@map("lesson_plans")
}

model LessonPlanTopic {
  lessonPlanId String
  topicId      String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  lessonPlan LessonPlan      @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  topic      CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([lessonPlanId, topicId])
  @@index([topicId])
  @@map("lesson_plan_topics")
}

// ===========================================================================
// Phase 9D.1 — Academic Calendar. ONLY manual, school-authored events are
// persisted here (CalendarEvent). Exam/Homework/LessonPlan calendar items are
// NEVER copied into this table — they are computed at query time from their
// own real tables (lib/server/calendar/service.ts) and identified by
// (sourceType, sourceId) rather than a CalendarEvent row, so there is exactly
// one truth for e.g. a Homework due date and the calendar can never drift
// from it. Audience is staff-only (ALL_STAFF/TEACHERS) — Student/Guardian
// have no linked User account in this system (see Notification section
// below), so there is no real identity to resolve a wider audience against.
// ===========================================================================

enum CalendarEventType {
  HOLIDAY
  MEETING
  PTM
  CELEBRATION
  ACTIVITY
  DEADLINE
  OTHER
}

enum CalendarEventAudience {
  ALL_STAFF
  TEACHERS
}

enum CalendarRecurrence {
  NONE
  WEEKLY
  YEARLY
}

enum CalendarEventStatus {
  ACTIVE
  CANCELLED
}

model CalendarEvent {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String?
  academicSessionId String

  title       String
  description String?
  eventType   CalendarEventType
  audience    CalendarEventAudience @default(ALL_STAFF)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  allDay    Boolean   @default(true)

  recurrence      CalendarRecurrence @default(NONE)
  recurrenceUntil DateTime?          @db.Date

  location String?
  status   CalendarEventStatus @default(ACTIVE)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([schoolId, academicSessionId, startDate])
  @@index([status])
  @@map("calendar_events")
}

// ===========================================================================
// Phase 9D.2 — In-app Notifications (V1: in-app only — no email/SMS/push).
// One Notification row per logical event (dedupeKey unique — see
// lib/server/notifications/service.ts's doc comment for the exact dedupe
// design), fanned out to real recipients via NotificationRecipient. Read
// state is per-recipient (never a single shared isRead flag). Recipients are
// always real User rows — Student/Guardian have no linked User account yet,
// so this system can only ever reach Staff with a linked User (Staff.userId)
// or other real platform users. sourceType/sourceId are plain snapshot
// strings, not FKs, so a Notification's history survives its source domain
// row being archived/deleted later (Restrict/Cascade FK entanglement across
// five+ unrelated domains would be unnecessary and fragile).
// ===========================================================================

enum NotificationType {
  LESSON_PLAN_APPROVED
  LESSON_PLAN_REJECTED
  EXAM_SCHEDULED
  CALENDAR_EVENT
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  VISITOR_CHECKED_IN
  MESSAGE_RECEIVED
  LIBRARY_BOOK_ISSUED
  LIBRARY_BOOK_RETURNED
  ASSET_ASSIGNED
  ASSET_RETURNED
  COUNSELING_CASE_ASSIGNED
  ACTIVITY_STAFF_ASSIGNED
}

model Notification {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  type  NotificationType
  title String
  body  String

  sourceType String?
  sourceId   String?
  href       String?

  // Stable per logical event (e.g. "LESSON_PLAN_APPROVED:<auditEventId>") —
  // the real retry/concurrency guarantee. See service doc comment.
  dedupeKey String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  recipients NotificationRecipient[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String @id @default(cuid())
  notificationId String
  userId         String

  readAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification_recipients")
}

// ===========================================================================
// Phase 9K — Communication / Messaging. Real User-to-User messaging — User.id
// is the canonical messaging identity (never Staff.id, never a name string).
// Student/Guardian have no linked User account yet, so they can never be a
// Conversation participant; that is a real limitation, not an oversight (see
// lib/server/communication/service.ts). V1 is DIRECT (1:1) only — GROUP is
// modelled for forward-compatibility but has no creation path yet, so it
// requires no participant-count validation beyond the schema itself.
//
// directKey is the DB-enforced concurrency guarantee against duplicate DIRECT
// threads: a deterministic `${tenantId}:${sortedUserIdA}:${sortedUserIdB}`
// string, unique, set only on DIRECT conversations (null on GROUP). Two
// concurrent "start direct conversation" calls race on this unique constraint;
// the loser's insert fails and the service re-fetches the winner's row — see
// startDirectConversation's doc comment.
//
// Unread state is ConversationParticipant.lastReadAt (no per-message read
// rows — V1 has no read-receipt UI requirement). Messages are immutable in
// V1 — no edit/delete workflow exists in the migrated UI, so none is modelled
// (see the phase's final report for the explicit decision).
// ===========================================================================

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id       String           @id @default(cuid())
  tenantId String
  schoolId String
  type     ConversationType
  title    String?

  createdByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  // Unique per-pair key for DIRECT conversations only (null for GROUP) — see
  // the domain doc comment above.
  directKey String? @unique

  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now()) @db.Timestamptz(6)
  lastReadAt     DateTime? @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One participant row per (conversation, user) — also the membership
  // authority: messaging RBAC (communication.send) gates feature access,
  // this table gates access to a SPECIFIC conversation.
  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ===========================================================================
// Phase 9E.1 — Staff Attendance. A separate domain from student AttendanceSession/
// AttendanceRecord (Phase 5/7C) — different entity (Staff, not Student), different
// grain (one row per staff per day, no periods/sections), no shared table. A
// missing StaffAttendanceRecord for a given staff+date is NOT_MARKED — never
// synthesized as ABSENT by a query. ON_LEAVE is set by the leave-approval flow
// (see LeaveRequest below) as the one honest crossover between the two domains;
// StaffAttendanceRecord otherwise never duplicates leave-request state.
// ===========================================================================

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

model StaffAttendanceRecord {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  staffId String
  date    DateTime @db.Date

  status     StaffAttendanceStatus
  checkInAt  DateTime?             @db.Timestamptz(6)
  checkOutAt DateTime?             @db.Timestamptz(6)
  notes      String?

  markedByUserId String
  markedByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // One attendance record per staff member per day — upserted, never duplicated.
  @@unique([staffId, date])
  @@index([tenantId])
  @@index([schoolId, branchId, date])
  @@index([staffId, date])
  @@map("staff_attendance_records")
}

// ===========================================================================
// Phase 9E.2 — Leave Management. LeaveRequest is the sole authority for staff
// leave; StaffAttendanceRecord.ON_LEAVE (above) is written FROM an approval
// here, never the reverse. Real Staff FK only — no free-floating name/email
// identity. Overlap prevention and the PENDING->APPROVED/REJECTED/CANCELLED
// lifecycle are enforced in lib/server/leave/service.ts (row-lock + conditional
// updateMany), not by a DB constraint Postgres can't express without extensions.
// ===========================================================================

enum LeaveTypeStatus {
  ACTIVE
  INACTIVE
}

model LeaveType {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  name        String
  code        String
  description String?
  isPaid      Boolean         @default(true)
  status      LeaveTypeStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  requests LeaveRequest[]

  // One leave-type code per school.
  @@unique([schoolId, code])
  @@index([tenantId])
  @@map("leave_types")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  staffId     String
  leaveTypeId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  halfDay   Boolean  @default(false)
  reason    String

  status LeaveRequestStatus @default(PENDING)

  requestedByUserId String
  requestedAt       DateTime @default(now()) @db.Timestamptz(6)

  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime? @db.Timestamptz(6)
  reviewNote       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId, branchId])
  @@index([staffId, status])
  @@index([staffId, startDate, endDate])
  @@index([status])
  @@map("leave_requests")
}

// ===========================================================================
// Phase 9F — Fees & Collections. Money is Prisma Decimal(12,2) end to end
// (never a JS float, matching the Super Admin billing domain's Invoice/
// Payment precedent) — arithmetic happens with Prisma.Decimal.plus/minus in
// the service layer, and every DTO serializes to a plain number only at the
// API boundary. `currency` is a per-row ISO-4217 snapshot defaulting to the
// school's own currency (same pattern as Invoice/Subscription).
//
// SCOPE: this is a deliberately smaller, flatter model than a full ERP fee
// engine. One FeeStructureItem already carries its own dueDate, so it is
// simultaneously "the fee type" and "the installment" — there is no separate
// component/installment split, no tax/proration/versioning layer. Discount,
// Scholarship and Late Fee all reduce/increase a FeeCharge through the SAME
// FeeAdjustment table (kind discriminates them) — one canonical balance
// formula, never three parallel ones. See lib/server/fees/service.ts's doc
// comment for the exact formula and for what was deliberately deferred
// (credit balances/advance payment, reminder automation, payment gateways,
// bank-feed reconciliation) and why.
//
// HISTORICAL SAFETY: FeeCharge snapshots categoryName/itemName/amount/dueDate
// at assignment time — renaming/archiving a FeeCategory or editing a
// FeeStructureItem later never rewrites an already-billed student's history.
// FeeCharge is scoped by studentId + academicSessionId (not by Enrollment),
// so a later class/section transfer never touches it either.
// ===========================================================================

enum FeeCategoryStatus {
  ACTIVE
  ARCHIVED
}

model FeeCategory {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  name        String
  code        String
  description String?
  status      FeeCategoryStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items FeeStructureItem[]

  // One category code per school. Archival (not delete) is the only lifecycle —
  // historical FeeStructureItem/FeeCharge snapshots survive either way.
  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("fee_categories")
}

enum FeeStructureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model FeeStructure {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  name        String
  description String?
  currency    String             @default("INR")
  status      FeeStructureStatus @default(DRAFT)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items       FeeStructureItem[]
  classes     FeeStructureClass[]
  assignments StudentFeeAssignment[]

  @@unique([schoolId, academicSessionId, name])
  @@index([tenantId])
  @@index([schoolId, academicSessionId, status])
  @@map("fee_structures")
}

/**
 * Real Class targeting — never a class name/label. Empty (no rows) is not a
 * valid state for an ACTIVE structure; the service requires at least one.
 */
model FeeStructureClass {
  id             String @id @default(cuid())
  feeStructureId String
  classId        String

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([feeStructureId, classId])
  @@index([classId])
  @@map("fee_structure_classes")
}

model FeeStructureItem {
  id             String @id @default(cuid())
  feeStructureId String
  categoryId     String

  name    String?
  amount  Decimal  @db.Decimal(12, 2)
  dueDate DateTime @db.Date
  order   Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  category     FeeCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  charges      FeeCharge[]

  @@index([feeStructureId])
  @@index([categoryId])
  @@map("fee_structure_items")
}

enum FeeAssignmentStatus {
  ACTIVE
  WITHDRAWN
}

/**
 * The billing act itself — links one real Student to one real FeeStructure
 * for its session. Generates one FeeCharge per FeeStructureItem (idempotent —
 * see the unique constraint on FeeCharge below). enrollmentId is the real
 * Enrollment the assignment was resolved against when targeting a class/
 * section in bulk (optional: an individual assignment may not go through a
 * section-bulk flow), kept for traceability only — never re-validated after
 * the fact, since a later transfer must not retroactively invalidate history.
 */
model StudentFeeAssignment {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  studentId      String
  enrollmentId   String?
  feeStructureId String

  status FeeAssignmentStatus @default(ACTIVE)

  assignedByUserId String
  assignedByName   String?
  assignedAt       DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  charges      FeeCharge[]

  // Idempotent bulk assignment: re-running the same structure+student is a
  // no-op, never a duplicate.
  @@unique([studentId, feeStructureId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId])
  @@map("student_fee_assignments")
}

/**
 * The finest-grained billable unit — real Student, real snapshot amount/
 * dueDate/category name (never re-read live from FeeCategory/FeeStructureItem,
 * so an edit or archive there can never rewrite an already-billed student's
 * history). No persisted balance/status column — see
 * lib/server/fees/service.ts's chargeBalance() for the single canonical
 * derivation from amount + adjustments + allocations.
 */
model FeeCharge {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  assignmentId       String
  studentId          String
  feeStructureItemId String?

  categoryName String
  itemName     String?
  amount       Decimal  @db.Decimal(12, 2)
  dueDate      DateTime @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  assignment       StudentFeeAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureItem FeeStructureItem?      @relation(fields: [feeStructureItemId], references: [id], onDelete: SetNull)
  adjustments      FeeAdjustment[]
  allocations      FeePaymentAllocation[]

  // One charge per structure item per assignment — the idempotency guarantee
  // for bulk assignment.
  @@unique([assignmentId, feeStructureItemId])
  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId, dueDate])
  @@map("fee_charges")
}

enum FeeAdjustmentKind {
  DISCOUNT
  SCHOLARSHIP
  LATE_FEE
}

enum FeeAdjustmentAmountType {
  FIXED
  PERCENTAGE
}

/**
 * The ONE canonical adjustment engine for discounts, scholarships and late
 * fees — `kind` discriminates the business concept (and its sign: DISCOUNT/
 * SCHOLARSHIP reduce the balance, LATE_FEE increases it — see chargeBalance()),
 * `computedAmount` is the resolved absolute amount snapshotted at apply time
 * (so a later change to `value`/amountType is impossible — there is no
 * update endpoint, only apply). Never silently mutates FeeCharge.amount.
 */
model FeeAdjustment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  chargeId String
  kind     FeeAdjustmentKind

  amountType     FeeAdjustmentAmountType
  value          Decimal                 @db.Decimal(12, 2) // the fixed amount, or the percentage number (e.g. 10 for 10%)
  computedAmount Decimal                 @db.Decimal(12, 2) // resolved absolute amount at apply time

  reason String

  appliedByUserId String
  appliedByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  charge FeeCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([chargeId])
  @@index([schoolId, kind])
  @@map("fee_adjustments")
}

enum FeePaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum FeeReconciliationStatus {
  UNRECONCILED
  RECONCILED
  MISMATCH
}

/**
 * A real collection event. receiptNumber IS the receipt — there is no
 * separate Receipt model (a payment always has exactly one, immutable). All
 * non-CASH methods here are manually RECORDED (no gateway ever touches this
 * row) — see the service doc comment.
 */
model FeePayment {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  studentId String

  receiptNumber String           @unique
  amount        Decimal          @db.Decimal(12, 2)
  currency      String           @default("INR")
  method        FeePaymentMethod
  paymentDate   DateTime         @db.Date

  reference    String?
  chequeNumber String?
  chequeDate   DateTime? @db.Date
  bankName     String?
  notes        String?

  receivedByUserId String
  receivedByName   String?

  reconciliationStatus FeeReconciliationStatus @default(UNRECONCILED)
  reconciledByUserId   String?
  reconciledByName     String?
  reconciledAt         DateTime?               @db.Timestamptz(6)
  reconciliationNote   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations FeePaymentAllocation[]
  refunds     FeeRefund[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId])
  @@index([studentId])
  @@index([schoolId, paymentDate])
  @@index([reconciliationStatus])
  @@map("fee_payments")
}

/**
 * Connects a payment to the real charge(s) it settles — a payment may cover
 * multiple charges, and a charge may be settled across multiple payments
 * (partial payments).
 */
model FeePaymentAllocation {
  id        String @id @default(cuid())
  paymentId String
  chargeId  String

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  FeeCharge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("fee_payment_allocations")
}

model FeeRefund {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  paymentId String
  amount    Decimal @db.Decimal(12, 2)
  reason    String

  refundedByUserId String
  refundedByName   String?
  refundedAt       DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([paymentId])
  @@map("fee_refunds")
}

/**
 * Race-safe, school-scoped receipt sequence. `UPDATE ... SET counter =
 * counter + 1 RETURNING counter` is atomic in Postgres — no separate row
 * lock needed, unlike the balance-mutation transactions elsewhere in this
 * domain.
 */
model FeeReceiptCounter {
  schoolId String @id
  counter  Int    @default(0)

  @@map("fee_receipt_counters")
}

// ===========================================================================
// Phase 9G — Accounting / General Ledger. Conventional double-entry: every
// AccountingAccount has a type (ASSET/LIABILITY/EQUITY/INCOME/EXPENSE);
// every JournalEntry carries >=2 JournalLine rows whose debits equal credits
// once POSTED (enforced server-side in lib/server/accounting/journals.ts,
// never trusted from the client). Posted entries are immutable — a
// correction is always a new reversal entry with every line's debit/credit
// swapped, never an edit.
//
// ACCOUNTING BASIS: CASH basis. No Fee Receivable is recognized at charge/
// assignment time — Phase 9F's dues/outstanding tracking is an operational
// AR sub-ledger, not a formal accounting receivable, and inventing accrual
// recognition here would silently diverge from how the product already
// behaves. A journal is posted only at the two real cash-moving Fee events:
// FeePayment and FeeRefund. Discount/Scholarship/LateFee still get their own
// traceable ledger lines (not silently netted in a report) by prorating each
// payment's amount across its settled charge(s)' own gross/discount/
// scholarship/lateFee composition at that moment — see
// lib/server/accounting/fee-posting.ts's doc comment for the exact formula.
// A charge that is never paid (e.g. a 100% waiver) therefore never produces
// an accounting entry — a known, documented cash-basis limitation.
//
// FEES REMAIN AUTHORITATIVE: this domain never re-implements or overrides
// FeePayment/FeeAdjustment/FeeRefund/reconciliation — it only records their
// accounting EFFECT, via a real sourceType+sourceId+sourceEventId trail.
// Automatic posting is idempotent: sourceEventId is DB-unique per school, so
// two concurrent attempts to post the same Fee event can never create two
// journals (the loser's insert fails the constraint and is treated as
// already-posted, not an error).
// ===========================================================================

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountingAccountStatus {
  ACTIVE
  ARCHIVED
}

/**
 * systemKey identifies an account a real posting rule depends on (e.g. the
 * generic cash-receipt account) — stable and never matched by name. Nullable
 * (Postgres allows multiple NULLs under a unique index) since most accounts
 * are ordinary user-created ledger accounts with no system role.
 */
model AccountingAccount {
  id       String  @id @default(cuid())
  tenantId String
  schoolId String
  branchId String?

  code        String
  name        String
  type        AccountingAccountType
  parentId    String?
  description String?
  status      AccountingAccountStatus @default(ACTIVE)
  systemKey   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  parent   AccountingAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AccountingAccount[] @relation("AccountHierarchy")
  lines    JournalLine[]

  // One code per school; systemKey (when set) is also unique per school.
  @@unique([schoolId, code])
  @@unique([schoolId, systemKey])
  @@index([tenantId])
  @@index([schoolId, type, status])
  @@map("accounting_accounts")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalSourceType {
  MANUAL
  FEE_PAYMENT
  FEE_REFUND
  PAYROLL_PAYMENT
}

/**
 * One accounting transaction. `sourceEventId` (school-unique when set) is
 * the idempotency key for automatic Fee postings — see the domain doc
 * comment above. `reversalOfId` is DB-unique so a given entry can be
 * reversed at most once, even under a concurrent double-click.
 */
model JournalEntry {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String?

  entryNumber String
  entryDate   DateTime           @db.Date
  description String
  status      JournalEntryStatus @default(POSTED)

  sourceType    JournalSourceType
  sourceId      String?
  sourceEventId String?

  reversalOfId String?

  createdByUserId String
  createdByName   String?
  postedAt        DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  lines      JournalLine[]
  reversalOf JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy JournalEntry[] @relation("Reversal")

  @@unique([schoolId, entryNumber])
  @@unique([schoolId, sourceEventId])
  @@unique([reversalOfId])
  @@index([tenantId])
  @@index([schoolId, entryDate])
  @@index([schoolId, sourceType, sourceId])
  @@index([status])
  @@map("journal_entries")
}

/**
 * A line can never have both debit and credit > 0, nor both zero — enforced
 * in lib/server/accounting/journals.ts (a DB CHECK is not expressible for
 * "exactly one of two Decimal columns is positive" without a raw migration
 * addition, so the invariant is enforced at the single write path instead —
 * there is no other way to create a JournalLine).
 */
model JournalLine {
  id             String @id @default(cuid())
  journalEntryId String
  accountId      String

  debit  Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2)

  description String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  journalEntry JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      AccountingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

/**
 * Race-safe, school-scoped journal-entry sequence — same atomic
 * `UPDATE ... RETURNING` strategy as FeeReceiptCounter.
 */
model AccountingEntryCounter {
  schoolId String @id
  counter  Int    @default(0)

  @@map("accounting_entry_counters")
}

// ===========================================================================
// Phase 9H — Payroll. Uses the REAL Staff model (Phase 6A) as the sole
// employee identity — no second Employee/HR model. Uses the REAL
// StaffAttendanceRecord (9E.1) and LeaveRequest (9E.2) as DISPLAY-ONLY
// context on a payroll snapshot — neither ever changes a calculated amount.
// Posts to the REAL Phase 9G JournalEntry/JournalLine ledger — no parallel
// accounting engine.
//
// PAYROLL V1 POLICY (deliberately minimal — see the Phase 9H final report for
// the full audit):
//   - Monthly frequency. One PayrollRun per (schoolId, branchId, year, month),
//     DB-unique.
//   - Salary is a FIXED reusable SalaryStructure (EARNING/DEDUCTION
//     components, FIXED or PERCENTAGE-of-another-component-in-the-same-
//     structure) assigned to a Staff via an effective-dated
//     StaffSalaryAssignment. grossEarnings = sum(EARNING), totalDeductions =
//     sum(DEDUCTION), netPay = grossEarnings - totalDeductions. No
//     attendance- or leave-based deduction: this repo has no working-day-
//     calendar / per-day-rate / LOP-conversion policy, so attendance and
//     leave are captured on PayrollRunItem purely as informational summary
//     counts (never read by the calculation). Manual per-run adjustments
//     (bonus/allowance/deduction/reimbursement) are plain flat-amount
//     PayrollRunItemComponent rows with source=MANUAL — never a computed
//     rule.
//   - Lifecycle: DRAFT -> CALCULATED -> FINALIZED -> PAID. Calculating
//     replaces this run's PayrollRunItem/PayrollRunItemComponent rows
//     (idempotent) until FINALIZED; a FINALIZED run's snapshot is immutable
//     — corrections are a new run or a reversal journal, never an edit.
//     Finalize/pay use a `SELECT ... FOR UPDATE` lock on the PayrollRun row
//     (same pattern as Phase 9E's leave-overlap check and Phase 8E's
//     promotion capacity lock) so two concurrent transitions can never both
//     succeed.
//   - Payment is RECORDING only (PayrollPayment), never a real bank
//     transfer — one PayrollPayment per PayrollRun (@@unique), whole-run
//     payment only, no partial disbursement in V1.
//   - Accounting recognition point mirrors Fees' CASH basis: a JournalEntry
//     posts only when a PayrollPayment is recorded (never merely on
//     finalize) — Debit PAYROLL_EXPENSE, Credit the existing Phase 9G BANK
//     system account (no duplicate clearing account invented). Idempotent
//     via the same sourceEventId ("PAYROLL_PAYMENT:<id>") uniqueness Fees
//     uses.
//   - Explicitly DEFERRED, not invented: PF/ESI/TDS/Professional Tax/
//     gratuity/overtime, loans/advances, attendance- or leave-based salary
//     deduction, department/designation-grouped reports (Staff.department/
//     designation are free-text, not a real dimension entity), payslip
//     PAN/UAN/ESI/bank-account fields, PDF generation (browser print only).
// ===========================================================================

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum SalaryComponentCalcType {
  FIXED
  PERCENTAGE
}

enum SalaryComponentStatus {
  ACTIVE
  ARCHIVED
}

/**
 * A reusable earning/deduction line definition. Archived components remain
 * readable (never deleted) so historical PayrollRunItemComponent snapshots
 * that reference one stay resolvable.
 */
model SalaryComponent {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  code        String
  name        String
  type        SalaryComponentType
  calcType    SalaryComponentCalcType
  description String?
  status      SalaryComponentStatus   @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  structureLines SalaryStructureComponent[]
  payrollLines   PayrollRunItemComponent[]

  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("salary_components")
}

enum SalaryStructureStatus {
  ACTIVE
  ARCHIVED
}

/**
 * A reusable named bundle of components. Structural edits (component list)
 * are only allowed while it has zero StaffSalaryAssignment rows — once
 * assigned, it is financially live and only name/description/status remain
 * editable (mirrors lib/server/fees/structures.ts's FeeStructure exactly).
 */
model SalaryStructure {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  name        String
  description String?
  status      SalaryStructureStatus @default(ACTIVE)

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  components  SalaryStructureComponent[]
  assignments StaffSalaryAssignment[]

  @@unique([schoolId, name])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("salary_structures")
}

/**
 * One component line within a structure. Exactly one of `amount` /
 * (`percent` + `percentOfComponentId`) is set, matching calcType — enforced
 * in lib/server/payroll/structures.ts, not expressible as a DB CHECK across
 * a self-referencing FK. `percentOfComponentId` must reference another line
 * in the SAME structure.
 */
model SalaryStructureComponent {
  id                String   @id @default(cuid())
  salaryStructureId String
  salaryComponentId String
  amount            Decimal? @db.Decimal(12, 2)
  percent           Decimal? @db.Decimal(5, 2)
  percentOfLineId   String?
  order             Int      @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  salaryStructure SalaryStructure            @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent            @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)
  percentOfLine   SalaryStructureComponent?  @relation("PercentBase", fields: [percentOfLineId], references: [id], onDelete: SetNull)
  percentBasisFor SalaryStructureComponent[] @relation("PercentBase")

  // One line per component per structure — never duplicated.
  @@unique([salaryStructureId, salaryComponentId])
  @@index([salaryStructureId])
  @@map("salary_structure_components")
}

/**
 * Effective-dated assignment of a real Staff to a real SalaryStructure. A
 * salary change is always a NEW row (effectiveTo set on the old one) — never
 * a mutation of history. Overlap prevention is enforced in
 * lib/server/payroll/assignments.ts via a `SELECT ... FOR UPDATE` lock on the
 * Staff row (same pattern as Phase 9E's leave-overlap check), not a DB
 * constraint Postgres can't express without extensions.
 */
model StaffSalaryAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  staffId           String
  salaryStructureId String

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  staff           Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([staffId, effectiveFrom])
  @@index([schoolId, branchId])
  @@map("staff_salary_assignments")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  FINALIZED
  PAID
}

/**
 * One payroll period for one branch. `year`/`month` are the period identity
 * (never derived from createdAt). FINALIZED is the immutability boundary —
 * see the section doc comment above for the full lifecycle/concurrency
 * rationale.
 */
model PayrollRun {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  year  Int
  month Int // 1-12

  status PayrollRunStatus @default(DRAFT)

  totalGross      Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  totalNet        Decimal @default(0) @db.Decimal(14, 2)

  createdByUserId String
  createdByName   String?
  calculatedAt    DateTime? @db.Timestamptz(6)
  finalizedAt     DateTime? @db.Timestamptz(6)
  finalizedByName String?
  paidAt          DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items   PayrollRunItem[]
  payment PayrollPayment?

  // One run per branch per period — never duplicated.
  @@unique([schoolId, branchId, year, month])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("payroll_runs")
}

/**
 * One immutable-once-FINALIZED payroll snapshot per Staff per run. Staff
 * name/code and structure name are captured here as historical DISPLAY
 * snapshots (real staffId/salaryStructureId FKs remain the relationship
 * authority) so a later Staff rename or structure edit can never alter a
 * generated payslip. Attendance/leave counts are informational only —
 * NEVER an input to grossEarnings/totalDeductions/netPay.
 */
model PayrollRunItem {
  id           String @id @default(cuid())
  payrollRunId String

  staffId             String
  employeeCode        String
  staffName           String
  salaryStructureId   String?
  salaryStructureName String?

  grossEarnings   Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netPay          Decimal @db.Decimal(12, 2)

  // Informational attendance/leave summary for the run's period — display only.
  presentDays     Int @default(0)
  absentDays      Int @default(0)
  lateDays        Int @default(0)
  halfDays        Int @default(0)
  onLeaveDays     Int @default(0)
  notMarkedDays   Int @default(0)
  paidLeaveDays   Int @default(0)
  unpaidLeaveDays Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  payrollRun PayrollRun                @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      Staff                     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  components PayrollRunItemComponent[]

  // One snapshot per staff per run — recalculation replaces, never duplicates.
  @@unique([payrollRunId, staffId])
  @@index([staffId])
  @@map("payroll_run_items")
}

enum PayrollComponentSource {
  STRUCTURE
  MANUAL
}

/**
 * One frozen component line within a PayrollRunItem snapshot. `componentId`
 * is kept for traceability but componentName/type are snapshotted so a later
 * SalaryComponent rename never rewrites a finalized payslip line.
 */
model PayrollRunItemComponent {
  id               String @id @default(cuid())
  payrollRunItemId String

  componentId   String?
  componentName String
  type          SalaryComponentType
  amount        Decimal             @db.Decimal(12, 2)

  source          PayrollComponentSource @default(STRUCTURE)
  manualReason    String?
  createdByUserId String?
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payrollRunItem PayrollRunItem   @relation(fields: [payrollRunItemId], references: [id], onDelete: Cascade)
  component      SalaryComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([payrollRunItemId])
  @@map("payroll_run_item_components")
}

enum PayrollPaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

/**
 * Records that a FINALIZED run's total was paid — never initiates a real
 * bank transfer (no gateway/bank-feed integration exists). One row per run
 * (@@unique) — whole-run payment only; two concurrent attempts race on this
 * constraint, so exactly one can ever succeed.
 */
model PayrollPayment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  payrollRunId String @unique

  amount      Decimal              @db.Decimal(14, 2)
  paymentDate DateTime             @db.Date
  method      PayrollPaymentMethod
  reference   String?

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([schoolId, branchId])
  @@map("payroll_payments")
}

// ===========================================================================
// Phase 9I — Visitor Management. Audited existing mock: app/front-desk/
// visitors/* (walk-in check-in + status list) and app/front-desk/
// appointments/* (a read-only "expected visitor" schedule). Both are folded
// into ONE model, VisitorVisit, per the phase's own instruction — no
// parallel Appointment domain. app/front-desk/gate-passes (a broader
// student/staff/material/vehicle pass system, not visitor-specific) and
// calls/deliveries/incidents are separate Front Desk sub-domains, untouched.
// No blacklist/watchlist UI or concept exists anywhere in the repo — none is
// invented here (see the Phase 9I final report).
//
// Visitor is the person; VisitorVisit is one visit by that person. A host is
// a real Staff FK (VisitorVisit.hostStaffId) — never a name string; the mock
// UI made host selection mandatory, so this FK is required, not nullable.
// No identity-document fields (ID type/number, photo) are stored — the old
// mock UI's own copy already says "ID verification is a front-desk step;
// document scanning/storage is not part of this frontend build," and no real
// storage mechanism exists to justify adding them now.
//
// LIFECYCLE: EXPECTED -> CHECKED_IN -> CHECKED_OUT, or EXPECTED/CHECKED_IN ->
// CANCELLED. The old mock's WAITING/MEETING/DENIED status values were never
// actually produced by any real mutation (checkInVisitor() always set
// "checked-in" directly) — dropped as unused-in-practice, not a real product
// requirement. Enforced by lib/server/visitors/visits.ts, never client-side.
//
// PASS NUMBER: server-generated via the same race-safe school-scoped
// `UPDATE ... RETURNING counter` pattern as FeeReceiptCounter/
// AccountingEntryCounter — VisitorPassCounter below. Format
// VIS-<schoolCode>-<year>-<counter>.
// ===========================================================================

model Visitor {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  fullName     String
  phone        String
  organization String?
  notes        String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  visits VisitorVisit[]

  @@index([tenantId])
  @@index([schoolId, phone])
  @@map("visitors")
}

enum VisitorCategory {
  PARENT
  VENDOR
  GUEST
  CONTRACTOR
  INTERVIEW_CANDIDATE
  ALUMNI
  OFFICIAL
  OTHER
}

enum VisitorVisitStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model VisitorVisit {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  visitorId   String
  hostStaffId String

  category      VisitorCategory @default(GUEST)
  purpose       String
  department    String?
  vehicleNumber String?

  status VisitorVisitStatus @default(EXPECTED)

  expectedAt   DateTime? @db.Timestamptz(6)
  checkedInAt  DateTime? @db.Timestamptz(6)
  checkedOutAt DateTime? @db.Timestamptz(6)
  passNumber   String?

  createdByUserId String
  createdByName   String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  host    Staff   @relation(fields: [hostStaffId], references: [id], onDelete: Restrict)

  @@unique([schoolId, passNumber])
  @@index([tenantId])
  @@index([schoolId, branchId, status])
  @@index([schoolId, status, expectedAt])
  @@index([visitorId])
  @@index([hostStaffId])
  @@map("visitor_visits")
}

/**
 * Race-safe, school-scoped visitor-pass sequence — same atomic
 * `UPDATE ... RETURNING` strategy as FeeReceiptCounter/AccountingEntryCounter.
 */
model VisitorPassCounter {
  schoolId String @id
  counter  Int    @default(0)

  @@map("visitor_pass_counters")
}

// ===========================================================================
// Phase 9M — Transport Management. Reuses real identities throughout: drivers
// and attendants are real Staff (Staff.id, never a parallel Driver/Employee
// model); students resolve through real Student.id, session-scoped via
// academicSessionId; no fake GPS/telemetry, no second fee engine (Phase 9F
// remains canonical — transport fees are deferred, not modelled here).
//
// TransportRouteAssignment is the "current + historical" vehicle/driver/
// attendant combo for a route, effective-dated rather than a fixed pointer on
// Route itself (so past trips keep their true historical crew even after the
// route is reassigned) — a partial unique index (added by hand in the
// migration SQL, not expressible as a Prisma @@unique) keeps at most one
// ACTIVE row per route, mirroring Phase 7C's AttendanceSession.type pattern.
//
// TransportTrip snapshots vehicleId/driverStaffId/attendantStaffId from the
// route's effective assignment AT CREATION TIME — never re-read live — so a
// later crew change never rewrites a trip's own history.
//
// TransportTripStudent boarding/drop is intentionally NOT student academic
// attendance (Phase 5/7C) — a separate, smaller state machine scoped to one
// trip, seeded from the real active StudentTransportAssignment roster.
// ===========================================================================

enum TransportVehicleType {
  BUS
  MINI_BUS
  VAN
  CAR
  ELECTRIC_VEHICLE
  CONTRACT_VEHICLE
  CUSTOM
}

enum TransportVehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

model TransportVehicle {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  registrationNumber String
  displayName        String? // fleet number / nickname — display only
  type               TransportVehicleType   @default(BUS)
  make               String?
  model              String?
  capacity           Int
  status             TransportVehicleStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  routeAssignments TransportRouteAssignment[]
  trips            TransportTrip[]

  // Registration number unique within the school — the real concurrency
  // guarantee against duplicate vehicle registration (a race-losing insert
  // fails on this constraint; see createVehicle's doc comment).
  @@unique([schoolId, registrationNumber])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("transport_vehicles")
}

enum TransportShift {
  MORNING
  AFTERNOON
  EVENING
  BOTH
}

enum TransportRouteDirection {
  PICKUP
  DROP
  BOTH
}

enum TransportRouteStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model TransportRoute {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  name      String
  code      String
  shift     TransportShift          @default(MORNING)
  direction TransportRouteDirection @default(BOTH)
  capacity  Int?
  status    TransportRouteStatus    @default(DRAFT)
  notes     String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  routeStops         TransportRouteStop[]
  assignments        TransportRouteAssignment[]
  studentAssignments StudentTransportAssignment[]
  staffAssignments   StaffTransportAssignment[]
  trips              TransportTrip[]

  @@unique([schoolId, code])
  @@index([tenantId])
  @@index([schoolId, status])
  @@map("transport_routes")
}

enum TransportStopStatus {
  ACTIVE
  TEMPORARY
  UNSAFE
  INACTIVE
}

model TransportStop {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  name        String
  code        String
  address     String
  landmark    String?
  status      TransportStopStatus @default(ACTIVE)
  safetyNotes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  routeStops         TransportRouteStop[]
  pickupAssignments  StudentTransportAssignment[] @relation("TransportPickupStop")
  dropAssignments    StudentTransportAssignment[] @relation("TransportDropStop")
  staffAssignments   StaffTransportAssignment[]
  tripStudentStops   TransportTripStudent[]
  transportTripStops TransportTripStop[]

  @@unique([schoolId, code])
  @@index([tenantId])
  @@map("transport_stops")
}

/**
 * A stop's role on one specific route (sequence, timing) — the same physical
 * TransportStop can appear on multiple routes with different sequence/timing
 * via separate rows here. Sequence is application-managed (ORDER BY), not a
 * DB-unique tuple, so an atomic multi-row reorder never transiently collides
 * with itself inside one transaction.
 */
model TransportRouteStop {
  id       String @id @default(cuid())
  tenantId String
  routeId  String
  stopId   String

  sequence   Int
  pickupTime String? // "HH:MM", manually set — never computed/estimated
  dropTime   String?

  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  TransportStop  @relation(fields: [stopId], references: [id], onDelete: Restrict)

  // A given physical stop appears on a route at most once.
  @@unique([routeId, stopId])
  @@index([tenantId])
  @@index([routeId, sequence])
  @@map("transport_route_stops")
}

enum TransportAssignmentStatus {
  ACTIVE
  ENDED
}

/**
 * The effective-dated vehicle + driver (Staff) + attendant (Staff) combo for
 * a route — see the domain doc comment above for why this isn't a fixed
 * pointer on TransportRoute.
 */
model TransportRouteAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  routeId          String
  vehicleId        String
  driverStaffId    String?
  attendantStaffId String?

  status        TransportAssignmentStatus @default(ACTIVE)
  effectiveFrom DateTime                  @db.Date
  effectiveTo   DateTime?                 @db.Date

  createdByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  route     TransportRoute   @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicle   TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver    Staff?           @relation("TransportRouteDriver", fields: [driverStaffId], references: [id], onDelete: SetNull)
  attendant Staff?           @relation("TransportRouteAttendant", fields: [attendantStaffId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([routeId, status])
  @@index([vehicleId])
  @@map("transport_route_assignments")
}

enum StudentTransportStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

model StudentTransportAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  academicSessionId String
  studentId         String
  enrollmentId      String?
  routeId           String
  pickupStopId      String
  dropStopId        String

  status        StudentTransportStatus @default(ACTIVE)
  effectiveFrom DateTime               @db.Date
  effectiveTo   DateTime?              @db.Date

  createdByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route       TransportRoute         @relation(fields: [routeId], references: [id], onDelete: Restrict)
  pickupStop  TransportStop          @relation("TransportPickupStop", fields: [pickupStopId], references: [id], onDelete: Restrict)
  dropStop    TransportStop          @relation("TransportDropStop", fields: [dropStopId], references: [id], onDelete: Restrict)
  tripRecords TransportTripStudent[]

  @@index([tenantId])
  @@index([schoolId, academicSessionId, status])
  @@index([routeId])
  @@index([studentId])
  @@map("student_transport_assignments")
}

model StaffTransportAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  staffId      String
  routeId      String
  pickupStopId String

  status        StudentTransportStatus @default(ACTIVE)
  effectiveFrom DateTime               @db.Date
  effectiveTo   DateTime?              @db.Date

  createdByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  staff Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop  TransportStop  @relation(fields: [pickupStopId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([staffId])
  @@map("staff_transport_assignments")
}

enum TransportTripType {
  PICKUP
  DROP
}

enum TransportTripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TransportTrip {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  routeId          String
  // Snapshotted from the route's effective TransportRouteAssignment at
  // creation time — see the domain doc comment above.
  vehicleId        String
  driverStaffId    String?
  attendantStaffId String?

  date   DateTime            @db.Date
  type   TransportTripType
  status TransportTripStatus @default(SCHEDULED)

  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  createdByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  route        TransportRoute         @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicle      TransportVehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver       Staff?                 @relation("TransportTripDriver", fields: [driverStaffId], references: [id], onDelete: SetNull)
  attendant    Staff?                 @relation("TransportTripAttendant", fields: [attendantStaffId], references: [id], onDelete: SetNull)
  stops        TransportTripStop[]
  tripStudents TransportTripStudent[]

  // One trip per route per date per type — the real concurrency guarantee
  // against a duplicate trip being created twice.
  @@unique([routeId, date, type])
  @@index([tenantId])
  @@index([schoolId, date])
  @@index([vehicleId])
  @@map("transport_trips")
}

enum TransportTripStopStatus {
  PENDING
  ARRIVED
  DEPARTED
}

/**
 * Seeded from the route's TransportRouteStop order at trip creation — a
 * snapshot, so a later route stop-order edit never rewrites a past trip's
 * own timeline.
 */
model TransportTripStop {
  id     String @id @default(cuid())
  tripId String
  stopId String

  sequence Int
  status   TransportTripStopStatus @default(PENDING)

  arrivedAt  DateTime? @db.Timestamptz(6)
  departedAt DateTime? @db.Timestamptz(6)

  trip TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop TransportStop @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@unique([tripId, stopId])
  @@index([tripId, sequence])
  @@map("transport_trip_stops")
}

enum TransportBoardingStatus {
  EXPECTED
  BOARDED
  ABSENT
}

enum TransportDropStatus {
  ONBOARD
  DROPPED
}

/**
 * Per-student, per-trip boarding/drop — seeded from the real ACTIVE
 * StudentTransportAssignment roster at trip creation. Deliberately NOT
 * student academic attendance (Phase 5/7C AttendanceRecord) — a separate,
 * smaller domain, never auto-synced.
 */
model TransportTripStudent {
  id           String @id @default(cuid())
  tripId       String
  studentId    String
  assignmentId String
  stopId       String

  boardingStatus TransportBoardingStatus @default(EXPECTED)
  dropStatus     TransportDropStatus     @default(ONBOARD)
  boardedAt      DateTime?               @db.Timestamptz(6)
  droppedAt      DateTime?               @db.Timestamptz(6)
  markedByUserId String?

  trip       TransportTrip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student    Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment StudentTransportAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  stop       TransportStop              @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@unique([tripId, studentId])
  @@index([tripId])
  @@map("transport_trip_students")
}

// ===========================================================================
// Phase 9N — Library Management. Reuses real identities throughout: a
// borrower is always a real Student.id or Staff.id — there is deliberately
// NO separate LibraryMember identity model (the audit found no real product
// need for membership numbers/join workflow beyond eligibility). Catalog
// identity (LibraryBook, the title) is separate from physical-copy identity
// (LibraryBookCopy, the lendable item) per the phase's own explicit rule.
// Author/publisher/category are kept as plain text fields on LibraryBook,
// not normalized entities — the mock UI's separate Author/Publisher/Category
// pages had no independent management need beyond labelling a book. Shelf
// location is a plain optional text field on the copy, not a normalized
// Shelf hierarchy. Availability is never a stored aggregate — always derived
// from LibraryBookCopy.status. Fines are computed from a real, admin-
// editable LibraryPolicy (not invented), but fine COLLECTION/payment is
// deliberately deferred (no LibraryPayment, no Phase 9F Fees integration —
// see the phase's final report). Reservations, digital resources, shelf
// hierarchy, stocktake, and barcode/QR/RFID hardware integration are
// deliberately deferred — no real infrastructure for any of them exists.
enum LibraryBookStatus {
  ACTIVE
  ARCHIVED
}

/**
 * Bibliographic/title-level catalog record — NOT a lendable item itself.
 */
model LibraryBook {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  title           String
  subtitle        String?
  isbn            String? // intentionally NOT unique — editions/duplicates are a real possibility, no uniqueness policy was specified
  author          String
  publisher       String?
  publicationYear Int?
  category        String?
  language        String?
  description     String?

  status LibraryBookStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  copies LibraryBookCopy[]

  @@index([schoolId, status])
  @@index([schoolId, title])
  @@map("library_books")
}

enum LibraryCopyStatus {
  AVAILABLE
  ISSUED
  LOST
  DAMAGED
  ARCHIVED
}

/**
 * A single lendable physical item. A LibraryBook (title) may have many.
 */
model LibraryBookCopy {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  bookId   String

  accessionNumber String // server-generated, race-safe (see LibraryAccessionCounter)
  barcode         String?
  status          LibraryCopyStatus @default(AVAILABLE)
  acquiredAt      DateTime?         @db.Timestamptz(6)
  shelfLocation   String?
  notes           String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  book  LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  loans LibraryLoan[]

  @@unique([schoolId, accessionNumber])
  @@index([bookId])
  @@index([schoolId, status])
  @@map("library_book_copies")
}

/**
 * Race-safe, school-scoped accession numbering — same atomic
 * `UPDATE ... RETURNING` strategy as VisitorPassCounter (Phase 9I).
 */
model LibraryAccessionCounter {
  schoolId String @id
  counter  Int    @default(0)

  @@map("library_accession_counters")
}

/**
 * One row per school: real, admin-editable loan-duration/fine policy —
 * never a silently hardcoded business rule. Auto-created with visible
 * defaults on first access; the settings page lets an admin change it
 * immediately. Deliberately a single uniform policy (not the mock's
 * per-category/per-role tiered matching) — minimal real, not over-built.
 */
model LibraryPolicy {
  schoolId String @id

  loanDurationDays Int      @default(14)
  finePerDay       Decimal  @default(0) @db.Decimal(10, 2)
  graceDays        Int      @default(0)
  maxFineAmount    Decimal? @db.Decimal(10, 2)

  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  updatedByUserId String?

  @@map("library_policies")
}

enum LibraryLoanStatus {
  ISSUED
  RETURNED
  LOST
  CANCELLED
}

/**
 * Real circulation record. Exactly one of studentId/staffId is set — the
 * borrower is always a real identity, never a name string. History must
 * survive a student's class change, a staff member going inactive, or a
 * book/copy being renamed or archived — none of those are FK-cascaded.
 */
model LibraryLoan {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  copyId   String

  studentId String?
  staffId   String?

  issuedAt   DateTime  @db.Timestamptz(6)
  dueAt      DateTime  @db.Timestamptz(6)
  returnedAt DateTime? @db.Timestamptz(6)

  status       LibraryLoanStatus @default(ISSUED)
  renewalCount Int               @default(0)

  issuedByUserId   String
  returnedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  copy    LibraryBookCopy @relation(fields: [copyId], references: [id], onDelete: Restrict)
  student Student?        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  staff   Staff?          @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([copyId])
  @@index([studentId])
  @@index([staffId])
  @@map("library_loans")
}

// ---------------------------------------------------------------------------
// Phase 9O — Inventory Management. Consumable / stock-counted items. The
// movement ledger (InventoryStockMovement) is the sole source of truth for
// quantity — there is no mutable "quantity" column anywhere; every read
// derives current stock live from SUM(ledger). `category` and location names
// are plain text/lightweight lookups (no independent category CRUD existed
// in the pre-migration UI, and no location UI existed at all — locations are
// the minimal real infrastructure Transfers needs to be honest, per the
// phase's own suggested schema). No vendor/purchase-order/valuation model —
// procurement stays out of scope; a stock RECEIPT is a physical fact, never
// a purchase-accounting event.
// ---------------------------------------------------------------------------

enum InventoryItemStatus {
  ACTIVE
  ARCHIVED
}

model InventoryItem {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  code         String // SKU — unique within a school, never the item name
  name         String
  description  String?
  category     String?
  unit         String
  reorderLevel Int?

  status InventoryItemStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  movements InventoryStockMovement[]
  issues    InventoryIssue[]
  balances  InventoryStockBalance[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@index([schoolId, category])
  @@map("inventory_items")
}

enum InventoryLocationStatus {
  ACTIVE
  ARCHIVED
}

/**
 * A named stock-holding place (e.g. "Main Store", "Science Lab Store"). One
 * "Main Store" is auto-created per branch on first use (get-or-create, same
 * pattern as LibraryPolicy) so Receipts/Issues/Adjustments always have a real
 * location to post against even before an admin has created any others.
 */
model InventoryLocation {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  name String

  status InventoryLocationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  movements InventoryStockMovement[]
  issues    InventoryIssue[]
  assets    Asset[]
  balances  InventoryStockBalance[]

  @@unique([schoolId, branchId, name])
  @@map("inventory_locations")
}

/**
 * A transactionally-maintained CACHE of the ledger sum for one (item,
 * location) pair — NOT the authority. The invariant: every
 * InventoryStockMovement insert updates this row atomically in the SAME
 * transaction via a conditional `updateMany` (never letting quantity go
 * below zero) — the exact "conditional update" concurrency idiom this
 * codebase already uses (e.g. LibraryBookCopy status), applied here because
 * there is no natural status column on a stock ledger to condition on.
 * Existence of this table is verified against SUM(ledger) in DB tests; the
 * ledger remains the append-only audit-of-record for movement history.
 */
model InventoryStockBalance {
  itemId     String
  locationId String
  quantity   Int    @default(0)

  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([itemId, locationId])
  @@map("inventory_stock_balances")
}

enum InventoryMovementType {
  OPENING
  RECEIPT
  ISSUE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

/**
 * Append-only stock ledger — the ONLY authority for quantity. `quantity` is
 * always positive; direction comes from `movementType`. A TRANSFER pair
 * shares `referenceId` (a correlation id, not a separate Transfer table —
 * the two rows created atomically in one transaction ARE the transfer
 * record). An ISSUE/RETURN pair links back to its InventoryIssue via
 * referenceType="InventoryIssue"/referenceId=issue.id. Never updated or
 * deleted after creation.
 */
model InventoryStockMovement {
  id         String @id @default(cuid())
  tenantId   String
  schoolId   String
  branchId   String
  itemId     String
  locationId String

  movementType InventoryMovementType
  quantity     Int // always > 0; sign comes from movementType

  referenceType String?
  referenceId   String?
  notes         String?

  createdByUserId String
  createdByName   String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([schoolId, itemId, createdAt])
  @@index([schoolId, locationId, itemId])
  @@index([referenceType, referenceId])
  @@map("inventory_stock_movements")
}

enum InventoryRecipientKind {
  STAFF
  STUDENT
  OTHER
}

enum InventoryIssueStatus {
  ISSUED
  PARTIALLY_RETURNED
  RETURNED
}

/**
 * A returnable-or-not consumable issue. The borrower/recipient is always a
 * real Staff.id or Student.id when it is a person — never a name string —
 * except OTHER (a department/classroom/event/purpose, which has no real
 * identity model in this codebase; `recipientLabel` is a genuine descriptive
 * label there, not a stand-in for a person). `returnedQuantity` is a
 * transactionally-maintained cache (always updated in the same transaction
 * as the RETURN movement that backs it) — never authoritative for item
 * stock, which always comes from the movement ledger.
 */
model InventoryIssue {
  id         String @id @default(cuid())
  tenantId   String
  schoolId   String
  branchId   String
  itemId     String
  locationId String

  quantity         Int
  returnedQuantity Int @default(0)

  recipientKind      InventoryRecipientKind
  recipientStaffId   String?
  recipientStudentId String?
  recipientLabel     String?
  purpose            String?
  returnable         Boolean                @default(false)

  status InventoryIssueStatus @default(ISSUED)

  issuedByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  staff    Staff?            @relation(fields: [recipientStaffId], references: [id], onDelete: Restrict)
  student  Student?          @relation(fields: [recipientStudentId], references: [id], onDelete: Restrict)

  @@index([schoolId, itemId])
  @@index([schoolId, status])
  @@index([recipientStaffId])
  @@index([recipientStudentId])
  @@map("inventory_issues")
}

// ---------------------------------------------------------------------------
// Phase 9O — Asset Management. Individually tracked durable assets — never
// "10 laptops" as one row. No depreciation/disposal/procurement/vendor
// system: cost is the admin-entered acquisition price, shown as-is, never
// depreciated or posted to Accounting.
// ---------------------------------------------------------------------------

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  DAMAGED
  RETIRED
}

enum AssetCondition {
  GOOD
  FAIR
  POOR
  DAMAGED
}

/**
 * Race-safe, school-scoped asset-tag numbering — same atomic
 * `UPDATE ... RETURNING` strategy as LibraryAccessionCounter/VisitorPassCounter.
 */
model AssetTagCounter {
  schoolId String @id
  counter  Int    @default(0)

  @@map("asset_tag_counters")
}

model Asset {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  assetTag String // server-generated (see AssetTagCounter), unique per school

  name          String
  category      String?
  serialNumber  String?
  manufacturer  String?
  model         String?
  purchaseDate  DateTime? @db.Date
  cost          Decimal?  @db.Decimal(12, 2) // admin-entered acquisition price — informational only, never depreciated/posted
  warrantyUntil DateTime? @db.Date
  notes         String?

  locationId String?

  status    AssetStatus    @default(AVAILABLE)
  condition AssetCondition @default(GOOD)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  location    InventoryLocation?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments AssetAssignment[]
  maintenance AssetMaintenanceRecord[]

  @@unique([schoolId, assetTag])
  @@index([schoolId, status])
  @@index([schoolId, category])
  @@map("assets")
}

/**
 * Real custody record — the holder is always a real Staff.id, never a name
 * string. No Student assignment: no existing UI ever offered a student
 * picker for asset issue (only a free-text "teacher/department/room" field),
 * so it stays out of scope rather than being fabricated. Exactly one ACTIVE
 * (returnedAt IS NULL) assignment per asset is enforced by a partial unique
 * index (see the follow-up migration), mirroring Phase 9N's library loans.
 */
model AssetAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  assetId  String
  staffId  String

  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  returnedAt DateTime?
  notes      String?

  assignedByUserId String
  returnedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([schoolId, assetId])
  @@index([staffId])
  @@map("asset_assignments")
}

enum AssetMaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
  OTHER
}

enum AssetMaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/**
 * Structurally simple, non-financial-workflow maintenance record (per the
 * phase's own guidance — `cost`/`vendorName` are plain display fields with no
 * accounting implication, never posted anywhere). Opening a record requires
 * the asset to be AVAILABLE (moves it to MAINTENANCE); completing/cancelling
 * returns it to AVAILABLE. An asset already ASSIGNED must be returned first —
 * this codebase invents no "maintenance while assigned" semantics.
 */
model AssetMaintenanceRecord {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  assetId  String

  type        AssetMaintenanceType   @default(REPAIR)
  status      AssetMaintenanceStatus @default(OPEN)
  description String
  vendorName  String?
  cost        Decimal?               @db.Decimal(12, 2)

  openedAt    DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime?

  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([schoolId, assetId])
  @@index([schoolId, status])
  @@map("asset_maintenance_records")
}

// ---------------------------------------------------------------------------
// Phase 9Q — Hostel Management. Hostel student identity always resolves to
// real Student.id; warden/hostel-staff identity always resolves to real
// Staff.id — no parallel identity models. Building/Block/Floor: the
// pre-migration mock UI only ever used "floor" as a display-grouping number
// within one hostel's room list (no floor-level CRUD, status, or capacity
// anywhere) — so it stays a plain `floorNumber` field on HostelRoom, not a
// separate entity. Room capacity is NOT a stored field: it is always
// `count(beds)` — creating a room provisions its beds in the same
// transaction, so there is only one capacity truth. Occupancy/availability
// are always derived from the active-assignment partial-unique-index
// invariant below, never a persisted counter.
// ---------------------------------------------------------------------------

enum HostelGenderPolicy {
  BOYS
  GIRLS
  MIXED
}

enum HostelStatus {
  ACTIVE
  MAINTENANCE
  ARCHIVED
}

model Hostel {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  code         String
  name         String
  description  String?
  genderPolicy HostelGenderPolicy?

  status HostelStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  rooms            HostelRoom[]
  staffAssignments HostelStaffAssignment[]
  assignments      StudentHostelAssignment[]
  rollCallRecords  HostelRollCallRecord[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@map("hostels")
}

enum HostelRoomStatus {
  ACTIVE
  MAINTENANCE
  ARCHIVED
}

/**
 * Capacity is deliberately NOT a stored field — it is always
 * `count(beds)`, provisioned atomically at room-creation time, so there is
 * never a second, driftable capacity truth.
 */
model HostelRoom {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  hostelId String

  roomNumber  String
  floorNumber Int?
  roomType    String?
  facilities  String[]
  notes       String?

  status HostelRoomStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  hostel      Hostel                    @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  beds        HostelBed[]
  assignments StudentHostelAssignment[]

  @@unique([hostelId, roomNumber])
  @@index([schoolId, status])
  @@map("hostel_rooms")
}

enum HostelBedStatus {
  ACTIVE
  MAINTENANCE
  ARCHIVED
}

/**
 * OCCUPIED is never stored here — it is derived from whether an ACTIVE
 * StudentHostelAssignment currently references this bed (enforced unique by
 * the partial index on that model).
 */
model HostelBed {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  roomId   String

  bedNumber String

  status HostelBedStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  room        HostelRoom                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignments StudentHostelAssignment[]

  @@unique([roomId, bedNumber])
  @@index([schoolId, status])
  @@map("hostel_beds")
}

enum HostelAssignmentStatus {
  ACTIVE
  VACATED
  TRANSFERRED
}

/**
 * The real allocation record. A borrower is always a real Student.id.
 * `roomId`/`hostelId` are live FKs (not snapshots) purely for query
 * convenience — a bed never moves rooms, so they can never drift from the
 * bed's own room/hostel. History is append-only: vacating/transferring never
 * deletes or rewrites a row, it closes it (VACATED/TRANSFERRED) and — for a
 * transfer — creates a new ACTIVE row. Exactly one ACTIVE row per bed and
 * per (student, academicSession) is enforced by partial unique indexes (see
 * the follow-up migration), mirroring Phase 9N/9O's dual-guard pattern.
 */
model StudentHostelAssignment {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  studentId String
  hostelId  String
  roomId    String
  bedId     String

  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  vacatedAt  DateTime? @db.Timestamptz(6)

  status HostelAssignmentStatus @default(ACTIVE)

  assignedByUserId String
  vacatedByUserId  String?
  notes            String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  hostel  Hostel     @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  room    HostelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bed     HostelBed  @relation(fields: [bedId], references: [id], onDelete: Restrict)

  @@index([schoolId, studentId])
  @@index([schoolId, status])
  @@index([bedId])
  @@index([academicSessionId])
  @@map("student_hostel_assignments")
}

enum HostelStaffRole {
  WARDEN
  ASSISTANT_WARDEN
}

enum HostelStaffAssignmentStatus {
  ACTIVE
  ENDED
}

/**
 * Warden/assistant-warden identity is always a real Staff.id — never a
 * parallel "Warden" identity or a free-text name.
 */
model HostelStaffAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  hostelId String
  staffId  String

  role   HostelStaffRole             @default(WARDEN)
  status HostelStaffAssignmentStatus @default(ACTIVE)

  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  endedAt    DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([schoolId, hostelId])
  @@index([staffId])
  @@map("hostel_staff_assignments")
}

enum HostelRollCallStatus {
  PRESENT
  ABSENT
  ON_LEAVE
}

/**
 * Nightly hostel roll call — a SEPARATE domain from academic
 * AttendanceSession/AttendanceRecord (different entity grain, different
 * purpose). A resident with no record for a date is NOT_MARKED — never
 * synthesized as ABSENT by a query, matching Phase 9E's Staff Attendance
 * convention exactly. No biometric/access-control integration.
 */
model HostelRollCallRecord {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  studentId String
  hostelId  String
  date      DateTime @db.Date

  status HostelRollCallStatus

  markedByUserId String
  notes          String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  hostel  Hostel  @relation(fields: [hostelId], references: [id], onDelete: Restrict)

  @@unique([studentId, date])
  @@index([schoolId, hostelId, date])
  @@map("hostel_roll_call_records")
}

// ---------------------------------------------------------------------------
// Phase 9R: Health / Infirmary Management. Administrative record-keeping
// only — NOT a diagnosis, prescription, or triage engine. A patient always
// resolves to a real Student.id or Staff.id (exactly one) — never a parallel
// Patient/NurseUser/DoctorUser identity. No medical policy is invented: no
// diagnoses, prescriptions, dosage rules, allergy interpretation, risk
// scores, insurance eligibility, vaccination rules, or fitness certificates.
// ---------------------------------------------------------------------------

/**
 * A thin, factual health-domain profile linked to exactly one real Student or
 * Staff identity — never a second identity authority. Emergency contact
 * information is deliberately NOT duplicated here: for a Student patient it
 * is derived live from StudentGuardian.isEmergencyContact + real Guardian
 * records; Staff have no emergency-contact model yet, so that section is
 * simply absent for Staff patients. All fields are plain admin-entered text
 * — never inferred, classified, or risk-scored.
 */
model HealthProfile {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  studentId String? @unique
  staffId   String? @unique

  bloodGroup            String?
  allergiesText         String?
  chronicConditionsText String?
  careInstructions      String?
  physicianName         String?
  physicianPhone        String?
  insuranceProvider     String?
  insuranceNumberMasked String?

  updatedByUserId String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@map("health_profiles")
}

enum HealthVisitStatus {
  OPEN
  CLOSED
  REFERRED
}

/**
 * A real infirmary visit. Patient is always exactly one of Student/Staff.
 * Lifecycle is deliberately minimal (OPEN → CLOSED or OPEN → REFERRED, both
 * terminal) — administrative record-keeping, not a clinical state machine.
 * Server timestamps (checkedInAt/checkedOutAt) are authoritative.
 * reason/symptomsReported/observationNotes/careAction are plain factual text
 * entered by the recording staff member — never a diagnosis. guardianContacted
 * is a manual factual flag the recorder sets themselves; the system never
 * auto-sends a parent notification.
 */
model HealthVisit {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  studentId String?
  staffId   String?

  reason            String
  symptomsReported  String?
  observationNotes  String?
  careAction        String?
  guardianContacted Boolean           @default(false)
  status            HealthVisitStatus @default(OPEN)

  referralDestination String?
  referralNotes       String?
  followUpAt          DateTime?

  attendedByStaffId String?
  createdByUserId   String

  checkedInAt  DateTime  @default(now()) @db.Timestamptz(6)
  checkedOutAt DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student      Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  staffPatient Staff?   @relation("HealthVisitPatientStaff", fields: [staffId], references: [id], onDelete: Restrict)
  attendedBy   Staff?   @relation("HealthVisitAttendant", fields: [attendedByStaffId], references: [id], onDelete: Restrict)

  vitals      HealthVitalObservation[]
  treatments  HealthTreatmentRecord[]
  medications HealthMedicationAdministration[]

  @@index([schoolId, branchId, status])
  @@index([studentId])
  @@index([staffId])
  @@map("health_visits")
}

/**
 * Records measurements only — never interprets or diagnoses (no hypertension
 * labeling, no fever classification, no risk score). Validation rejects only
 * physically-impossible values, never clinical judgement.
 */
model HealthVitalObservation {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  visitId  String

  temperatureC        Float?
  pulseBpm            Int?
  systolic            Int?
  diastolic           Int?
  oxygenSaturationPct Float?
  weightKg            Float?
  heightCm            Float?

  recordedAt       DateTime @default(now()) @db.Timestamptz(6)
  recordedByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  visit HealthVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("health_vital_observations")
}

/**
 * Factual first-aid/care given during a visit — never a prescription.
 */
model HealthTreatmentRecord {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  visitId  String

  description String

  administeredByStaffId String?
  createdByUserId       String
  administeredAt        DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  visit          HealthVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  administeredBy Staff?      @relation("HealthTreatmentStaff", fields: [administeredByStaffId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@map("health_treatment_records")
}

/**
 * A factual record of a medication given during a visit — never a
 * prescription, dosage recommendation, or refill schedule. medicationName is
 * plain display text entered by the recording staff member; there is no
 * medication-order/schedule authority behind it, and it never decrements
 * Inventory (Health and Inventory stay separate domains in this phase).
 */
model HealthMedicationAdministration {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  visitId  String

  medicationName String
  quantity       String?
  unit           String?
  notes          String?

  administeredByStaffId String?
  createdByUserId       String
  administeredAt        DateTime @default(now()) @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  visit          HealthVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  administeredBy Staff?      @relation("HealthMedicationStaff", fields: [administeredByStaffId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@map("health_medication_administrations")
}

// ---------------------------------------------------------------------------
// Phase 9S: Counseling / Student Wellbeing. A SEPARATE confidential domain
// from Health (Phase 9R) — administrative record-keeping only, never a
// diagnosis/risk-scoring/crisis-prediction engine. A student is always a
// real Student.id; a counselor is always a real, active Staff.id — never a
// parallel identity. Case METADATA access (counseling.view) is deliberately
// separate from CONFIDENTIAL session-note access (counseling.viewConfidential,
// further restricted to the assigned counselor's own cases at the service
// layer — see lib/server/counseling/access.ts). No consent/safeguarding/
// vaccination-style workflow is modeled here — none exists in the product
// today, so it stays honestly deferred.
// ---------------------------------------------------------------------------

enum CounselingCaseStatus {
  OPEN
  ACTIVE
  CLOSED
}

enum CounselingReferralSource {
  SELF
  TEACHER
  PARENT_GUARDIAN
  STAFF
  ADMIN
  OTHER
}

enum CounselingConcernCategory {
  ACADEMIC
  PEER_RELATIONSHIPS
  BEHAVIORAL
  FAMILY
  EMOTIONAL_WELLBEING
  OTHER
}

/**
 * A counseling case for one real Student. referralReason/summary are
 * factual, non-confidential text (case metadata, visible to counseling.view)
 * — never a diagnosis. referralSource records who manually reported the
 * concern; it is never claimed to be a digitally-submitted parent/guardian
 * consent or referral (Guardian has no login identity in this system).
 * Lifecycle is deliberately minimal (OPEN -> ACTIVE -> CLOSED) and never
 * reopened once closed. A student may have more than one case at a time —
 * no artificial single-open-case constraint is invented, since real
 * concerns can be genuinely concurrent and unrelated.
 */
model CounselingCase {
  id                String  @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String?

  studentId                String
  assignedCounselorStaffId String?

  referralSource   CounselingReferralSource?
  referralReason   String?
  referredByUserId String?
  referredAt       DateTime?                 @db.Timestamptz(6)

  concernCategory CounselingConcernCategory?
  summary         String?
  status          CounselingCaseStatus       @default(OPEN)
  followUpDate    DateTime?                  @db.Date

  openedAt DateTime  @default(now()) @db.Timestamptz(6)
  closedAt DateTime?

  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student           Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignedCounselor Staff?  @relation("CounselingCaseCounselor", fields: [assignedCounselorStaffId], references: [id], onDelete: Restrict)

  sessions CounselingSession[]

  @@index([schoolId, branchId, status])
  @@index([studentId])
  @@index([assignedCounselorStaffId])
  @@map("counseling_cases")
}

/**
 * A single counseling session under a case. summary is factual and
 * non-confidential (case metadata) — detailed confidential content belongs
 * only in CounselingSessionNote, never here.
 */
model CounselingSession {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String
  caseId   String

  counselorStaffId String
  sessionDate      DateTime  @default(now()) @db.Timestamptz(6)
  endedAt          DateTime?
  sessionType      String?
  summary          String?
  followUpDate     DateTime? @db.Date

  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  case      CounselingCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  counselor Staff          @relation("CounselingSessionCounselor", fields: [counselorStaffId], references: [id], onDelete: Restrict)

  notes CounselingSessionNote[]

  @@index([schoolId, branchId])
  @@index([caseId])
  @@index([counselorStaffId])
  @@map("counseling_sessions")
}

/**
 * Confidential session content. NEVER included in list endpoints or the
 * generic Case/Session DTO — only returned by a dedicated endpoint gated by
 * counseling.viewConfidential AND counselor ownership (assignedCounselorStaffId
 * on the parent case must equal the caller's own Staff.id). AuditEvent
 * entries for note mutations record who/what/when only — never the body.
 */
model CounselingSessionNote {
  id        String @id @default(cuid())
  tenantId  String
  schoolId  String
  branchId  String
  sessionId String

  body String

  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  session CounselingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("counseling_session_notes")
}

// ---------------------------------------------------------------------------
// Phase 9T: Cafeteria / Meal Management. A meal consumer always resolves to a
// real, active Student.id or Staff.id — never a parallel identity. No
// wallet, no online ordering, no payment gateway, no second money/stock
// engine. Item pricing (if recorded) is informational only — never a Fees or
// Accounting receivable authority. Ingredient/stock consumption is
// deliberately NOT auto-deducted from real Inventory (no recipe/BOM
// structure exists to do so honestly).
// ---------------------------------------------------------------------------

enum CafeteriaStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model CafeteriaLocation {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  code        String
  name        String
  description String?
  status      CafeteriaStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  menus CafeteriaMenu[]

  @@unique([schoolId, code])
  @@map("cafeteria_locations")
}

/**
 * A cafeteria menu item (dish). dietaryTags is informational only (e.g.
 * "vegetarian", "contains-nuts") — never a medical/allergy authority; Health
 * confidential allergy data is never read by this domain. priceMinorUnits,
 * if set, is informational display text only — it is never posted to Fees
 * or Accounting.
 */
model CafeteriaItem {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  code            String
  name            String
  category        String?
  description     String?
  dietaryTags     String[]
  priceMinorUnits Int?
  status          CafeteriaItemStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  menuItems   CafeteriaMenuItem[]
  mealRecords CafeteriaMealRecord[]

  @@unique([schoolId, code])
  @@map("cafeteria_items")
}

enum CafeteriaItemStatus {
  ACTIVE
  ARCHIVED
}

enum CafeteriaMealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
  A_LA_CARTE
}

/**
 * A published menu for one serving slot (location + date + meal type). No
 * draft/publish lifecycle is modeled — the old mock's weekly planner had no
 * such concept, and inventing an approval workflow is explicitly out of
 * scope; a created menu is immediately the live menu for its slot.
 */
model CafeteriaMenu {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  locationId String
  date       DateTime          @db.Date
  mealType   CafeteriaMealType

  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  location CafeteriaLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items    CafeteriaMenuItem[]
  meals    CafeteriaMealRecord[]

  @@unique([locationId, date, mealType])
  @@index([schoolId, branchId, date])
  @@map("cafeteria_menus")
}

model CafeteriaMenuItem {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  menuId          String
  cafeteriaItemId String
  servingOrder    Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  menu CafeteriaMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item CafeteriaItem @relation(fields: [cafeteriaItemId], references: [id], onDelete: Restrict)

  @@unique([menuId, cafeteriaItemId])
  @@map("cafeteria_menu_items")
}

/**
 * A factual record that a real Student or Staff member was served a meal
 * from a published menu. This is deliberately NOT called Attendance — meal
 * consumption is a separate operational fact from academic/staff attendance.
 * Policy (explicitly chosen, not guessed): one meal redemption per consumer
 * per menu slot — the typical institutional cafeteria policy, preventing a
 * duplicate serving of the same lunch to the same person. Enforced via
 * @@unique([menuId, studentId]) / @@unique([menuId, staffId]) — Postgres
 * treats each NULL as distinct, so these act as "at most one row per menu
 * per non-null consumer" without needing a partial index. If a school's real
 * policy allows multiple servings (e.g. seconds), this would need a schema
 * change — not assumed here.
 */
model CafeteriaMealRecord {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  menuId          String
  cafeteriaItemId String?

  studentId String?
  staffId   String?

  servedAt       DateTime @default(now()) @db.Timestamptz(6)
  quantity       Int      @default(1)
  servedByUserId String
  notes          String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  menu         CafeteriaMenu  @relation(fields: [menuId], references: [id], onDelete: Restrict)
  item         CafeteriaItem? @relation(fields: [cafeteriaItemId], references: [id], onDelete: Restrict)
  student      Student?       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  staffPatient Staff?         @relation("CafeteriaMealStaffConsumer", fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([menuId, studentId])
  @@unique([menuId, staffId])
  @@index([schoolId, branchId, servedAt])
  @@map("cafeteria_meal_records")
}

// ---------------------------------------------------------------------------
// Phase 9U: Activities / Student Life. A member is always a real, active
// Student.id; a coordinator/coach/mentor is always a real, active Staff.id —
// never a parallel identity. Event participation is deliberately NOT
// academic Attendance — a fully separate operational fact via
// ActivityEventParticipant. No scoring/ranking/certificates/house-points
// engine is modeled here — Houses, Sports fixtures/tournaments,
// Competitions, Achiev ­ements-scoring, Awards, and Certificates all stay
// honestly deferred (no real policy/infrastructure exists for any of them
// yet); StudentAchievement below is the one small, explicitly-permitted
// extension — a purely factual record, never a score or rank.
// ---------------------------------------------------------------------------

enum ActivityType {
  CLUB
  SPORT
  CULTURAL
  ACADEMIC
  SERVICE
  OTHER
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Activity {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  code        String
  name        String
  type        ActivityType
  description String?
  status      ActivityStatus @default(ACTIVE)
  capacity    Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  staffAssignments ActivityStaffAssignment[]
  memberships      ActivityStudentMembership[]
  events           ActivityEvent[]
  achievements     StudentAchievement[]

  @@unique([schoolId, code])
  @@map("activities")
}

enum ActivityStaffRole {
  COORDINATOR
  COACH
  MENTOR
}

enum ActivityStaffAssignmentStatus {
  ACTIVE
  ENDED
}

/**
 * Coordinator/coach/mentor for an Activity — always a real, active Staff.id.
 * assign() is an upsert keyed on (activityId, staffId, role): reactivating a
 * previously-ended assignment reuses the same row rather than requiring a
 * partial-unique-index dance — no duplicate-assignment concurrency test is
 * required by this phase (only Membership below has that requirement).
 */
model ActivityStaffAssignment {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  activityId String
  staffId    String
  role       ActivityStaffRole             @default(COORDINATOR)
  status     ActivityStaffAssignmentStatus @default(ACTIVE)

  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  endedAt    DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([activityId, staffId, role])
  @@index([schoolId, activityId])
  @@map("activity_staff_assignments")
}

enum ActivityMembershipStatus {
  ACTIVE
  ENDED
}

/**
 * Real, session-scoped Student membership in an Activity. Append-only
 * history — leaving an activity closes the row (status=ENDED, leftAt set),
 * never deleted or rewritten. Concurrency-safe "one active membership per
 * student per activity per session" via a partial unique index (Prisma
 * cannot express `@@unique WHERE`, so this is a hand-written migration —
 * see the sibling migration.sql), mirroring the Hostel/Health dual-guard
 * pattern: a pre-check for a friendly error, backed by the real DB
 * constraint for true concurrency safety.
 */
model ActivityStudentMembership {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  activityId String
  studentId  String
  status     ActivityMembershipStatus @default(ACTIVE)

  joinedAt DateTime  @default(now()) @db.Timestamptz(6)
  leftAt   DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([schoolId, activityId])
  @@index([studentId])
  @@map("activity_student_memberships")
}

enum ActivityEventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

/**
 * A real Activity event. Lifecycle is deliberately minimal — DRAFT ->
 * PUBLISHED -> COMPLETED, or PUBLISHED -> CANCELLED — replacing the old
 * mock's invented 8-stage "journey" with tasks/budget, which this phase does
 * not build (no real task-tracking/budget infrastructure was requested).
 * PUBLISHED events are derived live into the real Calendar
 * (lib/server/calendar/service.ts) — never a duplicately-stored CalendarEvent.
 */
model ActivityEvent {
  id                String @id @default(cuid())
  tenantId          String
  schoolId          String
  branchId          String
  academicSessionId String

  activityId  String
  title       String
  description String?
  startAt     DateTime            @db.Timestamptz(6)
  endAt       DateTime?
  location    String?
  status      ActivityEventStatus @default(DRAFT)

  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  activity     Activity                   @relation(fields: [activityId], references: [id], onDelete: Restrict)
  participants ActivityEventParticipant[]

  @@index([schoolId, branchId, startAt])
  @@index([activityId])
  @@map("activity_events")
}

enum ActivityParticipantStatus {
  REGISTERED
  ATTENDED
  ABSENT
  CANCELLED
}

/**
 * A real Student's registration/attendance for one Activity event —
 * deliberately NOT academic Attendance, a fully separate operational fact.
 * Registration is open to any real, active Student in the school (no
 * membership-only restriction is imposed — no real product policy defines
 * one). One registration per student per event.
 */
model ActivityEventParticipant {
  id       String @id @default(cuid())
  tenantId String
  schoolId String
  branchId String

  eventId   String
  studentId String
  status    ActivityParticipantStatus @default(REGISTERED)

  registeredAt DateTime  @default(now()) @db.Timestamptz(6)
  attendedAt   DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  event   ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([eventId, studentId])
  @@map("activity_event_participants")
}

/**
 * A factual, manually-entered achievement record — never a score, rank, or
 * auto-generated award. Optionally linked to the Activity it relates to.
 */
model StudentAchievement {
  id       String @id @default(cuid())
  tenantId String
  schoolId String

  studentId  String
  activityId String?

  title       String
  description String?
  awardedAt   DateTime @db.Date

  createdByUserId String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId])
  @@map("student_achievements")
}
