# Novyra Campus OS — server environment (Phase 16 backend foundation).
# Copy to .env and fill in real values. NEVER commit .env. NEVER prefix any of
# these with NEXT_PUBLIC_ — they are server-only secrets.

# --- Database (PostgreSQL) -------------------------------------------------
# Primary connection used by the app at runtime. On a pooled cloud provider
# (Neon/Supabase pgbouncer) this is the POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Optional DIRECT (non-pooled) connection used ONLY for migrations. Set this on
# providers that pool connections; the app never uses it. If your provider does
# not pool, leave it unset and DATABASE_URL is used for migrations too.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Optional shadow database for `prisma migrate dev` on managed providers.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_shadow?sslmode=require"

# --- Authentication (Better Auth) ------------------------------------------
# A long random secret. Generate one, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32+-char-random-secret"

# Base URL of the app (used to build auth callback URLs). Optional in local dev.
# BETTER_AUTH_URL="http://localhost:3000"

# --- Route protection ------------------------------------------------------
# Middleware bounces anonymous users to /login. Enforcement is ON by default.
# Set to "false" ONLY for local pre-database UI review. Never set false when
# hosted.
# AUTH_ENFORCED="false"

# --- Seed ------------------------------------------------------------------
# Password assigned to all demo users by prisma/seed.ts. If unset, a documented
# dev fallback ("Novyra@Dev123") is used. Set a value for shared dev DBs.
# SEED_DEMO_PASSWORD="choose-a-dev-password"

# --- Demo access -----------------------------------------------------------
# The login page shows a "Demo access" panel that signs in seeded users through
# the REAL auth flow. It is hidden automatically in production builds. To also
# disable it in a non-production/demo environment, set this to "false".
# DEMO_ACCESS="false"
